---
import { getCollection } from 'astro:content';

const events = await getCollection('events');
const event = events[0]?.data;
---

{event && (
  <section class="event-section" id="agenda">
    <div class="container">
      <div class="event-card">
        <!-- Date Block -->
        <div class="event-date-col">
          <span class="date-num">18</span>
          <span class="date-month">MEI 2026</span>
          <span class="date-pill">Jadwal Resmi PPDB</span>
        </div>

        <!-- Content Block -->
        <div class="event-content-col">
          <div class="event-meta-top">
            <span class="event-badge">{event.badge}</span>
            <span class="academic-year">Tahun Ajaran 2026/2027</span>
          </div>

          <h2 class="event-title">{event.title}</h2>
          <p class="event-desc">{event.description}</p>

          <div class="event-meta-grid">
            <div class="meta-item">
              <span class="meta-lbl">Waktu Layanan</span>
              <span class="meta-val">{event.time}</span>
            </div>
            <div class="meta-item">
              <span class="meta-lbl">Lokasi Verifikasi</span>
              <span class="meta-val">{event.location}</span>
            </div>
          </div>

          <div class="event-actions">
            <a href="/ppdb" class="btn btn-primary btn-arrow">Prosedur Lengkap PPDB</a>
            <a href="/#chatbot" class="btn btn-outline">Tanya Syarat ke SmansaBot</a>
          </div>
        </div>
      </div>
    </div>
  </section>
)}

<style>
  .event-section {
    padding: 30px 0 70px;
    background-color: var(--color-bg);
  }

  .event-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    display: grid;
    grid-template-columns: 240px 1fr;
    overflow: hidden;
    box-shadow: var(--shadow-subtle);
  }

  .event-date-col {
    background-color: var(--color-surface-muted);
    border-right: 1px solid var(--color-border);
    padding: 36px 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .date-num {
    font-family: var(--font-serif);
    font-size: 3.8rem;
    font-weight: 700;
    line-height: 1;
    color: var(--color-text-primary);
  }

  .date-month {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-accent-coral);
    letter-spacing: 0.08em;
    margin: 6px 0 12px;
  }

  .date-pill {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    color: var(--color-text-secondary);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    padding: 3px 10px;
    border-radius: var(--radius-pill);
  }

  .event-content-col {
    padding: 36px 40px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .event-meta-top {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
  }

  .event-badge {
    background-color: var(--color-accent-coral);
    color: #FFFFFF;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    padding: 3px 12px;
    border-radius: var(--radius-pill);
    letter-spacing: 0.04em;
  }

  .academic-year {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    font-weight: 600;
    color: var(--color-text-muted);
  }

  .event-title {
    font-family: var(--font-serif);
    font-size: clamp(1.6rem, 2.8vw, 2.2rem);
    color: var(--color-text-primary);
    margin-bottom: 10px;
    line-height: 1.25;
  }

  .event-desc {
    font-size: 0.92rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-bottom: 22px;
    max-width: 680px;
  }

  .event-meta-grid {
    display: flex;
    gap: 20px;
    margin-bottom: 24px;
    flex-wrap: wrap;
  }

  .meta-item {
    background-color: var(--color-surface-muted);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 8px 16px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .meta-lbl {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .meta-val {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .event-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  @media (max-width: 800px) {
    .event-card {
      grid-template-columns: 1fr;
    }
    .event-date-col {
      border-right: none;
      border-bottom: 1px solid var(--color-border);
      padding: 24px;
    }
    .event-content-col {
      padding: 28px 20px;
    }
  }
</style>
