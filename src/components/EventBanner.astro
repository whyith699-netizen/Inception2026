---
import { getCollection } from 'astro:content';

const events = await getCollection('events');
const event = events[0]?.data;
---

{event && (
  <section class="event-section" id="agenda">
    <div class="container">
      <div class="event-split-card">
        <!-- Left Side: Illustrated Visual Badge on Green Frame -->
        <div class="event-visual-col">
          <div class="visual-arch">
            <svg class="event-svg-art" viewBox="0 0 260 220" fill="none" xmlns="http://www.w3.org/2000/svg">
              <!-- Calendar / Clipboard Icon Art -->
              <rect x="50" y="30" width="160" height="160" rx="24" fill="#FFFFFF" stroke="#221610" stroke-width="4"/>
              <path d="M50 80H210" stroke="#221610" stroke-width="4"/>
              <rect x="80" y="15" width="28" height="30" rx="6" fill="#E85A38"/>
              <rect x="152" y="15" width="28" height="30" rx="6" fill="#E85A38"/>
              <!-- Calendar Day Number -->
              <text x="130" y="145" font-family="'Space Mono', monospace" font-size="52" font-weight="bold" fill="#221610" text-anchor="middle">18</text>
              <text x="130" y="172" font-family="'Plus Jakarta Sans', sans-serif" font-size="16" font-weight="bold" fill="#E85A38" text-anchor="middle">MEI 2026</text>
            </svg>
            <div class="visual-tag-chip">Jadwal Resmi Jawa Tengah</div>
          </div>
        </div>

        <!-- Right Side: Event Details & Action -->
        <div class="event-content-col">
          <div class="event-header-row">
            <span class="event-badge">{event.badge}</span>
            <span class="event-academic-year">T.A. 2026/2027</span>
          </div>

          <h2 class="event-title">{event.title}</h2>
          <p class="event-desc">{event.description}</p>

          <div class="event-meta-grid">
            <div class="meta-card">
              <span class="meta-label">Tanggal Pelaksanaan</span>
              <span class="meta-val">{event.date}</span>
            </div>
            <div class="meta-card">
              <span class="meta-label">Waktu Layanan</span>
              <span class="meta-val">{event.time}</span>
            </div>
            <div class="meta-card">
              <span class="meta-label">Lokasi Resmi</span>
              <span class="meta-val">{event.location}</span>
            </div>
          </div>

          <div class="event-actions">
            <a href="/ppdb" class="btn btn-primary btn-arrow">Unduh Petunjuk Teknis PPDB</a>
            <a href="/#chatbot" class="btn btn-outline">Tanya Syarat ke SmansaBot</a>
          </div>
        </div>
      </div>
    </div>
  </section>
)}

<style>
  .event-section {
    padding: 30px 0 var(--section-spacing);
  }

  .event-split-card {
    background-color: var(--color-accent-yellow);
    border: 1px solid rgba(34, 22, 16, 0.2);
    border-radius: var(--radius-xl);
    display: grid;
    grid-template-columns: 320px 1fr;
    overflow: hidden;
    box-shadow: 0 16px 36px rgba(34, 22, 16, 0.08);
  }

  /* Left Visual Frame */
  .event-visual-col {
    background-color: #3BA85C;
    padding: 36px 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    position: relative;
    border-right: 1px solid rgba(34, 22, 16, 0.15);
  }

  .visual-arch {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }

  .event-svg-art {
    width: 200px;
    height: 170px;
    filter: drop-shadow(0 6px 14px rgba(0, 0, 0, 0.12));
  }

  .visual-tag-chip {
    background-color: #FFFFFF;
    color: var(--color-text-primary);
    font-size: 0.76rem;
    font-weight: 700;
    padding: 4px 14px;
    border-radius: var(--radius-pill);
    border: 1px solid rgba(34, 22, 16, 0.1);
  }

  /* Right Content Column */
  .event-content-col {
    padding: 44px 48px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .event-header-row {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
  }

  .event-badge {
    background-color: var(--color-text-primary);
    color: #FFFFFF;
    font-size: 0.78rem;
    font-weight: 700;
    padding: 4px 14px;
    border-radius: var(--radius-pill);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .event-academic-year {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--color-text-primary);
  }

  .event-title {
    font-size: clamp(1.65rem, 2.5vw, 2.3rem);
    margin-bottom: 14px;
    line-height: 1.25;
  }

  .event-desc {
    font-size: 0.95rem;
    color: var(--color-text-primary);
    line-height: 1.6;
    margin-bottom: 24px;
    max-width: 680px;
  }

  .event-meta-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-bottom: 28px;
  }

  .meta-card {
    background-color: rgba(255, 255, 255, 0.85);
    border: 1px solid rgba(34, 22, 16, 0.1);
    border-radius: var(--radius-md);
    padding: 12px 16px;
  }

  .meta-label {
    display: block;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    margin-bottom: 4px;
  }

  .meta-val {
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--color-text-primary);
  }

  .event-actions {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }

  @media (max-width: 900px) {
    .event-split-card {
      grid-template-columns: 1fr;
    }
    .event-content-col {
      padding: 32px 24px;
    }
    .event-meta-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
