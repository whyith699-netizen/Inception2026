---
import { getCollection } from 'astro:content';

const events = await getCollection('events');
const event = events[0]?.data;
---

{event && (
  <section class="event-section sec" id="agenda">
    <div class="container">
      <div class="event-card" data-reveal>
        <aside class="event-date-col">
          <span class="date-num num">18</span>
          <span class="date-month">Mei 2026</span>
        </aside>

        <div class="event-content-col">
          <p class="lbl">{event.badge}</p>
          <h2 class="event-title">{event.title}</h2>
          <p class="event-desc">{event.description}</p>

          <dl class="event-meta-grid">
            <div class="meta-item">
              <dt class="meta-lbl">Waktu layanan</dt>
              <dd class="meta-val num">{event.time}</dd>
            </div>
            <div class="meta-item">
              <dt class="meta-lbl">Lokasi verifikasi</dt>
              <dd class="meta-val">{event.location}</dd>
            </div>
          </dl>

          <div class="event-actions">
            <a href="/ppdb" class="btn btn-primary">Lihat prosedur PPDB</a>
            <a href="/#chatbot" class="btn-text">Tanya syarat ke SmansaBot AI</a>
          </div>
        </div>
      </div>
    </div>
  </section>
)}

<style>
  .event-section {
    padding-top: clamp(48px, 6vw, 72px);
    padding-bottom: clamp(48px, 6vw, 72px);
    border-top: 1px solid var(--hairline);
  }

  .event-card {
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: var(--r-md);
    display: grid;
    grid-template-columns: 180px 1fr;
    overflow: hidden;
  }

  .event-date-col {
    border-right: 1px solid var(--hairline);
    padding: 32px 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 6px;
  }

  .date-num {
    font-family: var(--font-serif);
    font-size: 3.25rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--ink);
  }

  .date-month {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.06em;
    color: var(--ink-3);
  }

  .event-content-col {
    padding: clamp(24px, 3vw, 36px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
  }

  .event-title {
    font-size: clamp(1.4rem, 2.4vw, 1.9rem);
    font-weight: 500;
    margin-bottom: 12px;
    max-width: 30ch;
  }

  .event-desc {
    font-size: 0.9375rem;
    color: var(--ink-2);
    line-height: 1.65;
    margin-bottom: 22px;
    max-width: 64ch;
  }

  .event-meta-grid {
    display: flex;
    gap: 1px;
    margin-bottom: 24px;
    flex-wrap: wrap;
    background: var(--hairline);
    border: 1px solid var(--hairline);
    border-radius: var(--r-sm);
    overflow: hidden;
  }

  .meta-item {
    background: var(--paper);
    padding: 10px 16px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .meta-lbl {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .meta-val {
    font-size: 0.875rem;
    color: var(--ink);
    margin: 0;
  }

  .event-actions {
    display: flex;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
  }

  @media (max-width: 800px) {
    .event-card {
      grid-template-columns: 1fr;
    }
    .event-date-col {
      border-right: none;
      border-bottom: 1px solid var(--hairline);
      flex-direction: row;
      gap: 12px;
      padding: 20px;
    }
  }
</style>
