---
import { getCollection } from 'astro:content';

const programs = await getCollection('programs');
programs.sort((a, b) => a.data.order - b.data.order);

const cardBadges: Record<string, string> = {
  "mipa-riset": "Riset & Sains Terapan",
  "ips-kreatif": "Sosial & Ekonomi Modern",
  "bahasa-global": "Diplomasi & Budaya"
};
---

<section class="programs-section" id="program">
  <div class="container">
    <div class="section-header">
      <div>
        <span class="section-tag">Kurikulum Merdeka Riset</span>
        <h2 class="section-title">Peminatan Akademik Berbasis Nalar Kritis</h2>
      </div>
      <a href="/program" class="btn btn-outline btn-arrow">Detail Silabus & Jurusan</a>
    </div>

    <div class="programs-grid">
      {programs.map((item) => (
        <article class="program-card">
          <div class="card-header-visual">
            <span class="category-badge">{cardBadges[item.data.id] || "Peminatan"}</span>
            <span class="grade-pill">{item.data.targetGrade}</span>
          </div>

          <div class="card-body">
            <span class="subtitle-text">{item.data.subtitle}</span>
            <h3 class="card-title">{item.data.title}</h3>
            <p class="card-desc">{item.data.description}</p>

            <div class="divider-hairline"></div>

            <ul class="points-list">
              {item.data.curriculumPoints.map((point) => (
                <li>
                  <span class="point-icon">&bull;</span>
                  <span>{point}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="card-footer">
            <a href="/#chatbot" class="card-btn-pill">
              <span>Konsultasi Kurikulum</span>
              <span class="arrow-ico">&rarr;</span>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .programs-section {
    padding: 70px 0 90px;
    background-color: var(--color-bg);
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 44px;
    gap: 24px;
    flex-wrap: wrap;
  }

  .section-tag {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent-coral);
    margin-bottom: 8px;
    display: block;
  }

  .section-title {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 3.8vw, 2.7rem);
    color: var(--color-text-primary);
    max-width: 660px;
    line-height: 1.2;
  }

  .programs-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
  }

  .program-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 32px 28px;
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-subtle);
    transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
  }

  .program-card:hover {
    transform: translateY(-4px);
    border-color: var(--color-accent-coral);
    box-shadow: var(--shadow-card);
  }

  .card-header-visual {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
  }

  .category-badge {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-accent-coral);
  }

  .grade-pill {
    background-color: var(--color-surface-muted);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    padding: 3px 10px;
    border-radius: var(--radius-pill);
    color: var(--color-text-secondary);
    border: 1px solid var(--color-border);
  }

  .subtitle-text {
    font-size: 0.78rem;
    color: var(--color-text-muted);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    display: block;
    margin-bottom: 6px;
  }

  .card-title {
    font-family: var(--font-serif);
    font-size: 1.4rem;
    color: var(--color-text-primary);
    margin-bottom: 12px;
    line-height: 1.25;
  }

  .card-desc {
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    margin-bottom: 20px;
    line-height: 1.6;
  }

  .divider-hairline {
    width: 100%;
    height: 1px;
    background-color: var(--color-border);
    margin-bottom: 20px;
  }

  .points-list {
    list-style: none;
    margin-bottom: 28px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-size: 0.88rem;
    color: var(--color-text-primary);
  }

  .points-list li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    line-height: 1.45;
  }

  .point-icon {
    color: var(--color-accent-coral);
    font-weight: 700;
    flex-shrink: 0;
  }

  .card-footer {
    margin-top: auto;
  }

  .card-btn-pill {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 10px 18px;
    background-color: var(--color-surface-muted);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-text-primary);
    transition: all 0.2s ease;
    text-decoration: none;
  }

  .card-btn-pill:hover {
    background-color: var(--color-text-primary);
    color: var(--color-bg);
    border-color: var(--color-text-primary);
  }

  .arrow-ico {
    font-size: 1rem;
  }

  @media (max-width: 960px) {
    .programs-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
