---
import { getCollection } from 'astro:content';

const programs = await getCollection('programs');
programs.sort((a, b) => a.data.order - b.data.order);

const cardLabels: Record<string, string> = {
  "mipa-riset": "Riset dan sains terapan",
  "ips-kreatif": "Sosial dan ekonomi modern",
  "bahasa-global": "Diplomasi dan budaya"
};
---

<section class="programs-section sec" id="program">
  <div class="container">
    <div class="section-header">
      <div>
        <p class="lbl">Kurikulum Merdeka</p>
        <h2 class="section-title">Tiga pilar peminatan akademik</h2>
      </div>
      <a href="/program" class="btn-text">Lihat silabus lengkap</a>
    </div>

    <div class="programs-grid">
      {programs.map((item) => (
        <article class="program-card" data-reveal>
          <p class="card-label">{cardLabels[item.data.id] || "Peminatan"}</p>
          <span class="card-grade num">{item.data.targetGrade}</span>

          <h3 class="card-title">{item.data.title}</h3>
          <p class="card-desc">{item.data.description}</p>

          <ul class="points-list">
            {item.data.curriculumPoints.map((point) => (
              <li>
                <span class="point-mark" aria-hidden="true"></span>
                <span>{point}</span>
              </li>
            ))}
          </ul>

          <div class="card-footer">
            <a href="/#chatbot" class="card-link">
              Tanya SmansaBot AI
              <span class="arrow-ico" aria-hidden="true">&rarr;</span>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .programs-section {
    padding-top: clamp(56px, 8vw, 88px);
    padding-bottom: clamp(56px, 8vw, 88px);
    border-top: 1px solid var(--hairline);
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: clamp(28px, 4vw, 44px);
    gap: 20px;
    flex-wrap: wrap;
  }

  .section-title {
    font-size: clamp(1.75rem, 3.2vw, 2.4rem);
    font-weight: 500;
    max-width: 24ch;
  }

  .programs-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--hairline);
    border: 1px solid var(--hairline);
    border-radius: var(--r-md);
    overflow: hidden;
  }

  .program-card {
    background: var(--surface);
    padding: clamp(24px, 3vw, 32px);
    display: flex;
    flex-direction: column;
    transition: background 0.2s ease;
  }

  .program-card:hover {
    background: var(--paper-2);
  }

  .card-label {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 10px;
  }

  .card-grade {
    align-self: flex-start;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    padding: 3px 8px;
    border: 1px solid var(--hairline-2);
    border-radius: var(--r-sm);
    color: var(--ink-3);
    margin-bottom: 18px;
  }

  .card-title {
    font-size: 1.3125rem;
    font-weight: 500;
    margin-bottom: 12px;
    line-height: 1.25;
  }

  .card-desc {
    font-size: 0.9375rem;
    color: var(--ink-2);
    margin-bottom: 20px;
    line-height: 1.6;
  }

  .points-list {
    list-style: none;
    margin-bottom: 24px;
    display: flex;
    flex-direction: column;
    gap: 9px;
    font-size: 0.9062rem;
    color: var(--ink-2);
  }

  .points-list li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    line-height: 1.5;
  }

  .point-mark {
    width: 5px;
    height: 5px;
    margin-top: 8px;
    border-radius: 50%;
    background: var(--accent);
    flex-shrink: 0;
  }

  .card-footer {
    margin-top: auto;
  }

  .card-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.9062rem;
    font-weight: 500;
    color: var(--ink);
    border-bottom: 1px solid var(--hairline-2);
    padding-bottom: 2px;
    transition: color 0.18s ease, border-color 0.18s ease;
  }

  .card-link:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .arrow-ico {
    transition: transform 0.18s ease;
  }

  .card-link:hover .arrow-ico {
    transform: translateX(3px);
  }

  @media (max-width: 900px) {
    .programs-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
