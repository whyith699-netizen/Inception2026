<section class="value-prop-section" id="fasilitas">
  <div class="container">
    <div class="section-title-wrap text-center">
      <span class="meta-tag">Sarana & Prasarana Kampus 13</span>
      <h2 class="section-heading">Fasilitas Penunjang Riset Sains & Budaya Luhur</h2>
      <p class="section-desc">
        Lingkungan belajar yang memadukan cagar sejarah, kenyamanan hijau, dan kelengkapan teknologi laboratorium berstandar nasional.
      </p>
    </div>

    <div class="prop-grid">
      <!-- Pillar 1 -->
      <div class="prop-card">
        <div class="prop-header">
          <span class="prop-pill">Sains & Riset Komputasi</span>
          <h3 class="prop-title">Laboratorium Terpadu & Graha Pustaka</h3>
        </div>
        <p class="prop-desc-text">
          Tersedia 3 Laboratorium Komputer modern berkecepatan tinggi, Lab Kimia, Fisika, Biologi dengan peranti eksperimen lengkap, serta Perpustakaan Digital Graha Pustaka terakreditasi A nasional.
        </p>
        <div class="prop-footer">
          <a href="/fasilitas" class="prop-link">
            Jelajahi Sarana Akademik &rarr;
          </a>
        </div>
      </div>

      <!-- Pillar 2 -->
      <div class="prop-card">
        <div class="prop-header">
          <span class="prop-pill">Karakter & Seni Budaya</span>
          <h3 class="prop-title">Sanggar Seni Karawitan & Gelanggang Olahraga</h3>
        </div>
        <p class="prop-desc-text">
          Memadukan pelestarian tradisi gamelan karawitan Jawa gagrak Surakarta dengan sarana kebugaran modern GOR Indoor Smansa untuk kompetisi basket, bulutangkis, dan futsal.
        </p>
        <div class="prop-footer">
          <a href="/program" class="prop-link">
            Katalog 23 Ekstrakurikuler &rarr;
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .value-prop-section {
    padding: 70px 0 90px;
    background-color: var(--color-bg);
  }

  .text-center { text-align: center; }

  .section-title-wrap {
    max-width: 740px;
    margin: 0 auto 48px;
  }

  .meta-tag {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--color-accent-coral);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .section-heading {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 3.8vw, 2.7rem);
    color: var(--color-text-primary);
    margin: 10px 0 12px;
  }

  .section-desc {
    font-size: 1.02rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .prop-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
  }

  .prop-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 36px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-shadow: var(--shadow-subtle);
    transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
  }

  .prop-card:hover {
    transform: translateY(-4px);
    border-color: var(--color-accent-coral);
    box-shadow: var(--shadow-card);
  }

  .prop-header {
    margin-bottom: 16px;
  }

  .prop-pill {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--color-accent-coral);
    background-color: var(--color-surface-muted);
    padding: 4px 10px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-border);
    display: inline-block;
    margin-bottom: 12px;
  }

  .prop-title {
    font-family: var(--font-serif);
    font-size: 1.45rem;
    font-weight: 700;
    color: var(--color-text-primary);
    line-height: 1.3;
  }

  .prop-desc-text {
    font-size: 0.94rem;
    color: var(--color-text-secondary);
    line-height: 1.65;
    margin-bottom: 28px;
  }

  .prop-footer {
    margin-top: auto;
  }

  .prop-link {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--color-accent-coral);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .prop-link:hover {
    color: var(--color-accent-coral-hover);
    text-decoration: underline;
  }

  @media (max-width: 860px) {
    .prop-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
