---
import { Image } from 'astro:assets';
import Smansa4 from '../assets/school/Smansa4.jpg';
import Smansa3 from '../assets/school/Smansa3.jpg';

const facilities = [
  {
    label: "Sains dan riset komputasi",
    title: "Laboratorium terpadu dan Graha Pustaka",
    desc: "Tiga laboratorium komputer, lab kimia, fisika, dan biologi dengan perangkat eksperimen lengkap, serta perpustakaan digital e-Perpus sebagai pusat literasi sekolah.",
    image: Smansa4,
    alt: "Koridor laboratorium riset SMA Negeri 1 Klaten",
    link: { href: "/fasilitas", label: "Lihat fasilitas akademik" }
  },
  {
    label: "Karakter dan seni budaya",
    title: "Sanggar seni dan gelanggang olahraga",
    desc: "Sanggar karawitan dan teater untuk pelestarian budaya Jawa, didampingi GOR dalam ruangan untuk latihan basket, bulutangkis, dan futsal.",
    image: Smansa3,
    alt: "Gedung kompleks kelas SMA Negeri 1 Klaten",
    link: { href: "/program", label: "Lihat 23 ekstrakurikuler" }
  }
];
---

<section class="value-prop-section sec" id="fasilitas">
  <div class="container">
    <div class="section-intro">
      <p class="lbl">Sarana dan prasarana</p>
      <h2 class="section-heading">Fasilitas penunjang belajar</h2>
    </div>

    <div class="prop-grid">
      {facilities.map((item, idx) => (
        <article class="prop-card" data-reveal>
          <figure class="prop-figure">
            <Image
              src={item.image}
              alt={item.alt}
              widths={[480, 720]}
              sizes="(max-width: 860px) 100vw, 560px"
              width={720}
              height={480}
              loading={idx === 0 ? "eager" : "lazy"}
              class="prop-photo"
            />
          </figure>
          <div class="prop-body">
            <p class="prop-label">{item.label}</p>
            <h3 class="prop-title">{item.title}</h3>
            <p class="prop-desc-text">{item.desc}</p>
            <a href={item.link.href} class="btn-text">{item.link.label}</a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .value-prop-section {
    padding-top: clamp(56px, 8vw, 88px);
    padding-bottom: clamp(56px, 8vw, 88px);
    border-top: 1px solid var(--hairline);
  }

  .section-intro {
    max-width: 620px;
    margin-bottom: clamp(28px, 4vw, 44px);
  }

  .section-heading {
    font-size: clamp(1.75rem, 3.2vw, 2.4rem);
    font-weight: 500;
    max-width: 24ch;
  }

  .prop-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(24px, 4vw, 48px);
  }

  .prop-card {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .prop-figure {
    border: 1px solid var(--hairline);
    border-radius: var(--r-md);
    overflow: hidden;
    background: var(--surface);
  }

  .prop-photo {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  .prop-body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
  }

  .prop-label {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .prop-title {
    font-size: 1.3125rem;
    font-weight: 500;
    margin: 0;
    line-height: 1.3;
  }

  .prop-desc-text {
    font-size: 0.9375rem;
    color: var(--ink-2);
    line-height: 1.65;
    margin: 0;
  }

  @media (max-width: 860px) {
    .prop-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
