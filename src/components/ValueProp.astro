---

<section class="value-prop-section" id="fasilitas">
  <div class="container">
    <div class="split-prop-wrapper">
      <div class="split-prop-grid">
        <!-- Left Yellow Card -->
        <div class="prop-card prop-yellow">
          <span class="prop-tag">Infrastruktur Riset & Literasi</span>
          <h3 class="prop-title">Fasilitas Modern untuk Menopang Eksplorasi Sains</h3>
          <p class="prop-desc">
            Laboratorium terpadu (Fisika, Kimia, Biologi, 3 Lab Komputer), Perpustakaan Digital Graha Pustaka dengan koneksi gigabit fiber optic.
          </p>
          <div class="prop-cta">
            <a href="/fasilitas" class="btn btn-outline btn-arrow">Katalog Sarana Lab</a>
          </div>
        </div>

        <!-- Overlapping Center Boundary-Breaking Badge (Pure SVG) -->
        <div class="center-overlap-badge" aria-hidden="true">
          <svg class="center-svg" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="50" cy="50" r="46" fill="#221610" stroke="#FFFFFF" stroke-width="4"/>
            <!-- Crossed Compass & Laurel -->
            <path d="M50 22V78M22 50H78" stroke="#F9BC2C" stroke-width="3" stroke-linecap="round"/>
            <circle cx="50" cy="50" r="14" fill="#E85A38"/>
            <path d="M42 50L48 56L58 44" stroke="#FFFFFF" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span class="center-label">Unggul & Berkarakter</span>
        </div>

        <!-- Right Coral Card -->
        <div class="prop-card prop-coral">
          <span class="prop-tag tag-white">Pengembangan Karakter Luhur</span>
          <h3 class="prop-title title-white">Ruang Apresiasi Seni, Budaya & Olahraga Terbuka</h3>
          <p class="prop-desc desc-white">
            Gelanggang Olahraga indoor (GOR Smansa), Sanggar Karawitan berstandar keraton, panggung ekspresi kreasi siswa, dan 25+ ekstrakurikuler aktif.
          </p>
          <div class="prop-cta">
            <a href="/program" class="btn btn-dark-pill btn-arrow">Pilihan Ekstrakurikuler</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .value-prop-section {
    padding: var(--section-spacing) 0;
  }

  .split-prop-wrapper {
    position: relative;
  }

  .split-prop-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
    position: relative;
  }

  .prop-card {
    border-radius: var(--radius-xl);
    padding: 52px 48px;
    border: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 380px;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .prop-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 36px rgba(34, 22, 16, 0.07);
  }

  .prop-yellow {
    background-color: #FDF3D6;
    border-color: #F2E1B4;
  }

  .prop-coral {
    background-color: var(--color-accent-coral);
    border-color: #D94E2C;
    color: #FFFFFF;
  }

  .prop-tag {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent-coral);
    margin-bottom: 16px;
    display: block;
  }

  .tag-white {
    color: var(--color-accent-yellow);
  }

  .prop-title {
    font-size: clamp(1.65rem, 2.5vw, 2.3rem);
    margin-bottom: 16px;
    line-height: 1.25;
  }

  .title-white {
    color: #FFFFFF;
  }

  .prop-desc {
    font-size: 0.96rem;
    color: var(--color-text-secondary);
    margin-bottom: 32px;
    line-height: 1.6;
    max-width: 440px;
  }

  .desc-white {
    color: #FCE8E2;
  }

  .btn-dark-pill {
    background-color: var(--color-dark-ribbon);
    color: #FFFFFF;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 0.95rem;
    padding: 12px 28px;
    border-radius: var(--radius-pill);
    cursor: pointer;
    transition: transform 0.15s ease, background-color 0.15s ease;
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  .btn-dark-pill:hover {
    background-color: #000000;
  }

  /* Center Overlapping Element */
  .center-overlap-badge {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    z-index: 10;
    pointer-events: none;
  }

  .center-svg {
    width: 82px;
    height: 82px;
    filter: drop-shadow(0 6px 16px rgba(0, 0, 0, 0.18));
  }

  .center-label {
    background-color: var(--color-surface);
    color: var(--color-text-primary);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    padding: 3px 10px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-border);
    white-space: nowrap;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.08);
  }

  @media (max-width: 900px) {
    .split-prop-grid {
      grid-template-columns: 1fr;
    }
    .center-overlap-badge {
      display: none;
    }
  }
</style>
