---
import { Image } from 'astro:assets';
import Smansa1 from '../assets/school/Smansa1.jpg';
---

<section class="hero-section" id="beranda-hero">
  <div class="container hero-container">
    <p class="lbl hero-lbl">Sekolah Menengah Atas Negeri 1 Klaten</p>

    <h1 class="hero-headline">
      Membina generasi berkarakter, kritis, dan berdaya jaya sejak 1957.
    </h1>

    <p class="hero-desc">
      SMA Negeri 1 Klaten menjalankan Kurikulum Merdeka berbasis riset dengan 33 rombongan
      belajar, 23 ekstrakurikuler kesiswaan, serta pendampingan akademik melalui asisten
      digital SmansaBot AI.
    </p>

    <div class="hero-actions">
      <a href="/ppdb" class="btn btn-primary">Lihat alur PPDB 2026</a>
      <a href="/profil" class="btn-text">Sejarah sekolah dari 1957 hingga kini</a>
    </div>

    <figure class="hero-figure">
      <Image
        src={Smansa1}
        alt="Gedung utama SMA Negeri 1 Klaten di Jalan Merbabu Nomor 13, Klaten Selatan"
        widths={[640, 1024, 1400]}
        sizes="(max-width: 900px) 100vw, 1120px"
        width={1400}
        height={740}
        loading="eager"
        class="hero-photo"
      />
      <figcaption class="hero-caption">
        <span>Gedung utama Kampus 13</span>
        <span class="hero-caption-sep" aria-hidden="true"></span>
        <span>Jl. Merbabu No. 13, Klaten, Jawa Tengah 57423</span>
        <span class="hero-caption-sep" aria-hidden="true"></span>
        <span class="num">NPSN 20309676</span>
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .hero-section {
    padding: clamp(48px, 7vw, 84px) 0 clamp(40px, 5vw, 64px);
    background-color: var(--paper);
  }

  .hero-container {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .hero-lbl {
    margin-bottom: 18px;
  }

  .hero-headline {
    font-size: clamp(2.1rem, 4.6vw, 3.4rem);
    font-weight: 500;
    line-height: 1.12;
    letter-spacing: -0.025em;
    max-width: 20ch;
    margin-bottom: 22px;
  }

  .hero-desc {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--ink-2);
    max-width: 62ch;
    margin-bottom: 32px;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
    margin-bottom: clamp(36px, 5vw, 56px);
  }

  .hero-figure {
    width: 100%;
    border: 1px solid var(--hairline);
    border-radius: var(--r-md);
    overflow: hidden;
    background: var(--surface);
  }

  .hero-photo {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .hero-caption {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    padding: 14px 18px;
    border-top: 1px solid var(--hairline);
    font-size: 0.8125rem;
    color: var(--ink-3);
  }

  .hero-caption-sep {
    width: 1px;
    height: 12px;
    background: var(--hairline-2);
  }

  @media (max-width: 640px) {
    .hero-caption-sep {
      display: none;
    }
  }
</style>
