---
import { Image } from 'astro:assets';
import Smansa1 from '../assets/school/Smansa1.jpg';
---

<section class="hero-broadside" id="beranda-hero">
  <div class="container hero-inner">
    <!-- Eyebrow Meta Bar with Neon Brutalist Sticker -->
    <div class="hero-meta-bar" data-reveal>
      <span class="meta-tag">EST. 1957</span>
      <span class="meta-sep" aria-hidden="true">&middot;</span>
      <span class="meta-tag">SMA NEGERI 1 KLATEN</span>
      <span class="meta-sep" aria-hidden="true">&middot;</span>
      <span class="meta-tag">KAMPUS 13 PADMAWIJAYA</span>
      <span class="meta-sep" aria-hidden="true">&middot;</span>
      <span class="meta-coords num">7&deg;42'06.5"S 110&deg;36'09.0"E</span>
    </div>

    <!-- Main Headline with Neon Accent Highlight -->
    <h1 class="hero-title" data-reveal>
      Tradisi Keunggulan Akademik dan Budi Luhur di Bumi <em>Padmawijaya</em>.
    </h1>

    <!-- Lead Description -->
    <p class="hero-lead" data-reveal>
      Sekolah rujukan tertua di Klaten yang mendidik 1.190 siswa dalam 33 rombongan belajar
      Kurikulum Merdeka. Memadukan riset sains, 23 ekstrakurikuler, dan sarana kampus
      seluas 15.619 m&sup2; berakreditasi A dengan <strong>Nilai 98 BAN-SM</strong>.
    </p>

    <!-- Action Row -->
    <div class="hero-cta-group" data-reveal>
      <a href="/ppdb" class="btn btn-primary">Informasi PPDB 2026</a>
      <a href="/direktori" class="btn btn-secondary">Direktori 78 Pendidik</a>
      <a href="/alumni" class="btn btn-outline">Portal Alumni &rarr;</a>
    </div>

    <!-- Credential Micro-Grid with Brutalist Hard Shadows -->
    <div class="hero-cred-grid" data-reveal>
      <div class="cred-cell card">
        <span class="cred-num num">98</span>
        <div class="cred-info">
          <strong class="cred-title">Akreditasi A Unggul</strong>
          <span class="cred-sub">SK No. 1347/BAN-SM/2021</span>
        </div>
      </div>
      <div class="cred-cell card">
        <span class="cred-num num">20309676</span>
        <div class="cred-info">
          <strong class="cred-title">NPSN Resmi</strong>
          <span class="cred-sub">NSS: 301046002001</span>
        </div>
      </div>
      <div class="cred-cell card">
        <span class="cred-num num">33 Rombel</span>
        <div class="cred-info">
          <strong class="cred-title">1.190 Siswa</strong>
          <span class="cred-sub">Kampus 15.619 m&sup2;</span>
        </div>
      </div>
    </div>

    <!-- Architectural Showcase Frame with Neo-Brutalist Frame -->
    <figure class="hero-showcase" data-reveal>
      <div class="frame-border">
        <Image
          src={Smansa1}
          alt="Gedung utama Kampus 13 SMA Negeri 1 Klaten di Jalan Merbabu Nomor 13 Klaten Selatan"
          widths={[640, 1024, 1400]}
          sizes="(max-width: 900px) 100vw, 1120px"
          width={1400}
          height={740}
          loading="eager"
          class="hero-img"
        />
        <div class="frame-badge">
          <span class="badge-dot" aria-hidden="true"></span>
          <span>Kampus Rujukan Jawa Tengah &middot; Nilai 98</span>
        </div>
      </div>
      <figcaption class="hero-caption">
        <span class="caption-title">Gedung Utama Kampus 13</span>
        <span class="sep" aria-hidden="true">&middot;</span>
        <span>Jalan Merbabu Nomor 13, Klaten Selatan 57423</span>
        <span class="sep" aria-hidden="true">&middot;</span>
        <span class="caption-archive">Arsip Dokumentasi Humas SMAN 1 Klaten</span>
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .hero-broadside {
    padding: clamp(60px, 8vw, 96px) 0 clamp(48px, 6vw, 76px);
    background-color: var(--neo-bg);
    border-bottom: var(--neo-border);
  }

  .hero-inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  /* Micro-Eyebrow Bar as Neon Brutalist Badge */
  .hero-meta-bar {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: var(--tracking-wide);
    color: var(--neo-ink);
    text-transform: uppercase;
    margin-bottom: 24px;
    padding: 8px 16px;
    background: var(--neon-lime);
    border: var(--neo-border);
    box-shadow: 3px 3px 0px var(--neo-ink);
    border-radius: var(--r-sm);
  }

  .meta-sep {
    color: var(--neo-ink);
    font-weight: 900;
  }

  .meta-coords {
    color: var(--neo-ink);
    font-variant-numeric: tabular-nums;
  }

  /* Display Headline */
  .hero-title {
    font-size: clamp(2.4rem, 5.5vw, 4rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.035em;
    color: var(--neo-ink);
    max-width: 23ch;
    margin: 0 0 24px;
  }

  .hero-title em {
    background: var(--neon-cyan);
    color: var(--neo-ink);
    padding: 0 10px;
    border: var(--neo-border);
    box-shadow: 4px 4px 0px var(--neo-ink);
    font-style: normal;
    display: inline-block;
  }

  /* Lead Description */
  .hero-lead {
    font-size: clamp(1.1rem, 1.9vw, 1.25rem);
    line-height: 1.65;
    color: var(--neo-ink-2);
    max-width: 68ch;
    margin: 0 0 36px;
  }

  .hero-lead strong {
    color: var(--neo-ink);
    font-weight: 800;
    background: rgba(212, 255, 0, 0.45);
    padding: 2px 6px;
    border-bottom: 2px solid var(--neo-ink);
  }

  /* Action Buttons */
  .hero-cta-group {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 48px;
  }

  /* Credential Micro-Grid */
  .hero-cred-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    width: 100%;
    margin-bottom: clamp(36px, 5vw, 56px);
  }

  .cred-cell {
    padding: 22px 24px;
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .cred-num {
    font-family: var(--font-mono);
    font-size: clamp(1.6rem, 2.6vw, 2.2rem);
    font-weight: 800;
    color: var(--neo-ink);
    letter-spacing: -0.02em;
    line-height: 1;
    background: var(--neon-yellow);
    border: var(--neo-border-thin);
    box-shadow: 2px 2px 0px var(--neo-ink);
    padding: 6px 12px;
  }

  .cred-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .cred-title {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    font-weight: 800;
    color: var(--neo-ink);
  }

  .cred-sub {
    font-size: 0.75rem;
    color: var(--neo-ink-3);
    font-family: var(--font-mono);
    font-weight: 600;
  }

  /* Architectural Showcase Frame */
  .hero-showcase {
    width: 100%;
    margin: 0;
    border: var(--neo-border-thick);
    border-radius: var(--r-md);
    background: var(--neo-surface);
    box-shadow: var(--neo-shadow-lg);
    overflow: hidden;
    padding: 8px;
  }

  .frame-border {
    position: relative;
    border: var(--neo-border);
    border-radius: var(--r-sm);
    overflow: hidden;
  }

  .hero-img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    display: block;
  }

  /* Digital Seal Badge */
  .frame-badge {
    position: absolute;
    bottom: 16px;
    right: 16px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    background: var(--neon-lime);
    border: var(--neo-border);
    box-shadow: 3px 3px 0px var(--neo-ink);
    border-radius: var(--r-sm);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 800;
    color: var(--neo-ink);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .badge-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--neon-magenta);
    border: 1px solid var(--neo-ink);
  }

  /* Technical Caption */
  .hero-caption {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    padding: 16px 14px 8px;
    font-size: 0.85rem;
    color: var(--neo-ink-2);
    font-family: var(--font-mono);
    font-weight: 600;
  }

  .caption-title {
    font-weight: 800;
    color: var(--neo-ink);
  }

  .sep {
    color: var(--neo-ink-3);
  }

  .caption-archive {
    margin-left: auto;
  }

  @media (max-width: 840px) {
    .hero-cred-grid {
      grid-template-columns: 1fr;
    }

    .caption-archive {
      margin-left: 0;
    }

    .frame-badge {
      position: static;
      margin: 10px 10px 0;
    }
  }
</style>
