---
const currentYear = 2026;
---

<footer class="site-footer">
  <div class="container footer-container">
    <div class="footer-top">
      <div class="footer-brand">
        <div class="brand-header">
          <img src="/images/school/logo.png" alt="Logo SMAN 1 Klaten" class="footer-logo-img" width="44" height="44" />
          <div>
            <span class="footer-logo">SMANSA<span class="dot">.</span></span>
            <span class="brand-motto">Padmawijaya • Kampus 13</span>
          </div>
        </div>
        
        <p class="brand-desc">
          SMA Negeri 1 Klaten. Didirikan 5 November 1957. Pusat rujukan pendidikan menengah atas tertua di Klaten dengan Akreditasi A (Nilai 98) BAN-SM.
        </p>

        <div class="school-badges">
          <span class="school-code">NPSN: 20309676</span>
          <span class="school-code">NSS: 301046002001</span>
          <span class="school-code">Nilai Akreditasi: 98</span>
        </div>

        <div class="team-credit-box">
          <span class="credit-title">Dirancang oleh Tim RANDOM KID:</span>
          <p class="credit-names">
            Muhammad Agha Prabswara • Radithya Asadel Narendra • Jalu Budi Dhamarsakti
          </p>
          <span class="competition-tag">Karya Kompetisi INCEPTION 2026</span>
        </div>
      </div>

      <div class="footer-cols">
        <div class="footer-col">
          <h4 class="col-title">Portal Akademik</h4>
          <ul class="col-links">
            <li><a href="http://elearning.sma1klaten.sch.id/" target="_blank" rel="noopener noreferrer">e-Learning SMANSA</a></li>
            <li><a href="https://eperpus.sma1klaten.sch.id/" target="_blank" rel="noopener noreferrer">e-Perpus Graha Pustaka</a></li>
            <li><a href="/program#ekstrakurikuler-resmi">23 ekstrakurikuler resmi</a></li>
            <li><a href="/#chatbot">Layanan SmansaBot AI</a></li>
            <li><a href="/ppdb">Informasi PPDB 2026</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <h4 class="col-title">Navigasi Utama</h4>
          <ul class="col-links">
            <li><a href="/profil">Profil dan filosofi Padmawijaya</a></li>
            <li><a href="/profil#sejarah">Linimasa sejarah sejak 1957</a></li>
            <li><a href="/program">Kurikulum dan peminatan</a></li>
            <li><a href="/direktori">Direktori guru dan pimpinan</a></li>
            <li><a href="/berita">Berita dan pengumuman</a></li>
            <li><a href="/fasilitas">Sarana dan prasarana kampus</a></li>
            <li><a href="/alumni">Alumni & Komunitas KAPASSKA</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <h4 class="col-title">Sekretariat dan Kontak</h4>
          <p class="contact-text">Jl. Merbabu No. 13, Klaten Selatan, Kabupaten Klaten, Jawa Tengah 57423</p>
          <p class="contact-text">Telepon (0272) 321150</p>
          <p class="contact-text">smansa_klaten@yahoo.com</p>
          
          <div class="social-links-wrap">
            <span class="social-label">Media sosial resmi</span>
            <div class="social-links">
              <a href="https://www.instagram.com/sman1klaten_official/" target="_blank" rel="noopener noreferrer" class="social-btn">Instagram</a>
              <a href="https://www.youtube.com/channel/UC4WNENZW75-C3ENYdDx4TtA" target="_blank" rel="noopener noreferrer" class="social-btn">YouTube</a>
              <a href="https://www.facebook.com/SMANSAKLATEN/?locale=id_ID" target="_blank" rel="noopener noreferrer" class="social-btn">Facebook</a>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <p class="copyright">&copy; {currentYear} SMA Negeri 1 Klaten</p>
      <div class="legal-links">
        <a href="/profil">Keterbukaan informasi</a>
        <a href="/ppdb">Standar pelayanan PPDB</a>
        <a href="/kontak">Hubungi tim</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--color-dark-ribbon);
    color: var(--color-dark-ribbon-text);
    padding: 70px 0 32px;
    margin-top: auto;
    border-top: 1px solid var(--dark-hairline);
  }

  .footer-top {
    display: grid;
    grid-template-columns: 1.25fr 2fr;
    gap: 60px;
    margin-bottom: 50px;
  }

  .brand-header {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 14px;
  }

  .footer-logo-img {
    width: 44px;
    height: 44px;
    object-fit: contain;
  }

  .footer-logo {
    font-family: var(--font-serif);
    font-size: 1.85rem;
    font-weight: 700;
    display: block;
    line-height: 1;
    color: var(--dark-ink);
  }

  .footer-logo .dot {
    color: var(--color-accent-coral);
  }

  .brand-motto {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-accent-coral);
    font-weight: 700;
    letter-spacing: 0.05em;
  }

  .brand-desc {
    color: var(--dark-ink-muted);
    font-size: 0.88rem;
    line-height: 1.6;
    margin-bottom: 18px;
    max-width: 400px;
  }

  .school-badges {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 22px;
  }

  .school-code {
    background-color: var(--dark-2);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    padding: 5px 12px;
    border-radius: var(--r-sm);
    color: var(--neon-lime);
    border: 1.5px solid var(--neon-lime);
    box-shadow: 2px 2px 0px rgba(212, 255, 0, 0.4);
  }

  .team-credit-box {
    background-color: var(--dark-2);
    border: 2px solid var(--neon-cyan);
    box-shadow: 3px 3px 0px var(--neon-cyan);
    border-radius: var(--r-sm);
    padding: 14px 18px;
    max-width: 420px;
  }

  .credit-title {
    display: block;
    font-size: 0.74rem;
    font-family: var(--font-mono);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--neon-cyan);
    margin-bottom: 4px;
  }

  .credit-names {
    font-size: 0.78rem;
    color: var(--dark-ink-muted);
    line-height: 1.4;
    margin-bottom: 4px;
  }

  .competition-tag {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-accent-coral);
    font-weight: 700;
  }

  .footer-cols {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }

  .col-title {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 16px;
    color: var(--dark-ink);
  }

  .col-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .col-links a {
    color: var(--dark-ink-muted);
    font-size: 0.85rem;
    transition: color 0.15s ease;
    text-decoration: none;
  }

  .col-links a:hover {
    color: var(--dark-ink);
  }

  .contact-text {
    color: var(--dark-ink-muted);
    font-size: 0.85rem;
    margin-bottom: 8px;
    line-height: 1.5;
  }

  .social-links-wrap {
    margin-top: 14px;
  }

  .social-label {
    display: block;
    font-size: 0.74rem;
    color: var(--dark-ink-dim);
    font-family: var(--font-mono);
    margin-bottom: 8px;
  }

  .social-links {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .social-btn {
    background-color: var(--dark-2);
    color: var(--dark-ink-muted);
    font-size: 0.75rem;
    font-weight: 600;
    padding: 4px 10px;
    border-radius: var(--radius-xs);
    text-decoration: none;
    border: 1px solid var(--dark-hairline);
    transition: all 0.2s ease;
  }

  .social-btn:hover {
    background-color: var(--color-accent-coral);
    color: var(--dark-ink);
    border-color: var(--color-accent-coral);
  }

  .footer-bottom {
    border-top: 1px solid var(--dark-hairline);
    padding-top: 24px;
    display: flex;
    justify-content: space-between;
    font-size: 0.8rem;
    color: var(--dark-ink-dim);
    flex-wrap: wrap;
    gap: 14px;
  }

  .legal-links {
    display: flex;
    gap: 18px;
  }

  .legal-links a {
    color: var(--dark-ink-dim);
    text-decoration: none;
  }

  .legal-links a:hover {
    color: var(--dark-ink);
  }

  @media (max-width: 900px) {
    .footer-top {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .footer-cols {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 600px) {
    .footer-cols {
      grid-template-columns: 1fr;
    }
  }
</style>
