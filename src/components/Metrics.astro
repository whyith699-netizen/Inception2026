---
const stats = [
  {
    value: "1957",
    label: "Tahun berdiri",
    sub: "69 tahun berdiri sejak 5 November 1957"
  },
  {
    value: "98",
    label: "Nilai akreditasi BAN-SM",
    sub: "Peringkat A, SK 1347/BAN-SM/SK/2021"
  },
  {
    value: "1.190",
    label: "Peserta didik",
    sub: "33 rombongan belajar kelas X sampai XII"
  },
  {
    value: "94.8%",
    label: "Serapan perguruan tinggi",
    sub: "Diterima di PTN dalam dan luar negeri"
  }
];
---

<section class="metrics-section sec">
  <div class="container">
    <div class="metrics-grid">
      {stats.map((item) => (
        <div class="metric-col" data-reveal>
          <span class="metric-value num">{item.value}</span>
          <span class="metric-label">{item.label}</span>
          <p class="metric-sub">{item.sub}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .metrics-section {
    padding-top: clamp(40px, 6vw, 64px);
    padding-bottom: clamp(40px, 6vw, 64px);
    border-top: 1px solid var(--hairline);
  }

  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid var(--hairline);
  }

  .metric-col {
    padding: 26px 20px 4px;
    display: flex;
    flex-direction: column;
    border-left: 1px solid var(--hairline);
  }

  .metric-col:first-child {
    border-left: none;
    padding-left: 0;
  }

  .metric-value {
    font-family: var(--font-serif);
    font-size: clamp(2.4rem, 3.6vw, 3.2rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    color: var(--ink);
    line-height: 1;
    margin-bottom: 12px;
  }

  .metric-label {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--ink);
    margin-bottom: 4px;
  }

  .metric-sub {
    font-size: 0.8125rem;
    color: var(--ink-3);
    line-height: 1.5;
  }

  @media (max-width: 900px) {
    .metrics-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .metric-col:nth-child(3) {
      border-left: none;
      padding-left: 0;
    }
    .metric-col:nth-child(-n + 2) {
      padding-bottom: 24px;
    }
  }

  @media (max-width: 540px) {
    .metrics-grid {
      grid-template-columns: 1fr;
    }
    .metric-col {
      border-left: none;
      padding-left: 0;
      padding-bottom: 20px;
    }
  }
</style>
