---
const stats = [
  { 
    value: "1957", 
    label: "Tahun Berdiri", 
    sub: "69 Tahun Dedikasi Pendidikan (Sejak 5 Nov 1957)" 
  },
  { 
    value: "Nilai 98", 
    label: "Akreditasi A BAN-SM", 
    sub: "Peringkat Unggul (SK 1347/BAN-SM/SK/2021)" 
  },
  { 
    value: "1.190+", 
    label: "Siswa Aktif", 
    sub: "33 Rombongan Belajar (Kelas X-XII A s.d. K)" 
  },
  { 
    value: "94.8%", 
    label: "Lulusan di PTN", 
    sub: "Diterima UGM, ITB, UI, Undip, UNS & Luar Negeri" 
  }
];
---

<section class="metrics-section">
  <div class="container">
    <div class="metrics-grid">
      {stats.map((item, idx) => (
        <div class="metric-col">
          <span class="metric-value">{item.value}</span>
          <span class="metric-label">{item.label}</span>
          <p class="metric-sub">{item.sub}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .metrics-section {
    padding: 30px 0 60px;
  }

  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-subtle);
  }

  .metric-col {
    padding: 28px 24px;
    display: flex;
    flex-direction: column;
    text-align: left;
    border-right: 1px solid var(--color-border);
  }

  .metric-col:last-child {
    border-right: none;
  }

  .metric-value {
    font-family: var(--font-serif);
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-text-primary);
    line-height: 1.1;
    margin-bottom: 6px;
  }

  .metric-label {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--color-accent-coral);
    margin-bottom: 4px;
  }

  .metric-sub {
    font-size: 0.78rem;
    color: var(--color-text-muted);
    line-height: 1.45;
  }

  @media (max-width: 900px) {
    .metrics-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .metric-col:nth-child(2) {
      border-right: none;
    }
    .metric-col:nth-child(1), .metric-col:nth-child(2) {
      border-bottom: 1px solid var(--color-border);
    }
  }

  @media (max-width: 540px) {
    .metrics-grid {
      grid-template-columns: 1fr;
    }
    .metric-col {
      border-right: none !important;
      border-bottom: 1px solid var(--color-border);
    }
    .metric-col:last-child {
      border-bottom: none;
    }
  }
</style>
