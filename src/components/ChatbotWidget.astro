---
import { getCollection } from 'astro:content';
import InteractiveSmansaBot from './islands/InteractiveSmansaBot';

const faqList = await getCollection('faq').catch(() => []);
const knowledgeBase = faqList.map((item) => ({
  id: item.data.id,
  category: item.data.category,
  keywords: item.data.keywords,
  question: item.data.question,
  answer: item.data.answer
}));
---

<!-- Global Floating SmansaBot AI Modal -->
<InteractiveSmansaBot client:idle initialFaq={knowledgeBase} />
