---
import { getCollection } from 'astro:content';

const faqList = await getCollection('faq');
const knowledgeBase = faqList.map((item) => ({
  id: item.data.id,
  category: item.data.category,
  keywords: item.data.keywords,
  question: item.data.question,
  answer: item.data.answer
}));
---

<section class="chatbot-section" id="chatbot">
  <div class="container">
    <div class="chatbot-header text-center">
      <div class="ai-status-badge">
        <span class="status-pulse"></span> SmansaBot AI • Layanan Informasi 24 Jam
      </div>
      <h2 class="chatbot-title">Asisten Virtual Cerdas SMAN 1 Klaten</h2>
      <p class="chatbot-subtitle">
        Dapatkan penjelasan cepat dan akurat seputar PPDB 2026, profil sekolah, kurikulum merdeka, sarana laboratorium, dan 23 ekstrakurikuler kesiswaan.
      </p>
    </div>

    <div class="chat-container">
      <div class="chat-window">
        <!-- Chat Header -->
        <div class="window-header">
          <div class="bot-info">
            <div class="bot-avatar-circle">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 2a2 2 0 0 1 2 2v2a2 2 0 0 1-2 2 2 2 0 0 1-2-2V4a2 2 0 0 1 2-2z"/>
                <rect x="4" y="8" width="16" height="12" rx="4"/>
                <circle cx="9" cy="14" r="1.5" fill="currentColor"/>
                <circle cx="15" cy="14" r="1.5" fill="currentColor"/>
              </svg>
            </div>
            <div>
              <span class="bot-name">SmansaBot AI</span>
              <span class="bot-role">Asisten Resmi SMAN 1 Klaten</span>
            </div>
          </div>
          <span class="engine-badge">Model FAQ Interaktif</span>
        </div>

        <!-- Chat History -->
        <div class="chat-messages" id="chat-messages">
          <div class="message msg-bot">
            <div class="msg-bubble">
              Salam sejahtera! Saya <strong>SmansaBot</strong>, asisten informasi resmi SMA Negeri 1 Klaten (Padmawijaya). Silakan pilih topik pertanyaan cepat di bawah atau ketik langsung pertanyaan Anda.
            </div>
            <span class="msg-time">Sekarang</span>
          </div>
        </div>

        <!-- Quick Question Suggestions -->
        <div class="suggestions-wrapper">
          <span class="sug-label">Topik Populer:</span>
          <div class="suggestions-pills" id="suggestions-pills">
            <button type="button" class="pill-btn" data-query="ppdb">Jalur PPDB 2026</button>
            <button type="button" class="pill-btn" data-query="fasilitas">Fasilitas Laboratorium</button>
            <button type="button" class="pill-btn" data-query="ekskul">23 Ekstrakurikuler</button>
            <button type="button" class="pill-btn" data-query="profil">Akreditasi & Sejarah</button>
            <button type="button" class="pill-btn" data-query="prestasi">Serapan Alumni PTN</button>
          </div>
        </div>

        <!-- Chat Input Form -->
        <form class="chat-input-bar" id="chat-form">
          <input 
            type="text" 
            id="chat-input" 
            placeholder="Tanyakan sesuatu (misal: syarat PPDB, fasilitas lab, ekstrakurikuler)..." 
            autocomplete="off"
            required 
          />
          <button type="submit" class="btn btn-primary btn-send-minimal" id="chat-send-btn">
            <span>Kirim</span>
            <span>&rarr;</span>
          </button>
        </form>
      </div>
    </div>
  </div>
</section>

<!-- Floating Chatbot Launcher -->
<div class="floating-chatbot-launcher" id="floating-launcher" title="Buka SmansaBot AI">
  <span class="launcher-svg">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
      <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
    </svg>
  </span>
  <span class="launcher-text">Tanya SmansaBot</span>
</div>

<script define:vars={{ knowledgeBase }}>
  document.addEventListener('DOMContentLoaded', () => {
    const messagesContainer = document.getElementById('chat-messages');
    const chatForm = document.getElementById('chat-form');
    const chatInput = document.getElementById('chat-input');
    const suggestionPills = document.querySelectorAll('.pill-btn');
    const floatingLauncher = document.getElementById('floating-launcher');

    function appendMessage(text, isUser = false) {
      const msgDiv = document.createElement('div');
      msgDiv.className = `message ${isUser ? 'msg-user' : 'msg-bot'}`;
      
      const bubble = document.createElement('div');
      bubble.className = 'msg-bubble';
      bubble.textContent = text;
      
      const time = document.createElement('span');
      time.className = 'msg-time';
      const now = new Date();
      time.textContent = `${now.getHours().toString().padStart(2, '0')}:${now.getMinutes().toString().padStart(2, '0')}`;
      
      msgDiv.appendChild(bubble);
      msgDiv.appendChild(time);
      messagesContainer.appendChild(msgDiv);
      messagesContainer.scrollTop = messagesContainer.scrollHeight;
    }

    function searchKnowledgeBase(query) {
      const q = query.toLowerCase().trim();
      let bestMatch = null;
      let highestScore = 0;

      for (const item of knowledgeBase) {
        let score = 0;
        for (const kw of item.keywords) {
          if (q.includes(kw.toLowerCase())) {
            score += 3;
          }
        }
        if (q.includes(item.category.toLowerCase())) score += 2;
        if (item.question.toLowerCase().includes(q)) score += 4;

        if (score > highestScore) {
          highestScore = score;
          bestMatch = item;
        }
      }

      if (highestScore > 0 && bestMatch) {
        return bestMatch.answer;
      }

      return `Terima kasih atas pertanyaan Anda. Terkait "${query}", silakan hubungi Sekretariat SMA Negeri 1 Klaten di Jl. Merbabu No. 13 Klaten (0272) 321150 atau email info@sma1klaten.sch.id.`;
    }

    function handleUserInput(input) {
      if (!input.trim()) return;
      appendMessage(input, true);

      setTimeout(() => {
        const response = searchKnowledgeBase(input);
        appendMessage(response, false);
      }, 200);
    }

    if (chatForm && chatInput) {
      chatForm.addEventListener('submit', (e) => {
        e.preventDefault();
        const text = chatInput.value;
        chatInput.value = '';
        handleUserInput(text);
      });
    }

    suggestionPills.forEach((pill) => {
      pill.addEventListener('click', () => {
        const queryKey = pill.getAttribute('data-query');
        const match = knowledgeBase.find(k => k.id.includes(queryKey) || k.category.toLowerCase().includes(queryKey));
        if (match) {
          handleUserInput(match.question);
        } else {
          handleUserInput(pill.textContent || '');
        }
      });
    });

    if (floatingLauncher) {
      floatingLauncher.addEventListener('click', () => {
        const section = document.getElementById('chatbot');
        if (section) {
          section.scrollIntoView({ behavior: 'smooth' });
          if (chatInput) chatInput.focus();
        }
      });
    }
  });
</script>

<style>
  .chatbot-section {
    padding: 70px 0 90px;
    background-color: var(--color-bg);
  }

  .text-center { text-align: center; }

  .chatbot-header {
    max-width: 740px;
    margin: 0 auto 40px;
  }

  .ai-status-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    padding: 6px 16px;
    border-radius: var(--radius-pill);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 700;
    color: var(--color-text-secondary);
    margin-bottom: 16px;
  }

  .status-pulse {
    width: 6px;
    height: 6px;
    background-color: var(--color-accent-green);
    border-radius: 50%;
  }

  .chatbot-title {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 3.8vw, 2.7rem);
    color: var(--color-text-primary);
    margin-bottom: 12px;
  }

  .chatbot-subtitle {
    font-size: 1.02rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .chat-container {
    max-width: 840px;
    margin: 0 auto;
  }

  .chat-window {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-card);
    display: flex;
    flex-direction: column;
  }

  .window-header {
    background-color: var(--color-dark-ribbon);
    color: var(--color-dark-ribbon-text);
    padding: 16px 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .bot-info {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .bot-avatar-circle {
    background-color: rgba(255, 255, 255, 0.12);
    border-radius: 50%;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-accent-coral);
  }

  .bot-name {
    display: block;
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 1rem;
    color: #FFFFFF;
  }

  .bot-role {
    display: block;
    font-size: 0.74rem;
    color: #A99E96;
  }

  .engine-badge {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    background-color: rgba(255, 255, 255, 0.1);
    color: #E8E1D7;
    padding: 4px 10px;
    border-radius: var(--radius-pill);
  }

  .chat-messages {
    padding: 24px;
    min-height: 260px;
    max-height: 380px;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 16px;
    background-color: var(--color-surface-muted);
  }

  .message {
    display: flex;
    flex-direction: column;
    max-width: 80%;
  }

  .msg-bot {
    align-self: flex-start;
  }

  .msg-user {
    align-self: flex-end;
  }

  .msg-bubble {
    padding: 12px 18px;
    border-radius: var(--radius-md);
    font-size: 0.92rem;
    line-height: 1.55;
  }

  .msg-bot .msg-bubble {
    background-color: var(--color-surface);
    color: var(--color-text-primary);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-subtle);
  }

  .msg-user .msg-bubble {
    background-color: var(--color-accent-coral);
    color: #FFFFFF;
  }

  .msg-time {
    font-size: 0.7rem;
    color: var(--color-text-muted);
    margin-top: 4px;
    padding: 0 2px;
  }

  .msg-user .msg-time {
    align-self: flex-end;
  }

  .suggestions-wrapper {
    padding: 12px 24px;
    background-color: var(--color-surface);
    border-top: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .sug-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--color-text-muted);
    text-transform: uppercase;
  }

  .suggestions-pills {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .pill-btn {
    background-color: var(--color-surface-muted);
    border: 1px solid var(--color-border);
    color: var(--color-text-secondary);
    font-size: 0.78rem;
    font-weight: 600;
    padding: 5px 12px;
    border-radius: var(--radius-pill);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .pill-btn:hover {
    border-color: var(--color-accent-coral);
    color: var(--color-accent-coral);
    background-color: var(--color-surface);
  }

  .chat-input-bar {
    padding: 14px 20px;
    background-color: var(--color-surface);
    border-top: 1px solid var(--color-border);
    display: flex;
    gap: 10px;
  }

  .chat-input-bar input {
    flex: 1;
    font-family: var(--font-sans);
    font-size: 0.92rem;
    padding: 10px 16px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    outline: none;
    background-color: var(--color-bg);
    color: var(--color-text-primary);
  }

  .chat-input-bar input:focus {
    border-color: var(--color-accent-coral);
  }

  .btn-send-minimal {
    padding: 10px 20px;
    font-size: 0.88rem;
    border-radius: var(--radius-pill);
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .floating-chatbot-launcher {
    position: fixed;
    bottom: 24px;
    right: 24px;
    background-color: var(--color-dark-ribbon);
    color: var(--color-dark-ribbon-text);
    padding: 10px 18px;
    border-radius: var(--radius-pill);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
    display: flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    z-index: 99;
    font-weight: 600;
    font-size: 0.84rem;
    border: 1px solid rgba(255, 255, 255, 0.15);
    transition: all 0.2s ease;
  }

  .floating-chatbot-launcher:hover {
    background-color: #000000;
    transform: translateY(-2px);
  }

  .launcher-svg {
    display: flex;
    align-items: center;
    color: var(--color-accent-coral);
  }

  @media (max-width: 600px) {
    .suggestions-wrapper {
      flex-direction: column;
      align-items: flex-start;
    }
    .floating-chatbot-launcher .launcher-text {
      display: none;
    }
    .floating-chatbot-launcher {
      padding: 12px;
      border-radius: 50%;
    }
  }
</style>
