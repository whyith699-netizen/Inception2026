---
import { getCollection } from 'astro:content';

const faqList = await getCollection('faq');
const knowledgeBase = faqList.map((item) => ({
  id: item.data.id,
  category: item.data.category,
  keywords: item.data.keywords,
  question: item.data.question,
  answer: item.data.answer
}));
---

<section class="chatbot-section sec" id="chatbot">
  <div class="container">
    <div class="chatbot-header">
      <p class="lbl">SmansaBot AI</p>
      <h2 class="chatbot-title">Tanya seputar sekolah di sini</h2>
      <p class="chatbot-subtitle">
        Asisten informasi SMAN 1 Klaten menjawab pertanyaan tentang PPDB 2026, profil sekolah,
        kurikulum, fasilitas, ekstrakurikuler, dan berita terbaru. Jawaban bekerja sepenuhnya di
        peramban Anda tanpa mengirim data ke server lain.
      </p>
    </div>

    <div class="chat-container">
      <div class="chat-window">
        <!-- Chat Header -->
        <div class="window-header">
          <div class="bot-info">
            <div class="bot-avatar-circle">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                <path d="M12 2a2 2 0 0 1 2 2v2a2 2 0 0 1-2 2 2 2 0 0 1-2-2V4a2 2 0 0 1 2-2z"/>
                <rect x="4" y="8" width="16" height="12" rx="3"/>
                <circle cx="9" cy="14" r="1.5" fill="currentColor"/>
                <circle cx="15" cy="14" r="1.5" fill="currentColor"/>
              </svg>
            </div>
            <div>
              <span class="bot-name">SmansaBot AI</span>
              <span class="bot-role">Asisten informasi SMAN 1 Klaten</span>
            </div>
          </div>
          <span class="engine-badge">Basis data FAQ lokal</span>
        </div>

        <!-- Chat History -->
        <div class="chat-messages" id="chat-messages">
          <div class="message msg-bot">
            <div class="msg-bubble">
              Salam sejahtera! Saya <strong>SmansaBot</strong>, asisten informasi resmi SMA Negeri 1 Klaten (Padmawijaya). Silakan pilih topik pertanyaan cepat di bawah atau ketik langsung pertanyaan Anda.
            </div>
            <span class="msg-time">Sekarang</span>
          </div>
        </div>

        <!-- Quick Question Suggestions -->
        <div class="suggestions-wrapper">
          <span class="sug-label">Topik populer</span>
          <div class="suggestions-pills" id="suggestions-pills">
            <button type="button" class="pill-btn" data-query="ppdb">Jalur PPDB 2026</button>
            <button type="button" class="pill-btn" data-query="direktori">Pimpinan sekolah</button>
            <button type="button" class="pill-btn" data-query="ekskul">23 ekstrakurikuler</button>
            <button type="button" class="pill-btn" data-query="profil">Akreditasi dan sejarah</button>
            <button type="button" class="pill-btn" data-query="berita">Berita terbaru</button>
          </div>
        </div>

        <!-- Chat Input Form -->
        <form class="chat-input-bar" id="chat-form">
          <input
            type="text"
            id="chat-input"
            placeholder="Ketik pertanyaan, misalnya syarat PPDB atau fasilitas sekolah"
            autocomplete="off"
            required
          />
          <button type="submit" class="btn btn-primary btn-send-minimal" id="chat-send-btn">
            <span>Kirim</span>
          </button>
        </form>
      </div>
    </div>
  </div>
</section>

<!-- Floating Chatbot Launcher -->
<div class="floating-chatbot-launcher" id="floating-launcher" title="Buka SmansaBot AI">
  <span class="launcher-svg">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
      <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
    </svg>
  </span>
  <span class="launcher-text">Tanya SmansaBot</span>
</div>

<script define:vars={{ knowledgeBase }}>
  document.addEventListener('DOMContentLoaded', () => {
    const messagesContainer = document.getElementById('chat-messages');
    const chatForm = document.getElementById('chat-form');
    const chatInput = document.getElementById('chat-input');
    const suggestionPills = document.querySelectorAll('.pill-btn');
    const floatingLauncher = document.getElementById('floating-launcher');

    function appendMessage(text, isUser = false) {
      const msgDiv = document.createElement('div');
      msgDiv.className = `message ${isUser ? 'msg-user' : 'msg-bot'}`;
      
      const bubble = document.createElement('div');
      bubble.className = 'msg-bubble';
      bubble.textContent = text;
      
      const time = document.createElement('span');
      time.className = 'msg-time';
      const now = new Date();
      time.textContent = `${now.getHours().toString().padStart(2, '0')}:${now.getMinutes().toString().padStart(2, '0')}`;
      
      msgDiv.appendChild(bubble);
      msgDiv.appendChild(time);
      messagesContainer.appendChild(msgDiv);
      messagesContainer.scrollTop = messagesContainer.scrollHeight;
    }

    function searchKnowledgeBase(query) {
      const q = query.toLowerCase().trim();
      let bestMatch = null;
      let highestScore = 0;

      for (const item of knowledgeBase) {
        let score = 0;
        for (const kw of item.keywords) {
          if (q.includes(kw.toLowerCase())) {
            score += 3;
          }
        }
        if (q.includes(item.category.toLowerCase())) score += 2;
        if (item.question.toLowerCase().includes(q)) score += 4;

        if (score > highestScore) {
          highestScore = score;
          bestMatch = item;
        }
      }

      if (highestScore > 0 && bestMatch) {
        return bestMatch.answer;
      }

      return `Terima kasih atas pertanyaan Anda. Terkait "${query}", silakan hubungi Sekretariat SMA Negeri 1 Klaten di Jl. Merbabu No. 13 Klaten (0272) 321150 atau email info@sma1klaten.sch.id.`;
    }

    function handleUserInput(input) {
      if (!input.trim()) return;
      appendMessage(input, true);

      setTimeout(() => {
        const response = searchKnowledgeBase(input);
        appendMessage(response, false);
      }, 200);
    }

    if (chatForm && chatInput) {
      chatForm.addEventListener('submit', (e) => {
        e.preventDefault();
        const text = chatInput.value;
        chatInput.value = '';
        handleUserInput(text);
      });
    }

    suggestionPills.forEach((pill) => {
      pill.addEventListener('click', () => {
        const queryKey = pill.getAttribute('data-query');
        const match = knowledgeBase.find(k => k.id.includes(queryKey) || k.category.toLowerCase().includes(queryKey));
        if (match) {
          handleUserInput(match.question);
        } else {
          handleUserInput(pill.textContent || '');
        }
      });
    });

    if (floatingLauncher) {
      floatingLauncher.addEventListener('click', () => {
        const section = document.getElementById('chatbot');
        if (section) {
          section.scrollIntoView({ behavior: 'smooth' });
          if (chatInput) chatInput.focus();
        }
      });
    }
  });
</script>

<style>
  .chatbot-section {
    padding-top: clamp(56px, 8vw, 88px);
    padding-bottom: clamp(56px, 8vw, 88px);
    border-top: 1px solid var(--hairline);
  }

  .chatbot-header {
    max-width: 560px;
    margin-bottom: clamp(28px, 4vw, 44px);
  }

  .chatbot-title {
    font-size: clamp(1.75rem, 3.2vw, 2.4rem);
    font-weight: 500;
    margin-bottom: 14px;
  }

  .chatbot-subtitle {
    font-size: 1rem;
    color: var(--ink-2);
    line-height: 1.65;
  }

  .chat-container {
    max-width: 760px;
  }

  .chat-window {
    background-color: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: var(--r-md);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .window-header {
    background-color: var(--dark);
    color: var(--dark-ink);
    padding: 14px 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
  }

  .bot-info {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .bot-avatar-circle {
    background-color: rgba(255, 255, 255, 0.09);
    border-radius: var(--r-sm);
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #E8B4A6;
  }

  .bot-name {
    display: block;
    font-weight: 600;
    font-size: 0.9375rem;
    color: #FFFFFF;
    line-height: 1.3;
  }

  .bot-role {
    display: block;
    font-size: 0.75rem;
    color: #A99E96;
    line-height: 1.3;
  }

  .engine-badge {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    background-color: rgba(255, 255, 255, 0.08);
    color: var(--dark-ink);
    padding: 4px 10px;
    border-radius: var(--r-sm);
    white-space: nowrap;
  }

  .chat-messages {
    padding: 20px;
    min-height: 260px;
    max-height: 400px;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 14px;
    background-color: var(--paper);
  }

  .message {
    display: flex;
    flex-direction: column;
    max-width: 82%;
  }

  .msg-bot {
    align-self: flex-start;
  }

  .msg-user {
    align-self: flex-end;
  }

  .msg-bubble {
    padding: 11px 16px;
    border-radius: var(--r-sm);
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  .msg-bot .msg-bubble {
    background-color: var(--surface);
    color: var(--ink);
    border: 1px solid var(--hairline);
  }

  .msg-user .msg-bubble {
    background-color: var(--accent);
    color: #FFFFFF;
  }

  .msg-time {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--ink-3);
    margin-top: 4px;
    padding: 0 2px;
  }

  .msg-user .msg-time {
    align-self: flex-end;
  }

  .suggestions-wrapper {
    padding: 12px 20px;
    background-color: var(--surface);
    border-top: 1px solid var(--hairline);
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .sug-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .suggestions-pills {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .pill-btn {
    background-color: var(--paper);
    border: 1px solid var(--hairline-2);
    color: var(--ink-2);
    font-size: 0.8125rem;
    font-weight: 500;
    padding: 5px 12px;
    border-radius: var(--r-sm);
    cursor: pointer;
    transition: border-color 0.18s ease, color 0.18s ease, background 0.18s ease;
  }

  .pill-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
    background-color: var(--accent-soft);
  }

  .chat-input-bar {
    padding: 12px 20px;
    background-color: var(--surface);
    border-top: 1px solid var(--hairline);
    display: flex;
    gap: 10px;
  }

  .chat-input-bar input {
    flex: 1;
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    padding: 10px 14px;
    border: 1px solid var(--hairline-2);
    border-radius: var(--r-sm);
    background-color: var(--paper);
    color: var(--ink);
  }

  .chat-input-bar input::placeholder {
    color: var(--ink-3);
  }

  .chat-input-bar input:focus {
    border-color: var(--accent);
  }

  .btn-send-minimal {
    padding: 10px 20px;
    font-size: 0.875rem;
    border-radius: var(--r-sm);
  }

  .floating-chatbot-launcher {
    position: fixed;
    bottom: 24px;
    right: 24px;
    background-color: var(--dark);
    color: var(--dark-ink);
    padding: 10px 16px;
    border-radius: var(--r-sm);
    box-shadow: var(--shadow-2);
    display: flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    z-index: 60;
    font-weight: 500;
    font-size: 0.8125rem;
    border: 1px solid rgba(255, 255, 255, 0.14);
    transition: background 0.2s ease;
  }

  .floating-chatbot-launcher:hover {
    background-color: #241D19;
  }

  .launcher-svg {
    display: flex;
    align-items: center;
    color: #E8B4A6;
  }

  @media (max-width: 600px) {
    .suggestions-wrapper {
      flex-direction: column;
      align-items: flex-start;
    }
    .floating-chatbot-launcher .launcher-text {
      display: none;
    }
    .floating-chatbot-launcher {
      padding: 12px;
      border-radius: var(--r-sm);
    }
  }
</style>
