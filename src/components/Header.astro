---
const pathname = new URL(Astro.request.url).pathname;
const currentPath = pathname.replace(/\/$/, "");

const navLinks = [
  { href: "/profil", label: "Profil" },
  { href: "/program", label: "Akademik" },
  { href: "/direktori", label: "Direktori" },
  { href: "/berita", label: "Berita" },
  { href: "/alumni", label: "Alumni" },
  { href: "/ppdb", label: "PPDB 2026" }
];
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand-link" aria-label="Kembali ke beranda">
      <div class="brand-logo-frame">
        <img
          src="/images/school/logo.png"
          alt="Lambang SMA Negeri 1 Klaten"
          class="brand-logo-img"
          width="32"
          height="32"
          loading="eager"
        />
      </div>
      <div class="brand-text">
        <span class="school-name">SMAN 1 KLATEN</span>
        <span class="school-alias">Padmawijaya &middot; Kampus 13</span>
      </div>
    </a>

    <button
      type="button"
      class="nav-toggle"
      aria-expanded="false"
      aria-controls="main-nav"
      aria-label="Buka menu navigasi"
    >
      <span class="nav-toggle-bar" aria-hidden="true"></span>
      <span class="nav-toggle-bar" aria-hidden="true"></span>
      <span class="nav-toggle-bar" aria-hidden="true"></span>
    </button>

    <nav class="main-nav" id="main-nav" aria-label="Navigasi utama">
      <ul class="nav-list">
        {navLinks.map((link) => {
          const isActive = currentPath === link.href.replace(/\/$/, "");
          return (
            <li>
              <a
                href={link.href}
                class:list={["nav-item", { active: isActive }]}
                aria-current={isActive ? "page" : undefined}
              >
                {link.label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

    <div class="header-action">
      <a href="/#chatbot" class="btn-chat-link">
        <span class="chat-dot" aria-hidden="true"></span> SmansaBot AI
      </a>
    </div>
  </div>
</header>

<script>
  document.addEventListener('astro:page-load', () => {
    const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
    const nav = document.getElementById('main-nav');
    if (toggle && nav) {
      const setOpen = (open: boolean) => {
        toggle.classList.toggle('is-open', open);
        nav.classList.toggle('is-open', open);
        toggle.setAttribute('aria-expanded', String(open));
        toggle.setAttribute('aria-label', open ? 'Tutup menu navigasi' : 'Buka menu navigasi');
      };
      toggle.onclick = () => setOpen(!toggle.classList.contains('is-open'));
      nav.querySelectorAll('a').forEach((a) => (a as HTMLElement).onclick = () => setOpen(false));
    }
  });
</script>

<style>
  .site-header {
    height: 64px;
    display: flex;
    align-items: center;
    position: sticky;
    top: 0;
    z-index: 40;
    background-color: var(--neo-surface);
    border-bottom: var(--neo-border);
    box-shadow: 0 2px 0px rgba(17, 20, 24, 0.08);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .brand-link {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .brand-logo-frame {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    background: #FFFFFF;
    border: var(--neo-border);
    box-shadow: 2px 2px 0px var(--neo-ink);
    border-radius: var(--r-sm);
  }

  .brand-logo-img {
    width: 28px;
    height: 28px;
    object-fit: contain;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }

  .school-name {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    color: var(--neo-ink);
  }

  .school-alias {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 700;
    color: var(--neo-ink-2);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .nav-list {
    display: flex;
    list-style: none;
    align-items: center;
    gap: 8px;
  }

  .nav-item {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--neo-ink);
    padding: 6px 12px;
    border: 1.5px solid transparent;
    border-radius: var(--r-sm);
    transition: background-color 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .nav-item:hover {
    background-color: var(--neon-cyan);
    border-color: var(--neo-ink);
    box-shadow: 2px 2px 0px var(--neo-ink);
  }

  .nav-item.active {
    background-color: var(--neon-lime);
    color: var(--neo-ink);
    border-color: var(--neo-ink);
    box-shadow: 2px 2px 0px var(--neo-ink);
  }

  .nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 42px;
    height: 42px;
    padding: 0 8px;
    border: var(--neo-border);
    border-radius: var(--r-sm);
    background: var(--neon-lime);
    box-shadow: 2px 2px 0px var(--neo-ink);
  }

  .nav-toggle-bar {
    display: block;
    height: 2.5px;
    width: 100%;
    background: var(--neo-ink);
    border-radius: 1px;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .btn-chat-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 800;
    text-transform: uppercase;
    color: var(--neo-ink);
    background-color: var(--neon-lime);
    border: var(--neo-border);
    padding: 8px 14px;
    border-radius: var(--r-sm);
    box-shadow: var(--neo-shadow-sm);
    transition: transform 0.1s ease, box-shadow 0.1s ease, background-color 0.15s ease;
  }

  .btn-chat-link:hover {
    background-color: var(--neon-cyan);
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0px var(--neo-ink);
  }

  .btn-chat-link:active {
    transform: translate(1px, 1px);
    box-shadow: 1px 1px 0px var(--neo-ink);
  }

  .chat-dot {
    width: 8px;
    height: 8px;
    background-color: var(--neon-magenta);
    border: 1px solid var(--neo-ink);
    border-radius: 50%;
  }

  @media (max-width: 900px) {
    .nav-toggle {
      display: flex;
    }

    .main-nav {
      position: absolute;
      top: 64px;
      left: 0;
      right: 0;
      background: var(--neo-surface);
      border-bottom: var(--neo-border);
      box-shadow: var(--neo-shadow);
    }

    .nav-list {
      display: none;
      flex-direction: column;
      gap: 8px;
      padding: 16px 24px;
    }

    .nav-list.is-open {
      display: flex;
    }

    .nav-item {
      display: block;
      width: 100%;
      padding: 10px 14px;
    }
  }
</style>
