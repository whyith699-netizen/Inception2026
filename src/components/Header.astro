---
const pathname = new URL(Astro.request.url).pathname;
const currentPath = pathname.replace(/\/$/, "");

const navLinks = [
  { href: "/", label: "Beranda" },
  { href: "/profil", label: "Profil & Sejarah" },
  { href: "/program", label: "Akademik & Ekskul" },
  { href: "/fasilitas", label: "Fasilitas" },
  { href: "/prestasi", label: "Prestasi & Alumni" },
  { href: "/ppdb", label: "PPDB 2026" },
  { href: "/kontak", label: "Kontak" }
];
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand-link" aria-label="Beranda SMAN 1 Klaten">
      <img src="/images/school/logo.png" alt="Logo SMAN 1 Klaten" class="brand-logo-img" width="34" height="34" />
      <div class="brand-text">
        <span class="school-name">SMAN 1 KLATEN</span>
        <span class="school-alias">PADMAWIJAYA • KAMPUS 13</span>
      </div>
    </a>

    <nav class="main-nav" aria-label="Navigasi Utama">
      <ul class="nav-list">
        {navLinks.map((link) => {
          const isActive = currentPath === link.href.replace(/\/$/, "");
          return (
            <li>
              <a href={link.href} class={`nav-item ${isActive ? 'active' : ''}`}>
                {link.label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

    <div class="header-action">
      <a href="/#chatbot" class="btn-chat-link" id="header-chatbot-btn">
        <span class="chat-dot"></span> SmansaBot AI
      </a>
    </div>
  </div>
</header>

<style>
  .site-header {
    background-color: rgba(250, 248, 245, 0.92);
    height: 68px;
    display: flex;
    align-items: center;
    position: sticky;
    top: 0;
    z-index: 100;
    border-bottom: 1px solid var(--color-border);
    backdrop-filter: blur(12px);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .brand-link {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
  }

  .brand-logo-img {
    width: 34px;
    height: 34px;
    object-fit: contain;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }

  .school-name {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--color-text-primary);
  }

  .school-alias {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 600;
    color: var(--color-text-muted);
    letter-spacing: 0.08em;
  }

  .nav-list {
    display: flex;
    list-style: none;
    gap: 24px;
  }

  .nav-item {
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    transition: color 0.15s ease;
    padding: 6px 0;
    position: relative;
    text-decoration: none;
  }

  .nav-item:hover, .nav-item.active {
    color: var(--color-text-primary);
    font-weight: 600;
  }

  .nav-item.active::after {
    content: '';
    position: absolute;
    bottom: -1px;
    left: 0;
    width: 100%;
    height: 2px;
    background-color: var(--color-accent-coral);
    border-radius: 2px;
  }

  .btn-chat-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-text-primary);
    border: 1px solid var(--color-border);
    background-color: var(--color-surface);
    padding: 7px 16px;
    border-radius: var(--radius-pill);
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .btn-chat-link:hover {
    border-color: var(--color-accent-coral);
    color: var(--color-accent-coral);
    box-shadow: var(--shadow-subtle);
  }

  .chat-dot {
    width: 6px;
    height: 6px;
    background-color: var(--color-accent-green);
    border-radius: 50%;
  }

  @media (max-width: 980px) {
    .nav-list {
      display: none;
    }
  }
</style>
