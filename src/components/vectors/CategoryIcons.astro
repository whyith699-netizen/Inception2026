---
interface Props {
  icon: 'science' | 'social' | 'language' | 'sports';
  class?: string;
}

const { icon, class: className = '' } = Astro.props;
---

<svg class={`category-svg-icon ${className}`} viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
  {icon === 'science' && (
    <g>
      <circle cx="24" cy="24" r="22" fill="#E6F3EA"/>
      <path d="M20 14V22L13 32C11.5 34 13 37 15.5 37H32.5C35 37 36.5 34 35 32L28 22V14" stroke="#3BA85C" stroke-width="2.5" stroke-linecap="round"/>
      <line x1="18" y1="14" x2="30" y2="14" stroke="#3BA85C" stroke-width="2.5" stroke-linecap="round"/>
      <path d="M16 32C20 30 28 34 32 32" stroke="#3BA85C" stroke-width="2"/>
    </g>
  )}
  {icon === 'social' && (
    <g>
      <circle cx="24" cy="24" r="22" fill="#FDF3D6"/>
      <path d="M24 12V36M14 20L24 16L34 20M14 20L10 28H18L14 20ZM34 20L30 28H38L34 20Z" stroke="#F9BC2C" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
      <line x1="18" y1="36" x2="30" y2="36" stroke="#221610" stroke-width="2.5" stroke-linecap="round"/>
    </g>
  )}
  {icon === 'language' && (
    <g>
      <circle cx="24" cy="24" r="22" fill="#E6EEF6"/>
      <circle cx="24" cy="24" r="14" stroke="#3B88C8" stroke-width="2.5"/>
      <ellipse cx="24" cy="24" rx="6" ry="14" stroke="#3B88C8" stroke-width="2"/>
      <line x1="10" y1="24" x2="38" y2="24" stroke="#3B88C8" stroke-width="2"/>
    </g>
  )}
  {icon === 'sports' && (
    <g>
      <circle cx="24" cy="24" r="22" fill="#FCECE8"/>
      <path d="M16 16H32V24C32 28.4 28.4 32 24 32C19.6 32 16 28.4 16 24V16Z" stroke="#E85A38" stroke-width="2.5"/>
      <path d="M16 20H12C10.9 20 10 20.9 10 22C10 24.5 12 26 16 26" stroke="#E85A38" stroke-width="2"/>
      <path d="M32 20H36C37.1 20 38 20.9 38 22C38 24.5 36 26 32 26" stroke="#E85A38" stroke-width="2"/>
      <path d="M24 32V38M18 38H30" stroke="#221610" stroke-width="2.5" stroke-linecap="round"/>
    </g>
  )}
</svg>
