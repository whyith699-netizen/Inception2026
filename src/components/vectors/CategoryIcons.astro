---
interface Props {
  icon: 'science' | 'social' | 'language' | 'sports';
  class?: string;
}

const { icon, class: className = '' } = Astro.props;
---

<svg
  class={`category-svg-icon ${className}`}
  viewBox="0 0 48 48"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  {icon === 'science' && (
    <g stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M20 15V23L13 33C11.5 35 13 38 15.5 38H32.5C35 38 36.5 35 35 33L28 23V15" />
      <path d="M18 15H30" />
      <path d="M16 33C20 31 28 35 32 33" />
    </g>
  )}
  {icon === 'social' && (
    <g stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M24 13V37" />
      <path d="M14 21L24 17L34 21" />
      <path d="M14 21L10 29H18L14 21Z" />
      <path d="M34 21L30 29H38L34 21Z" />
      <path d="M18 37H30" />
    </g>
  )}
  {icon === 'language' && (
    <g stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="24" cy="24" r="15" />
      <path d="M9 24H39" />
      <ellipse cx="24" cy="24" rx="6.5" ry="15" />
    </g>
  )}
  {icon === 'sports' && (
    <g stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M16 17H32V25C32 29.4 28.4 33 24 33C19.6 33 16 29.4 16 25V17Z" />
      <path d="M16 21H12C10.9 21 10 21.9 10 23C10 25.5 12 27 16 27" />
      <path d="M32 21H36C37.1 21 38 21.9 38 23C38 25.5 36 27 32 27" />
      <path d="M24 33V39M18 39H30" />
    </g>
  )}
</svg>
