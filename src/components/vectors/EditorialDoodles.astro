---
interface Props {
  type: 'sketch-circle' | 'hot-air-balloon' | 'curved-arrow' | 'starburst' | 'paper-plane';
  class?: string;
}

const { type, class: className = '' } = Astro.props;
---

{type === 'sketch-circle' && (
  <svg class={`doodle-sketch ${className}`} viewBox="0 0 280 90" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M10 45C8 20 60 8 140 7C220 6 270 22 268 46C266 70 210 82 135 83C60 84 12 70 15 48C18 26 80 14 150 15" stroke="var(--color-accent-coral)" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
)}

{type === 'hot-air-balloon' && (
  <svg class={`doodle-balloon ${className}`} viewBox="0 0 70 95" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M35 5C16 5 0 21 0 40C0 56 18 70 30 75V80H40V75C52 70 70 56 70 40C70 21 54 5 35 5Z" fill="#F9BC2C" stroke="#221610" stroke-width="3"/>
    <path d="M35 5C26 15 20 28 20 40C20 54 27 69 35 75C43 69 50 54 50 40C50 28 44 15 35 5Z" fill="#E85A38" stroke="#221610" stroke-width="2"/>
    <rect x="28" y="86" width="14" height="9" rx="2" fill="#221610"/>
    <line x1="28" y1="80" x2="28" y2="86" stroke="#221610" stroke-width="2"/>
    <line x1="42" y1="80" x2="42" y2="86" stroke="#221610" stroke-width="2"/>
  </svg>
)}

{type === 'paper-plane' && (
  <svg class={`doodle-plane ${className}`} viewBox="0 0 60 50" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M55 5L5 25L25 32L55 5Z" fill="#FCE8E2" stroke="#E85A38" stroke-width="3" stroke-linejoin="round"/>
    <path d="M55 5L36 45L25 32L55 5Z" fill="#E85A38" stroke="#221610" stroke-width="3" stroke-linejoin="round"/>
    <path d="M5 25C-5 40 15 48 25 32" stroke="#E85A38" stroke-width="2" stroke-dasharray="3 3"/>
  </svg>
)}

{type === 'curved-arrow' && (
  <svg class={`doodle-arrow ${className}`} viewBox="0 0 60 40" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M5 30C20 35 40 30 50 10" stroke="#221610" stroke-width="3" stroke-linecap="round"/>
    <path d="M38 8L52 9L50 23" stroke="#221610" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
)}

{type === 'starburst' && (
  <svg class={`doodle-star ${className}`} viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M16 0L19.5 12.5L32 16L19.5 19.5L16 32L12.5 19.5L0 16L12.5 12.5L16 0Z" fill="var(--color-accent-yellow)"/>
  </svg>
)}
