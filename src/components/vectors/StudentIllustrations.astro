---
interface Props {
  variant: 'science' | 'culture' | 'reading' | 'sports';
  class?: string;
}

const { variant, class: className = '' } = Astro.props;
---

{variant === 'science' && (
  <svg class={`vector-illustration ${className}`} viewBox="0 0 360 320" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="Ilustrasi Siswa Riset Sains">
    <!-- Organic Background Blob -->
    <path d="M40 80C20 140 10 210 60 260C110 310 220 320 280 270C340 220 360 140 320 70C280 0 200 -20 120 15C70 35 50 50 40 80Z" fill="#CBE5D3"/>
    <!-- Student Silhouette & Science Gear -->
    <circle cx="180" cy="110" r="48" fill="#221610"/>
    <path d="M150 115C150 115 165 145 180 145C195 145 210 115 210 115" stroke="#FFFFFF" stroke-width="4" stroke-linecap="round"/>
    <path d="M110 270C110 200 140 180 180 180C220 180 250 200 250 270" fill="#E85A38"/>
    <!-- Lab Flask & Orbit -->
    <g transform="translate(220, 160)">
      <path d="M25 50L10 80C6 88 12 98 22 98H58C68 98 74 88 70 80L55 50V25H60C63 25 65 23 65 20C65 17 63 15 60 15H20C17 15 15 17 15 20C15 23 17 25 20 25H25V50Z" fill="#FFFFFF" stroke="#221610" stroke-width="4"/>
      <path d="M20 75C28 72 38 82 50 78C56 76 60 77 62 78L68 88C66 91 63 93 58 93H22C17 93 14 91 12 88L20 75Z" fill="#3BA85C"/>
      <circle cx="35" cy="55" r="4" fill="#3BA85C"/>
      <circle cx="48" cy="42" r="3" fill="#3BA85C"/>
    </g>
    <!-- Geometric Science Accents -->
    <ellipse cx="90" cy="80" rx="35" ry="12" transform="rotate(-30 90 80)" stroke="#3BA85C" stroke-width="3" stroke-dasharray="4 4"/>
    <ellipse cx="90" cy="80" rx="35" ry="12" transform="rotate(30 90 80)" stroke="#3B88C8" stroke-width="3"/>
    <circle cx="90" cy="80" r="6" fill="#F9BC2C"/>
  </svg>
)}

{variant === 'culture' && (
  <svg class={`vector-illustration ${className}`} viewBox="0 0 360 320" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="Ilustrasi Siswa Seni & Budaya">
    <!-- Arch Frame Background -->
    <path d="M50 310V140C50 62.68 112.68 0 190 0C267.32 0 330 62.68 330 140V310H50Z" fill="#F8E7BE"/>
    <!-- Student Figure with Book/Instrument -->
    <circle cx="190" cy="115" r="48" fill="#221610"/>
    <path d="M120 280C120 210 150 185 190 185C230 185 260 210 260 280" fill="#3B88C8"/>
    <!-- Gamelan / Traditional Instrument Motif -->
    <g transform="translate(60, 200)">
      <rect x="10" y="20" width="80" height="24" rx="12" fill="#E85A38" stroke="#221610" stroke-width="4"/>
      <circle cx="30" cy="32" r="6" fill="#F9BC2C"/>
      <circle cx="50" cy="32" r="6" fill="#F9BC2C"/>
      <circle cx="70" cy="32" r="6" fill="#F9BC2C"/>
      <path d="M25 44V70M75 44V70" stroke="#221610" stroke-width="4" stroke-linecap="round"/>
    </g>
    <!-- Cultural Floral Flourish -->
    <path d="M280 80C295 70 315 80 310 100C305 120 285 110 280 80Z" fill="#E85A38"/>
    <path d="M280 80C265 70 245 80 250 100C255 120 275 110 280 80Z" fill="#F9BC2C"/>
  </svg>
)}
