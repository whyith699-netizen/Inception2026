---
import { getEntry } from 'astro:content';

const ekstraData = await getEntry('ekstrakurikuler', 'daftar');
const list = ekstraData?.data?.items || [];

const categories = ["Semua", "Kepemimpinan & Organisasi", "Sains & Riset", "Seni & Budaya", "Olahraga", "Kerohanian"];
---

<section class="ekskul-gallery-section" id="ekstrakurikuler-resmi">
  <div class="container">
    <div class="section-header text-center">
      <span class="section-badge">Pengembangan Karakter & Bakat</span>
      <h2 class="section-title">23 Ekstrakurikuler Resmi SMAN 1 Klaten</h2>
      <p class="section-desc">
        Wadah pembinaan kepemimpinan, penalaran ilmiah, kreasi seni, ketangkasan raga, dan keteguhan rohani civitas akademika Padmawijaya.
      </p>

      <!-- Minimal Filter Buttons -->
      <div class="filter-group" id="ekskul-filters">
        {categories.map((cat, idx) => (
          <button 
            type="button" 
            class={`filter-btn ${idx === 0 ? 'active' : ''}`} 
            data-filter={cat === 'Semua' ? 'all' : cat}
          >
            {cat}
          </button>
        ))}
      </div>
    </div>

    <div class="ekskul-grid" id="ekskul-items-container">
      {list.map((item) => (
        <div class="ekskul-card" data-category={item.category}>
          <div class="card-top">
            <div class="ekskul-logo-box">
              <img 
                src={item.logo} 
                alt={`Logo ${item.name}`} 
                class="ekskul-logo-img" 
                loading="lazy" 
                width="64" 
                height="64" 
              />
            </div>
            <span class="ekskul-badge">{item.category}</span>
          </div>
          <div class="ekskul-content">
            <h3 class="ekskul-name">{item.name}</h3>
            <p class="ekskul-desc">{item.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const cards = document.querySelectorAll<HTMLElement>('.ekskul-card');

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterBtns.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');

      const filter = btn.getAttribute('data-filter');
      cards.forEach((card) => {
        const cat = card.getAttribute('data-category');
        if (filter === 'all' || cat === filter) {
          card.style.display = 'flex';
        } else {
          card.style.display = 'none';
        }
      });
    });
  });
</script>

<style>
  .ekskul-gallery-section {
    padding: 70px 0 90px;
    background-color: var(--color-bg);
  }

  .text-center { text-align: center; }

  .section-header {
    max-width: 780px;
    margin: 0 auto 44px;
  }

  .section-badge {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--color-accent-coral);
    letter-spacing: 0.08em;
    margin-bottom: 10px;
  }

  .section-title {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 3.8vw, 2.7rem);
    color: var(--color-text-primary);
    margin-bottom: 12px;
  }

  .section-desc {
    font-size: 1.02rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-bottom: 28px;
  }

  /* Minimal Filter Tabs */
  .filter-group {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 8px;
  }

  .filter-btn {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    color: var(--color-text-secondary);
    font-size: 0.82rem;
    font-weight: 600;
    padding: 7px 16px;
    border-radius: var(--radius-pill);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .filter-btn:hover {
    border-color: var(--color-accent-coral);
    color: var(--color-accent-coral);
  }

  .filter-btn.active {
    background-color: var(--color-text-primary);
    color: var(--color-bg);
    border-color: var(--color-text-primary);
  }

  /* Grid Layout */
  .ekskul-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(270px, 1fr));
    gap: 24px;
  }

  .ekskul-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 22px;
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-subtle);
    transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
  }

  .ekskul-card:hover {
    transform: translateY(-3px);
    border-color: var(--color-accent-coral);
    box-shadow: var(--shadow-card);
  }

  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 14px;
  }

  .ekskul-logo-box {
    width: 64px;
    height: 64px;
    background-color: var(--color-surface-muted);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 6px;
  }

  .ekskul-logo-img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  .ekskul-badge {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--color-accent-coral);
    background-color: var(--color-surface-muted);
    padding: 4px 10px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-border);
  }

  .ekskul-name {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin-bottom: 6px;
  }

  .ekskul-desc {
    font-size: 0.86rem;
    color: var(--color-text-secondary);
    line-height: 1.5;
  }
</style>
