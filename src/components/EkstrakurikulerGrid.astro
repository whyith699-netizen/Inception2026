---
import { getEntry } from 'astro:content';

const ekstraData = await getEntry('ekstrakurikuler', 'daftar');
const list = ekstraData?.data?.items || [];

const categories = [
  "Semua",
  "Kepemimpinan & Organisasi",
  "Sains & Riset",
  "Seni & Budaya",
  "Olahraga",
  "Kerohanian"
];
---

<section class="ekskul-gallery-section sec" id="ekstrakurikuler-resmi">
  <div class="container">
    <div class="section-header">
      <p class="lbl">Pengembangan karakter dan bakat</p>
      <h2 class="section-title">23 ekstrakurikuler resmi</h2>
      <p class="section-desc">
        Wadah pembinaan kepemimpinan, penalaran ilmiah, kreasi seni,
        ketangkasan raga, dan keteguhan rohani civitas akademika Padmawijaya.
      </p>

      <div class="filter-group" id="ekskul-filters">
        {categories.map((cat, idx) => (
          <button
            type="button"
            class:list={["filter-btn", { active: idx === 0 }]}
            data-filter={cat === 'Semua' ? 'all' : cat}
          >
            {cat}
          </button>
        ))}
      </div>
    </div>

    <div class="ekskul-grid" id="ekskul-items-container">
      {list.map((item) => (
        <article class="ekskul-card" data-category={item.category} data-reveal>
          <div class="ekskul-logo-box">
            <img
              src={item.logo}
              alt={`Logo ${item.name}`}
              class="ekskul-logo-img"
              loading="lazy"
              width="64"
              height="64"
            />
          </div>
          <h3 class="ekskul-name">{item.name}</h3>
          <p class="ekskul-cat">{item.category}</p>
          <p class="ekskul-desc">{item.desc}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const cards = document.querySelectorAll<HTMLElement>('.ekskul-card');

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterBtns.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');

      const filter = btn.getAttribute('data-filter');
      cards.forEach((card) => {
        const cat = card.getAttribute('data-category');
        card.style.display = filter === 'all' || cat === filter ? 'flex' : 'none';
      });
    });
  });
</script>

<style>
  .ekskul-gallery-section {
    padding-top: clamp(56px, 8vw, 88px);
    padding-bottom: clamp(56px, 8vw, 88px);
    border-top: 1px solid var(--hairline);
  }

  .section-header {
    max-width: 620px;
    margin-bottom: clamp(28px, 4vw, 44px);
  }

  .section-title {
    font-size: clamp(1.75rem, 3.2vw, 2.4rem);
    font-weight: 500;
    margin-bottom: 14px;
  }

  .section-desc {
    font-size: 1rem;
    color: var(--ink-2);
    line-height: 1.65;
    margin-bottom: 24px;
  }

  .filter-group {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .filter-btn {
    background: var(--paper);
    border: 1px solid var(--hairline-2);
    color: var(--ink-2);
    font-size: 0.8125rem;
    font-weight: 500;
    padding: 5px 12px;
    border-radius: var(--r-sm);
    cursor: pointer;
    transition: color 0.18s ease, border-color 0.18s ease, background 0.18s ease;
  }

  .filter-btn:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .filter-btn.active {
    color: #FFFFFF;
    background: var(--accent);
    border-color: var(--accent);
  }

  .ekskul-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--hairline);
    border: 1px solid var(--hairline);
    border-radius: var(--r-md);
    overflow: hidden;
  }

  .ekskul-card {
    background: var(--surface);
    padding: 22px;
    display: flex;
    flex-direction: column;
    transition: background 0.2s ease;
  }

  .ekskul-card:hover {
    background: var(--paper-2);
  }

  .ekskul-logo-box {
    width: 48px;
    height: 48px;
    margin-bottom: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ekskul-logo-img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  .ekskul-name {
    font-size: 1.0625rem;
    font-weight: 500;
    margin-bottom: 2px;
  }

  .ekskul-cat {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 10px;
  }

  .ekskul-desc {
    font-size: 0.875rem;
    color: var(--ink-2);
    line-height: 1.6;
  }

  @media (max-width: 1024px) {
    .ekskul-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 760px) {
    .ekskul-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 460px) {
    .ekskul-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
