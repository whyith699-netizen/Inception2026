---
import { getEntry } from 'astro:content';

const alumniData = await getEntry('alumni', 'tokoh');
const list = alumniData?.data?.items || [];
---

<section class="alumni-section" id="alumni-menyapa">
  <div class="container">
    <div class="section-header text-center">
      <div class="kapasska-pill">
        <span class="pill-dot"></span> KAPASSKA (Keluarga Alumni Padmawijaya)
      </div>
      <h2 class="section-title">Inspirasi Para Tokoh Bangsa Alumnus SMANSA</h2>
      <p class="section-desc">
        Dari pimpinan perguruan tinggi terbaik Indonesia (UGM, Undip, UNS, ITB), perbankan nasional, kedokteran saraf, hingga korps diplomatik dunia.
      </p>
    </div>

    <div class="alumni-grid">
      {list.map((alumnus) => (
        <div class="alumni-card">
          <div class="alumni-avatar-wrap">
            <img 
              src={alumnus.image} 
              alt={`Foto ${alumnus.name}`} 
              class="alumni-img" 
              loading="lazy" 
              width="88" 
              height="88" 
            />
          </div>
          <div class="alumni-info">
            <h3 class="alumni-name">{alumnus.name}</h3>
            <p class="alumni-role">{alumnus.designation}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .alumni-section {
    padding: 70px 0 90px;
    background-color: var(--color-surface);
    border-top: 1px solid var(--color-border);
  }

  .text-center { text-align: center; }

  .section-header {
    max-width: 740px;
    margin: 0 auto 48px;
  }

  .kapasska-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background-color: var(--color-surface-muted);
    border: 1px solid var(--color-border);
    padding: 6px 16px;
    border-radius: var(--radius-pill);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--color-accent-coral);
    margin-bottom: 14px;
    letter-spacing: 0.05em;
  }

  .pill-dot {
    width: 6px;
    height: 6px;
    background-color: var(--color-accent-coral);
    border-radius: 50%;
  }

  .section-title {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 3.8vw, 2.7rem);
    color: var(--color-text-primary);
    margin-bottom: 12px;
  }

  .section-desc {
    font-size: 1.02rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .alumni-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .alumni-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    box-shadow: var(--shadow-subtle);
    transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
  }

  .alumni-card:hover {
    transform: translateY(-3px);
    border-color: var(--color-accent-coral);
    box-shadow: var(--shadow-card);
  }

  .alumni-avatar-wrap {
    width: 88px;
    height: 88px;
    border-radius: 50%;
    overflow: hidden;
    margin-bottom: 16px;
    border: 2px solid var(--color-border);
    background-color: var(--color-dark-ribbon);
  }

  .alumni-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .alumni-name {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin-bottom: 6px;
    line-height: 1.3;
  }

  .alumni-role {
    font-size: 0.84rem;
    color: var(--color-text-secondary);
    line-height: 1.5;
  }

  @media (max-width: 900px) {
    .alumni-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 580px) {
    .alumni-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
