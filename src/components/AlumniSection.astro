---
import { getEntry } from 'astro:content';

const alumniData = await getEntry('alumni', 'tokoh');
const list = alumniData?.data?.items || [];
---

<section class="alumni-section" id="alumni-menyapa">
  <div class="container">
    <div class="section-header text-center">
      <span class="section-badge">Jejaring Lulusan & Pengabdian</span>
      <h2 class="section-title">Alumni Menyapa: Inspirasi Para Tokoh Bangsa</h2>
      <p class="section-desc">
        Mengenal kiprah dan kontribusi nyata para alumnus SMA Negeri 1 Klaten di kancah pemerintahan, akademisi perguruan tinggi, diplomasi internasional, dan wirausaha.
      </p>
    </div>

    <div class="alumni-grid">
      {list.map((alumnus) => (
        <div class="alumni-card">
          <div class="alumni-avatar-box">
            <img 
              src={alumnus.image} 
              alt={`Foto ${alumnus.name}`} 
              class="alumni-img" 
              loading="lazy" 
              width="110" 
              height="110" 
            />
          </div>
          <div class="alumni-info">
            <h3 class="alumni-name">{alumnus.name}</h3>
            <p class="alumni-role">{alumnus.designation}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .alumni-section {
    padding: 70px 0 90px;
    background-color: var(--color-surface-muted);
    border-top: 1px solid var(--color-border);
  }

  .text-center {
    text-align: center;
  }

  .section-header {
    max-width: 720px;
    margin: 0 auto 48px;
  }

  .section-badge {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--color-accent-coral);
    letter-spacing: 0.08em;
    margin-bottom: 12px;
  }

  .section-title {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 3.8vw, 2.8rem);
    letter-spacing: -0.02em;
    color: var(--color-text-primary);
    margin-bottom: 14px;
  }

  .section-desc {
    font-size: 1.05rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .alumni-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
  }

  .alumni-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: 28px 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    box-shadow: 0 4px 16px rgba(34, 22, 16, 0.04);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s ease;
  }

  .alumni-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 12px 28px rgba(34, 22, 16, 0.08);
    border-color: rgba(232, 90, 56, 0.3);
  }

  .alumni-avatar-box {
    width: 100px;
    height: 100px;
    border-radius: 50%;
    overflow: hidden;
    margin-bottom: 18px;
    border: 3px solid var(--color-accent-coral);
    box-shadow: 0 6px 16px rgba(34, 22, 16, 0.1);
    background-color: #221610;
  }

  .alumni-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .alumni-name {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin-bottom: 8px;
    line-height: 1.3;
  }

  .alumni-role {
    font-size: 0.85rem;
    color: var(--color-text-secondary);
    line-height: 1.5;
  }

  @media (max-width: 900px) {
    .alumni-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .alumni-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
