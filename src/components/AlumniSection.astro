---
import { getEntry } from 'astro:content';

const alumniData = await getEntry('alumni', 'tokoh');
const list = alumniData?.data?.items || [];
---

<section class="alumni-section sec" id="alumni-menyapa">
  <div class="container">
    <div class="section-header">
      <p class="lbl">KAPASSKA &middot; Keluarga Alumni Padmawijaya</p>
      <h2 class="section-title">Alumni yang berkarya di tingkat nasional</h2>
      <p class="section-desc">
        Lulusan SMAN 1 Klaten yang memimpin perguruan tinggi, lembaga negara,
        perbankan nasional, kedokteran saraf, hingga korps diplomatik Indonesia.
      </p>
    </div>

    <div class="alumni-grid">
      {list.map((alumnus) => (
        <article class="alumni-card" data-reveal>
          <div class="alumni-avatar-wrap">
            <img
              src={alumnus.image}
              alt={`Potret ${alumnus.name}`}
              class="alumni-img"
              loading="lazy"
              width="96"
              height="96"
            />
          </div>
          <div class="alumni-info">
            <h3 class="alumni-name">{alumnus.name}</h3>
            <p class="alumni-role">{alumnus.designation}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .alumni-section {
    padding-top: clamp(56px, 8vw, 88px);
    padding-bottom: clamp(56px, 8vw, 88px);
    border-top: 1px solid var(--hairline);
  }

  .section-header {
    max-width: 600px;
    margin-bottom: clamp(28px, 4vw, 44px);
  }

  .section-title {
    font-size: clamp(1.75rem, 3.2vw, 2.4rem);
    font-weight: 500;
    margin-bottom: 14px;
  }

  .section-desc {
    font-size: 1rem;
    color: var(--ink-2);
    line-height: 1.65;
  }

  .alumni-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--hairline);
    border: 1px solid var(--hairline);
    border-radius: var(--r-md);
    overflow: hidden;
  }

  .alumni-card {
    background: var(--surface);
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    transition: background 0.2s ease;
  }

  .alumni-card:hover {
    background: var(--paper-2);
  }

  .alumni-avatar-wrap {
    width: 72px;
    height: 72px;
    border-radius: var(--r-sm);
    overflow: hidden;
    background: var(--paper-2);
  }

  .alumni-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .alumni-name {
    font-size: 1.0625rem;
    font-weight: 500;
    margin-bottom: 6px;
    line-height: 1.35;
  }

  .alumni-role {
    font-size: 0.875rem;
    color: var(--ink-2);
    line-height: 1.55;
  }

  @media (max-width: 900px) {
    .alumni-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .alumni-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
