---
import CategoryIcons from './vectors/CategoryIcons.astro';

const categories = [
  {
    title: "Olimpiade dan riset sains",
    level: "Tim OSN dan KIR",
    icon: "science" as const,
    desc: "Pembinaan laboratorium analitis, kelas riset kelompok, dan pendampingan kompetisi sains nasional."
  },
  {
    title: "Geopolitik dan nalar kritis",
    level: "Klub debat dan riset sosial",
    icon: "social" as const,
    desc: "Kajian fenomena kemasyarakatan, literasi hukum tata negara, dan praktik berpikir solutif."
  },
  {
    title: "Diplomasi dan bahasa global",
    level: "Model UN dan English Club",
    icon: "language" as const,
    desc: "Latihan public speaking dwibahasa, retorika logis, dan wawasan hubungan internasional."
  },
  {
    title: "Sportivitas dan kepemimpinan",
    level: "Basket, futsal, dan pramuka",
    icon: "sports" as const,
    desc: "Pembinaan ketahanan fisik, kepemimpinan organisasi OSMANSA, dan integritas korps."
  }
];
---

<section class="curriculum-section sec" id="kurikulum">
  <div class="container">
    <div class="curriculum-intro">
      <p class="lbl">Pilar pengembangan siswa</p>
      <h2 class="section-title">Empat bidang pengembangan yang berjalan berdampingan</h2>
    </div>

    <div class="categories-grid">
      {categories.map((cat) => (
        <article class="category-card" data-reveal>
          <span class="category-icon-wrapper">
            <CategoryIcons icon={cat.icon} class="category-svg" />
          </span>
          <h3 class="category-title">{cat.title}</h3>
          <span class="category-level">{cat.level}</span>
          <p class="category-desc">{cat.desc}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .curriculum-section {
    padding-top: clamp(56px, 8vw, 88px);
    padding-bottom: clamp(56px, 8vw, 88px);
    border-top: 1px solid var(--hairline);
  }

  .curriculum-intro {
    max-width: 640px;
    margin-bottom: clamp(28px, 4vw, 44px);
  }

  .section-title {
    font-size: clamp(1.75rem, 3.2vw, 2.4rem);
    font-weight: 500;
    max-width: 26ch;
  }

  .categories-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--hairline);
    border: 1px solid var(--hairline);
    border-radius: var(--r-md);
    overflow: hidden;
  }

  .category-card {
    background: var(--surface);
    padding: 26px 22px 28px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    transition: background 0.2s ease;
  }

  .category-card:hover {
    background: var(--paper-2);
  }

  .category-icon-wrapper {
    width: 28px;
    height: 28px;
    margin-bottom: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .category-svg {
    width: 100%;
    height: 100%;
  }

  .category-title {
    font-size: 1.125rem;
    font-weight: 500;
    margin-bottom: 4px;
    line-height: 1.3;
  }

  .category-level {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 10px;
  }

  .category-desc {
    font-size: 0.875rem;
    color: var(--ink-2);
    line-height: 1.55;
  }

  @media (max-width: 960px) {
    .categories-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 540px) {
    .categories-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
