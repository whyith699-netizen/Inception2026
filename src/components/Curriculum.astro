---
import CategoryIcons from './vectors/CategoryIcons.astro';

const categories = [
  { 
    title: "Olimpiade & Riset Sains", 
    level: "Tim OSN & Karya Ilmiah Remaja", 
    icon: "science" as const,
    desc: "Laboratorium terpadu & pendampingan riset kompetitif tingkat nasional." 
  },
  { 
    title: "Geopolitik & Nalar Kritis", 
    level: "Klub Debat & Riset Sosial", 
    icon: "social" as const,
    desc: "Kajian fenomena kemasyarakatan, simulasi parlemen, dan hukum tata negara." 
  },
  { 
    title: "Diplomasi & Bahasa Global", 
    level: "Model UN & English Club", 
    icon: "language" as const,
    desc: "Kecakapan public speaking dwibahasa & wawasan hubungan internasional." 
  },
  { 
    title: "Sportivitas & Kepemimpinan", 
    level: "DBL Basket & Garda Paskibra", 
    icon: "sports" as const,
    desc: "Pembentukan ketahanan fisik, sportivitas tim, dan kedisiplinan korps." 
  }
];
---

<section class="curriculum-section" id="kurikulum">
  <div class="container">
    <div class="curriculum-intro">
      <span class="section-tag">Pilar Keunggulan Sekolah</span>
      <h2 class="section-title">Ekosistem Belajar Terbuka Tanpa Sekat Pembatas Potensi</h2>
      <p class="section-desc">
        Empat pilar pengembangan yang dirancang secara berimbang untuk memastikan setiap siswa bertumbuh cerdas secara intelektual, tangguh secara karakter, dan adaptif di panggung dunia.
      </p>
    </div>

    <div class="categories-grid">
      {categories.map((cat) => (
        <div class="category-card">
          <div class="category-icon-wrapper">
            <CategoryIcons icon={cat.icon} class="category-svg" />
          </div>
          <h3 class="category-title">{cat.title}</h3>
          <span class="category-level">{cat.level}</span>
          <p class="category-desc">{cat.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .curriculum-section {
    padding: var(--section-spacing) 0;
    background-color: var(--color-surface-muted);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .curriculum-intro {
    text-align: center;
    max-width: 740px;
    margin: 0 auto 52px;
  }

  .section-tag {
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent-coral);
    margin-bottom: 8px;
    display: block;
  }

  .section-title {
    font-size: clamp(1.85rem, 3.5vw, 2.7rem);
    margin-bottom: 14px;
    line-height: 1.2;
  }

  .section-desc {
    font-size: 0.96rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .categories-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  .category-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: 32px 24px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s ease;
  }

  .category-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 12px 28px rgba(34, 22, 16, 0.07);
  }

  .category-icon-wrapper {
    width: 72px;
    height: 72px;
    margin-bottom: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s ease;
  }

  .category-card:hover .category-icon-wrapper {
    transform: scale(1.08);
  }

  .category-svg {
    width: 100%;
    height: 100%;
  }

  .category-title {
    font-size: 1.2rem;
    margin-bottom: 6px;
    line-height: 1.3;
  }

  .category-level {
    font-size: 0.8rem;
    color: var(--color-accent-coral);
    font-weight: 700;
    margin-bottom: 12px;
    display: block;
  }

  .category-desc {
    font-size: 0.88rem;
    color: var(--color-text-secondary);
    line-height: 1.5;
  }

  @media (max-width: 960px) {
    .categories-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 520px) {
    .categories-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
