---
import CategoryIcons from './vectors/CategoryIcons.astro';

const categories = [
  { 
    title: "Olimpiade & Riset Sains", 
    level: "Tim OSN & Riset Ilmiah (KIR)", 
    icon: "science" as const,
    desc: "Laboratorium analitis terpadu & pendampingan kompetisi sains nasional dan internasional." 
  },
  { 
    title: "Geopolitik & Nalar Kritis", 
    level: "Klub Debat & Riset Sosial", 
    icon: "social" as const,
    desc: "Kajian fenomena kemasyarakatan, literasi hukum tata negara, dan pemikiran solutif." 
  },
  { 
    title: "Diplomasi & Bahasa Global", 
    level: "Model UN & English Club", 
    icon: "language" as const,
    desc: "Kecakapan public speaking dwibahasa, retorika logis, dan wawasan diplomasi global." 
  },
  { 
    title: "Sportivitas & Kepemimpinan", 
    level: "DBL Basket, Futsal & Paskibra", 
    icon: "sports" as const,
    desc: "Pembentukan ketahanan fisik, kepemimpinan organisasi OSMANSA, dan integritas korps." 
  }
];
---

<section class="curriculum-section" id="kurikulum">
  <div class="container">
    <div class="curriculum-intro text-center">
      <span class="section-tag">Pilar Keunggulan Pembelajaran</span>
      <h2 class="section-title">Ekosistem Belajar Seimbang Tanpa Sekat Potensi</h2>
      <p class="section-desc">
        Empat pilar pengembangan yang dirancang secara berimbang untuk memastikan setiap siswa bertumbuh cerdas secara intelektual, tangguh berkarakter, dan beretika lingkungan.
      </p>
    </div>

    <div class="categories-grid">
      {categories.map((cat) => (
        <div class="category-card">
          <div class="category-icon-wrapper">
            <CategoryIcons icon={cat.icon} class="category-svg" />
          </div>
          <h3 class="category-title">{cat.title}</h3>
          <span class="category-level">{cat.level}</span>
          <p class="category-desc">{cat.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .curriculum-section {
    padding: 70px 0 90px;
    background-color: var(--color-surface);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .text-center { text-align: center; }

  .curriculum-intro {
    max-width: 740px;
    margin: 0 auto 48px;
  }

  .section-tag {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent-coral);
    margin-bottom: 8px;
    display: block;
  }

  .section-title {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 3.8vw, 2.7rem);
    color: var(--color-text-primary);
    margin-bottom: 12px;
    line-height: 1.25;
  }

  .section-desc {
    font-size: 1.02rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .categories-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  .category-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 28px 20px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    box-shadow: var(--shadow-subtle);
    transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
  }

  .category-card:hover {
    transform: translateY(-4px);
    border-color: var(--color-accent-coral);
    box-shadow: var(--shadow-card);
  }

  .category-icon-wrapper {
    width: 60px;
    height: 60px;
    margin-bottom: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .category-svg {
    width: 100%;
    height: 100%;
  }

  .category-title {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin-bottom: 4px;
    line-height: 1.3;
  }

  .category-level {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-accent-coral);
    font-weight: 700;
    margin-bottom: 10px;
    display: block;
  }

  .category-desc {
    font-size: 0.86rem;
    color: var(--color-text-secondary);
    line-height: 1.5;
  }

  @media (max-width: 960px) {
    .categories-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 520px) {
    .categories-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
