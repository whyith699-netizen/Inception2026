---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "SMA Negeri 1 Klaten | Berkarakter Hebat Jaya & Berprestasi Global",
  description = "Website Resmi SMA Negeri 1 Klaten (SMANSA). Berdiri sejak 1957. Menyajikan profil kurikulum merdeka, kelas riset, fasilitas unggulan, 23 ekstrakurikuler, informasi PPDB, dan Chatbot AI interaktif."
} = Astro.props;
---

<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#FBF8F2" />
    <link rel="icon" type="image/png" href="/images/school/logo.png" />

    <!-- Google Fonts: Fraunces & Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..800;1,9..144,400..700&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet" />

    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
