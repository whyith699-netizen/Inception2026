---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ValueProp from '../components/ValueProp.astro';
import { Image } from 'astro:assets';
import Smansa1 from '../assets/school/Smansa1.jpg';
import Smansa2 from '../assets/school/Smansa2.jpg';
import Smansa3 from '../assets/school/Smansa3.jpg';
import Smansa4 from '../assets/school/Smansa4.jpg';
import Smansa5 from '../assets/school/Smansa5.jpg';

const campusGallery = [
  {
    image: Smansa1,
    title: "Gerbang dan gedung utama",
    desc: "Arsitektur kampus bersejarah yang menjadi ciri SMAN 1 Klaten sejak 1957."
  },
  {
    image: Smansa2,
    title: "Halaman dalam dan lapangan",
    desc: "Pusat upacara, apel kesiswaan, dan pembinaan olahraga terbuka."
  },
  {
    image: Smansa3,
    title: "Kompleks ruang kelas",
    desc: "Ruang belajar berventilasi silang dengan proyektor digital."
  },
  {
    image: Smansa4,
    title: "Koridor laboratorium",
    desc: "Akses menuju laboratorium fisika, kimia, biologi, dan komputer."
  },
  {
    image: Smansa5,
    title: "Taman kampus dan area diskusi",
    desc: "Ruang terbuka hijau untuk diskusi siswa di sela jam belajar."
  }
];

const facilities = [
  { name: "Laboratorium sains terpadu", desc: "Lab fisika, kimia, dan biologi dengan instrumen analitis untuk praktikum dan riset siswa." },
  { name: "Tiga laboratorium komputer", desc: "Digunakan untuk asesmen digital, praktikum komputasi, dan pembelajaran hibrida." },
  { name: "Perpustakaan Graha Pustaka dan e-Perpus", desc: "Koleksi buku fisik dan akses perpustakaan digital melalui portal e-Perpus." },
  { name: "Gelanggang olahraga dalam ruangan", desc: "Lapangan serbaguna untuk basket, voli, bulutangkis, dan futsal." },
  { name: "Sanggar karawitan dan seni peran", desc: "Ruang latihan gamelan serta pementasan teater dan tari." },
  { name: "Masjid kampus dan sarana ibadah", desc: "Sarana pembinaan rohani yang digunakan seluruh civitas akademika." }
];
---

<BaseLayout
  title="Fasilitas dan Galeri Kampus | SMA Negeri 1 Klaten"
  description="Dokumentasi fasilitas laboratorium, perpustakaan digital e-Perpus, dan sarana olahraga SMA Negeri 1 Klaten di Kampus 13."
>
  <Header />

  <main id="main-content">
    <section class="facility-hero">
      <div class="container">
        <p class="lbl">Sarana dan prasarana</p>
        <h1 class="page-title">Infrastruktur kampus di Jalan Merbabu 13</h1>
        <p class="page-lead">
          Lingkungan belajar asri pada kawasan cagar budaya yang mendukung
          kegiatan akademik, riset, olahraga, dan kesenian siswa.
        </p>
      </div>
    </section>

    <section class="sec">
      <div class="container">
        <h2 class="section-heading">Dokumentasi kampus</h2>
        <div class="campus-gallery-grid">
          {campusGallery.map((item, idx) => (
            <figure class="gallery-card" data-reveal>
              <Image
                src={item.image}
                alt={item.title}
                widths={[480, 720]}
                sizes="(max-width: 700px) 100vw, 380px"
                width={720}
                height={480}
                loading={idx < 2 ? "eager" : "lazy"}
                class="gallery-photo"
              />
              <figcaption class="gallery-body">
                <h3 class="gallery-title">{item.title}</h3>
                <p class="gallery-desc">{item.desc}</p>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <ValueProp />

    <section class="sec">
      <div class="container">
        <h2 class="section-heading">Daftar fasilitas utama</h2>
        <div class="facilities-grid">
          {facilities.map((f) => (
            <article class="facility-item" data-reveal>
              <h3 class="fac-name">{f.name}</h3>
              <p class="fac-desc">{f.desc}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .facility-hero {
    padding: clamp(40px, 6vw, 72px) 0 clamp(32px, 5vw, 48px);
    border-top: 0;
  }

  .page-title {
    font-size: clamp(1.9rem, 3.6vw, 2.8rem);
    font-weight: 500;
    margin-bottom: 18px;
    max-width: 24ch;
  }

  .page-lead {
    font-size: 1.0625rem;
    color: var(--ink-2);
    line-height: 1.7;
    max-width: 60ch;
  }

  .section-heading {
    font-size: clamp(1.4rem, 2.4vw, 1.75rem);
    font-weight: 500;
    margin-bottom: clamp(24px, 3vw, 36px);
  }

  .campus-gallery-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: clamp(12px, 2vw, 20px);
  }

  .gallery-card {
    grid-column: span 2;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .gallery-card:nth-child(1),
  .gallery-card:nth-child(2) {
    grid-column: span 3;
  }

  .gallery-photo {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border: 1px solid var(--hairline);
    border-radius: var(--r-md);
    background: var(--surface);
  }

  .gallery-title {
    font-size: 1rem;
    font-weight: 500;
    margin-bottom: 4px;
  }

  .gallery-desc {
    font-size: 0.875rem;
    color: var(--ink-2);
    line-height: 1.55;
  }

  .facilities-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--hairline);
    border: 1px solid var(--hairline);
    border-radius: var(--r-md);
    overflow: hidden;
  }

  .facility-item {
    background: var(--surface);
    padding: 22px;
    transition: background 0.2s ease;
  }

  .facility-item:hover {
    background: var(--paper-2);
  }

  .fac-name {
    font-size: 1rem;
    font-weight: 500;
    margin-bottom: 6px;
  }

  .fac-desc {
    font-size: 0.875rem;
    color: var(--ink-2);
    line-height: 1.6;
  }

  @media (max-width: 900px) {
    .campus-gallery-grid,
    .facilities-grid {
      grid-template-columns: 1fr;
    }
    .gallery-card,
    .gallery-card:nth-child(1),
    .gallery-card:nth-child(2) {
      grid-column: span 1;
    }
  }
</style>
