---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ValueProp from '../components/ValueProp.astro';

const campusGallery = [
  { img: "/images/school/Smansa1.jpg", title: "Gerbang & Gedung Cagar Budaya", desc: "Arsitektur ikonik SMAN 1 Klaten yang megah dan penuh nilai historis sejak 1957." },
  { img: "/images/school/Smansa2.jpg", title: "Halaman Dalam & Lapangan Terbuka", desc: "Pusat aktivitas upacara, apel kesiswaan, dan pembinaan olahraga terbuka." },
  { img: "/images/school/Smansa3.jpg", title: "Kompleks Ruang Kelas Bertingkat", desc: "Ruang belajar berpendingin ruangan dengan ventilasi silang asri dan proyektor digital." },
  { img: "/images/school/Smansa4.jpg", title: "Koridor Laboratorium Sains", desc: "Akses penghubung menuju laboratorium fisika, kimia, biologi, dan komputer." },
  { img: "/images/school/Smansa5.jpg", title: "Taman Kampus & Area Diskusi Hijau", desc: "Ruang terbuka hijau dan gazebo literasi siswa di sela jam istirahat pembelajaran." }
];

const facilities = [
  { name: "Laboratorium Sains Terpadu", desc: "Lab Fisika, Kimia, dan Biologi dengan instrumen analitis standar penelitian nasional." },
  { name: "3 Laboratorium Komputer", desc: "Dilengkapi 120+ unit PC berkecepatan tinggi untuk simulasi komputasi dan asesmen digital." },
  { name: "Perpustakaan Graha Pustaka & e-Perpus", desc: "Koleksi ribuan buku fisik dan portal perpustakaan digital e-Perpus terakreditasi A nasional." },
  { name: "Gelanggang Olahraga (GOR) Indoor", desc: "Lapangan indoor serbaguna untuk bola basket standar DBL, voli, dan bulutangkis." },
  { name: "Sanggar Karawitan & Seni Peran", desc: "Ruang akustik berstandar pelestarian gamelan gaya Surakarta dan pementasan teater TSL." },
  { name: "Masjid Kampus & Sarana Ibadah", desc: "Sarana pembinaan spiritual yang luas, bersih, dan representatif bagi civitas akademika." }
];
---

<BaseLayout
  title="Fasilitas & Galeri Kampus 13 | SMA Negeri 1 Klaten"
  description="Dokumentasi fasilitas laboratorium riset, 3 lab komputer, perpustakaan digital e-Perpus, dan sarana olahraga di SMA Negeri 1 Klaten."
>
  <Header />

  <main class="facility-page">
    <section class="facility-hero">
      <div class="container text-center">
        <span class="page-tag">Sarana & Prasarana Kampus 13</span>
        <h1 class="page-title">Infrastruktur Kampus Pendukung Prestasi</h1>
        <p class="page-lead">
          Lingkungan belajar yang asri, modern, dan cagar sejarah di Jl. Merbabu No. 13 Klaten untuk menjamin kenyamanan riset, akademik, dan kreativitas siswa.
        </p>
      </div>
    </section>

    <!-- Galeri Foto Kampus Nyata -->
    <section class="campus-photo-section">
      <div class="container">
        <div class="section-title-wrap text-center">
          <span class="sub-badge">Footage Resmi Kampus</span>
          <h2 class="section-title">Dokumentasi Lingkungan SMAN 1 Klaten</h2>
        </div>

        <div class="campus-gallery-grid">
          {campusGallery.map((item) => (
            <div class="gallery-card">
              <div class="gallery-img-box">
                <img src={item.img} alt={item.title} class="gallery-photo" loading="lazy" />
              </div>
              <div class="gallery-body">
                <h3 class="gallery-title">{item.title}</h3>
                <p class="gallery-desc">{item.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <ValueProp />

    <section class="facility-grid-section">
      <div class="container">
        <div class="section-title-wrap text-center">
          <span class="sub-badge">Katalog Sarana</span>
          <h2 class="section-title">Daftar Fasilitas Utama</h2>
        </div>

        <div class="facilities-grid">
          {facilities.map((f) => (
            <div class="facility-item">
              <h3 class="fac-name">{f.name}</h3>
              <p class="fac-desc">{f.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .facility-page {
    background-color: var(--color-bg);
  }

  .facility-hero {
    background-color: var(--color-surface);
    padding: 70px 0 50px;
    border-bottom: 1px solid var(--color-border);
  }

  .text-center { text-align: center; }

  .page-tag {
    font-size: 0.74rem;
    font-family: var(--font-mono);
    font-weight: 700;
    text-transform: uppercase;
    color: var(--color-accent-coral);
    letter-spacing: 0.08em;
  }

  .page-title {
    font-family: var(--font-serif);
    font-size: clamp(2.2rem, 4vw, 3.2rem);
    color: var(--color-text-primary);
    margin: 12px 0 16px;
  }

  .page-lead {
    font-size: 1.05rem;
    color: var(--color-text-secondary);
    max-width: 680px;
    margin: 0 auto;
    line-height: 1.6;
  }

  /* Real Campus Photo Gallery */
  .campus-photo-section {
    padding: 60px 0;
  }

  .section-title-wrap {
    margin-bottom: 40px;
  }

  .sub-badge {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--color-accent-coral);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .section-title {
    font-family: var(--font-serif);
    font-size: 2.1rem;
    color: var(--color-text-primary);
    margin-top: 6px;
  }

  .campus-gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 24px;
  }

  .gallery-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-subtle);
    transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
  }

  .gallery-card:hover {
    transform: translateY(-3px);
    border-color: var(--color-accent-coral);
    box-shadow: var(--shadow-card);
  }

  .gallery-img-box {
    width: 100%;
    height: 210px;
    overflow: hidden;
    background-color: var(--color-dark-ribbon);
  }

  .gallery-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .gallery-card:hover .gallery-photo {
    transform: scale(1.03);
  }

  .gallery-body {
    padding: 20px 22px;
  }

  .gallery-title {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin-bottom: 6px;
  }

  .gallery-desc {
    font-size: 0.86rem;
    color: var(--color-text-secondary);
    line-height: 1.55;
  }

  /* Facility Items */
  .facility-grid-section {
    padding: 40px 0 80px;
  }

  .facilities-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .facility-item {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 26px;
    box-shadow: var(--shadow-subtle);
  }

  .fac-name {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin-bottom: 8px;
  }

  .fac-desc {
    font-size: 0.88rem;
    color: var(--color-text-secondary);
    line-height: 1.55;
  }

  @media (max-width: 900px) {
    .facilities-grid {
      grid-template-columns: 1fr;
    }
    .campus-gallery-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
