---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/react/Header';
import Footer from '../components/react/Footer';
import FasilitasPage from '../components/react/pages/FasilitasPage';
---

<BaseLayout
  title="Fasilitas dan Galeri Kampus | SMA Negeri 1 Klaten"
  description="Dokumentasi fasilitas laboratorium sains, tiga lab komputer, perpustakaan digital e-Perpus, gelanggang olahraga, dan sarana cagar budaya SMA Negeri 1 Klaten."
>
  <Header client:load currentPath="/fasilitas" />

  <main id="main-content">
    <FasilitasPage client:load />
  </main>

  <Footer client:load />
</BaseLayout>
