---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import EventBanner from '../components/EventBanner.astro';

const quotas = [
  { pct: "55%", title: "Jalur zonasi", desc: "Berdasarkan jarak domisili pada kartu keluarga ke lokasi sekolah. Kartu keluarga harus diterbitkan minimal satu tahun sebelum pendaftaran." },
  { pct: "20%", title: "Jalur afirmasi", desc: "Dipersembahkan bagi calon peserta didik dari keluarga ekonomi kurang mampu yang terdaftar pada DTKS dan anak panti asuhan." },
  { pct: "20%", title: "Jalur prestasi", desc: "Berdasarkan nilai rapor lima semester terakhir dan piagam kejuaraan akademik maupun nonakademik yang berjenjang resmi." },
  { pct: "5%", title: "Jalur mutasi orang tua", desc: "Bagi calon siswa yang orang tuanya mengalami perpindahan tugas dinas atau anak tenaga pendidik di sekolah ini." }
];

const requirements = [
  "Fotokopi kartu keluarga",
  "Fotokopi akta kelahiran",
  "Fotokopi ijazah atau surat keterangan lulus",
  "Fotokopi rapor lima semester terakhir",
  "Piagam prestasi bagi pendaftar jalur prestasi",
  "Dokumen pendukung DTKS bagi pendaftar jalur afirmasi"
];
---

<BaseLayout
  title="Informasi PPDB 2026 | SMA Negeri 1 Klaten"
  description="Panduan pendaftaran peserta didik baru SMA Negeri 1 Klaten tahun ajaran 2026/2027: kuota jalur seleksi, berkas yang disiapkan, dan jadwal layanan."
>
  <Header />

  <main id="main-content">
    <section class="ppdb-hero">
      <div class="container">
        <p class="lbl">Penerimaan siswa baru</p>
        <h1 class="page-title">Petunjuk teknis PPDB 2026/2027</h1>
        <p class="page-lead">
          Penerimaan peserta didik baru berjalan melalui sistem resmi Dinas
          Pendidikan dan Kebudayaan Provinsi Jawa Tengah. Seluruh tahapan
          diverifikasi sekolah tanpa pungutan biaya.
        </p>
      </div>
    </section>

    <EventBanner />

    <section class="quota-section">
      <div class="container">
        <h2 class="section-heading">Pembagian kuota jalur seleksi</h2>
        <div class="quota-grid">
          {quotas.map((q) => (
            <article class="quota-card" data-reveal>
              <span class="quota-pct num">{q.pct}</span>
              <h3 class="quota-title">{q.title}</h3>
              <p class="quota-desc">{q.desc}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="req-section">
      <div class="container">
        <h2 class="section-heading">Berkas yang disiapkan</h2>
        <ul class="req-list">
          {requirements.map((r) => (
            <li class="req-item" data-reveal>
              <span class="req-mark" aria-hidden="true"></span>
              <span>{r}</span>
            </li>
          ))}
        </ul>

        <div class="ppdb-cta">
          <div>
            <h3 class="cta-title">Perlu bantuan memilih jalur?</h3>
            <p class="cta-desc">
              Tanyakan estimasi zonasi, ketentuan piagam prestasi, atau kelengkapan
              berkas melalui asisten informasi sekolah.
            </p>
          </div>
          <a href="/#chatbot" class="btn btn-primary">Tanya SmansaBot AI</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .ppdb-hero {
    padding: clamp(40px, 6vw, 72px) 0 clamp(24px, 3vw, 36px);
    border-top: 0;
  }

  .page-title {
    font-size: clamp(1.9rem, 3.6vw, 2.8rem);
    font-weight: 500;
    margin-bottom: 18px;
    max-width: 24ch;
  }

  .page-lead {
    font-size: 1.0625rem;
    color: var(--ink-2);
    line-height: 1.7;
    max-width: 62ch;
  }

  .section-heading {
    font-size: clamp(1.4rem, 2.4vw, 1.75rem);
    font-weight: 500;
    margin-bottom: clamp(24px, 3vw, 36px);
  }

  .quota-section,
  .req-section {
    padding-top: clamp(48px, 6vw, 72px);
    padding-bottom: clamp(48px, 6vw, 72px);
  }

  .quota-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--hairline);
    border: 1px solid var(--hairline);
    border-radius: var(--r-md);
    overflow: hidden;
  }

  .quota-card {
    background: var(--surface);
    padding: 24px;
    transition: background 0.2s ease;
  }

  .quota-card:hover {
    background: var(--paper-2);
  }

  .quota-pct {
    font-family: var(--font-serif);
    font-size: 2rem;
    font-weight: 500;
    display: block;
    margin-bottom: 12px;
    color: var(--ink);
  }

  .quota-title {
    font-size: 1rem;
    font-weight: 500;
    margin-bottom: 8px;
  }

  .quota-desc {
    font-size: 0.875rem;
    color: var(--ink-2);
    line-height: 1.6;
  }

  .req-list {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--hairline);
    border: 1px solid var(--hairline);
    border-radius: var(--r-md);
    overflow: hidden;
    margin-bottom: clamp(24px, 4vw, 40px);
  }

  .req-item {
    background: var(--surface);
    padding: 18px 20px;
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 0.9375rem;
    color: var(--ink-2);
  }

  .req-mark {
    width: 5px;
    height: 5px;
    margin-top: 9px;
    border-radius: 50%;
    background: var(--accent);
    flex-shrink: 0;
  }

  .ppdb-cta {
    border: 1px solid var(--hairline);
    border-radius: var(--r-md);
    background: var(--surface);
    padding: clamp(22px, 3vw, 32px);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
  }

  .cta-title {
    font-size: 1.25rem;
    font-weight: 500;
    margin-bottom: 8px;
  }

  .cta-desc {
    font-size: 0.9375rem;
    color: var(--ink-2);
    line-height: 1.65;
    max-width: 52ch;
  }

  @media (max-width: 900px) {
    .quota-grid,
    .req-list {
      grid-template-columns: 1fr;
    }
  }
</style>
