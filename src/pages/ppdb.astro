---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/react/Header';
import Footer from '../components/react/Footer';
import PpdbPage from '../components/react/pages/PpdbPage';
---

<BaseLayout
  title="Informasi PPDB 2026 | SMA Negeri 1 Klaten"
  description="Panduan pendaftaran peserta didik baru SMA Negeri 1 Klaten tahun ajaran 2026/2027: kuota jalur seleksi, berkas yang disiapkan, simulasi kalkulator zonasi, dan jadwal layanan."
>
  <Header client:load currentPath="/ppdb" />
  <main id="main-content">
    <PpdbPage client:visible />
  </main>
  <Footer client:load />
</BaseLayout>
