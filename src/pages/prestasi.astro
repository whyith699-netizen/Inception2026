---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Metrics from '../components/Metrics.astro';
import AlumniSection from '../components/AlumniSection.astro';

const achievements = [
  { year: "2025", title: "Medali Emas OSN Bidang Astronomi", level: "Tingkat Nasional", desc: "Pusat Prestasi Nasional Kemendikbudristek." },
  { year: "2025", title: "Medali Perak OSN Bidang Matematika", level: "Tingkat Nasional", desc: "Kompetisi Sains Siswa SMA Nasional." },
  { year: "2024", title: "Juara 1 FLS2N Seni Kriya & Karawitan", level: "Tingkat Provinsi Jawa Tengah", desc: "Apresiasi pelestarian seni tradisional nusantara." },
  { year: "2024", title: "Champion DBL Central Java Series", level: "Regional Jawa Tengah", desc: "Kompetisi bola basket antarpelajar bergengsi." }
];
---

<BaseLayout
  title="Prestasi & Tokoh Alumni Menyapa | SMA Negeri 1 Klaten"
  description="Rekam jejak kejuaraan Olimpiade Sains Nasional (OSN), statistik kelulusan 94.8% ke PTN, dan inspirasi kiprah tokoh alumni SMAN 1 Klaten."
>
  <Header />

  <main>
    <section class="prestasi-hero">
      <div class="container text-center">
        <span class="page-tag">Rekam Jejak Kejuaraan</span>
        <h1 class="page-title">Prestasi Gemilang & Serapan Alumni PTN</h1>
        <p class="page-lead">
          Tradisi juara yang terpelihara secara berkesinambungan melalui pembinaan terstruktur, riset ilmiah, dan etos juang tak kenal lelah.
        </p>
      </div>
    </section>

    <!-- Pita Metrik Statistik -->
    <Metrics />

    <!-- Daftar Kejuaraan -->
    <section class="achievements-section">
      <div class="container">
        <h2 class="section-title text-center" style="margin-bottom: 40px;">Capaian Kejuaraan Terkini</h2>
        <div class="achievements-grid">
          {achievements.map((item) => (
            <div class="achievement-card">
              <div class="card-top">
                <span class="year-badge">{item.year}</span>
                <span class="level-badge">{item.level}</span>
              </div>
              <h3 class="ach-title">{item.title}</h3>
              <p class="ach-desc">{item.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Bagian Alumni Menyapa Tokoh Nyata SMANSA -->
    <AlumniSection />
  </main>

  <Footer />
</BaseLayout>

<style>
  .prestasi-hero {
    background-color: var(--color-surface-muted);
    padding: 60px 0;
    border-bottom: 1px solid var(--color-border);
  }
  .text-center { text-align: center; }
  .page-tag {
    font-size: 0.82rem;
    font-family: var(--font-mono);
    font-weight: 700;
    text-transform: uppercase;
    color: var(--color-accent-coral);
    letter-spacing: 0.08em;
  }
  .page-title {
    font-size: clamp(2rem, 3.8vw, 3rem);
    margin: 12px 0 16px;
  }
  .page-lead {
    font-size: 1.05rem;
    color: var(--color-text-secondary);
    max-width: 680px;
    margin: 0 auto;
    line-height: 1.6;
  }
  .achievements-section {
    padding: 60px 0 70px;
  }
  .achievements-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 28px;
  }
  .achievement-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: 32px;
    box-shadow: 0 4px 16px rgba(34, 22, 16, 0.04);
  }
  .card-top {
    display: flex;
    gap: 10px;
    margin-bottom: 16px;
  }
  .year-badge {
    background-color: var(--color-accent-coral);
    color: #FFFFFF;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
    padding: 3px 10px;
    border-radius: var(--radius-pill);
  }
  .level-badge {
    background-color: var(--color-surface-muted);
    font-size: 0.78rem;
    font-weight: 600;
    padding: 3px 10px;
    border-radius: var(--radius-pill);
    color: var(--color-text-secondary);
  }
  .ach-title {
    font-size: 1.35rem;
    margin-bottom: 8px;
    font-family: var(--font-serif);
  }
  .ach-desc {
    font-size: 0.92rem;
    color: var(--color-text-secondary);
    line-height: 1.55;
  }
  @media (max-width: 768px) {
    .achievements-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
