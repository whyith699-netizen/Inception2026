---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/react/Header';
import Footer from '../components/react/Footer';
import PrestasiPage from '../components/react/pages/PrestasiPage';
---

<BaseLayout
  title="Prestasi Siswa dan Rekam Jejak | SMA Negeri 1 Klaten"
  description="Rekam jejak kejuaraan olimpiade sains OSN, FLS2N, O2SN, LKTIN, dan penghargaan Adiwiyata Mandiri SMA Negeri 1 Klaten."
>
  <Header client:load currentPath="/prestasi" />

  <main id="main-content">
    <PrestasiPage client:load />
  </main>

  <Footer client:load />
</BaseLayout>
