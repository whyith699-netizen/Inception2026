---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Metrics from '../components/Metrics.astro';
import AlumniSection from '../components/AlumniSection.astro';

const achievements = [
  { year: "2026", title: "Juara 1 Lomba Karya Tulis Ilmiah Festival Pelajar Pancasila", level: "Nasional", desc: "Riset inovasi sosial siswa SMAN 1 Klaten pada ajang bergengsi kepemudaan nasional." },
  { year: "2025", title: "Medali perak OSN Fisika tingkat provinsi", level: "Jawa Tengah", desc: "Diraih setelah seleksi ketat pembinaan intensif laboratorium sains fisika Kampus 13." },
  { year: "2025", title: "Juara umum O2SN futsal Kabupaten Klaten", level: "Kabupaten", desc: "Tim futsal putra sekolah mempertahankan tradisi gelar juara antarpelajar se-Kabupaten Klaten." },
  { year: "2016", title: "Penghargaan Sekolah Adiwiyata Nasional", level: "Nasional", desc: "Apresiasi tertinggi Kementerian LHK dan Kemendikbud atas komitmen pelestarian lingkungan kampus 15.619 m²." },
  { year: "2013", title: "Juara I LKTI Kedokteran Nasional FK Universitas Udayana", level: "Nasional", desc: "Karya ilmiah bidang biomedis siswa SMAN 1 Klaten bersaing dengan perwakilan sekolah rujukan nasional." },
  { year: "2004", title: "Medali Emas Olimpiade Astronomi Internasional (IOA)", level: "Internasional (Simeiz, Crimea)", desc: "Pencapaian legendaris emas dunia di Simeiz Crimea, dilengkapi 2 Medali Emas & 1 Perunggu di OSN." }
];
---

<BaseLayout
  title="Prestasi dan Alumni | SMA Negeri 1 Klaten"
  description="Rekam jejak kompetisi sains dan olahraga, serapan lulusan ke perguruan tinggi, dan direktori alumni KAPASSKA SMAN 1 Klaten."
>
  <Header />

  <main id="main-content">
    <section class="prestasi-hero">
      <div class="container">
        <p class="lbl">Rekam jejak</p>
        <h1 class="page-title">Prestasi siswa dan jejak alumni</h1>
        <p class="page-lead">
          Tradisi keunggulan akademik yang dibina secara berkelanjutan melalui
          kelas riset, pendampingan ekstrakurikuler, dan penguatan etos belajar
          civitas Padmawijaya.
        </p>
      </div>
    </section>

    <Metrics />

    <section class="achievements-section">
      <div class="container">
        <h2 class="section-heading">Capaian kompetisi terkini</h2>
        <div class="achievements-grid">
          {achievements.map((item) => (
            <article class="achievement-card" data-reveal>
              <div class="card-meta">
                <span class="year-badge num">{item.year}</span>
                <span class="level-badge">{item.level}</span>
              </div>
              <h3 class="ach-title">{item.title}</h3>
              <p class="ach-desc">{item.desc}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <AlumniSection />
  </main>

  <Footer />
</BaseLayout>

<style>
  .prestasi-hero {
    padding: clamp(40px, 6vw, 72px) 0 clamp(32px, 5vw, 48px);
    border-top: 0;
  }

  .page-title {
    font-size: clamp(1.9rem, 3.6vw, 2.8rem);
    font-weight: 500;
    margin-bottom: 18px;
    max-width: 22ch;
  }

  .page-lead {
    font-size: 1.0625rem;
    color: var(--ink-2);
    line-height: 1.7;
    max-width: 60ch;
  }

  .achievements-section {
    padding-top: clamp(48px, 6vw, 72px);
    padding-bottom: clamp(48px, 6vw, 72px);
  }

  .section-heading {
    font-size: clamp(1.4rem, 2.4vw, 1.75rem);
    font-weight: 500;
    margin-bottom: clamp(24px, 3vw, 36px);
  }

  .achievements-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--hairline);
    border: 1px solid var(--hairline);
    border-radius: var(--r-md);
    overflow: hidden;
  }

  .achievement-card {
    background: var(--surface);
    padding: 24px;
    transition: background 0.2s ease;
  }

  .achievement-card:hover {
    background: var(--paper-2);
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 14px;
  }

  .year-badge {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ink-3);
  }

  .level-badge {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .ach-title {
    font-size: 1.125rem;
    font-weight: 500;
    margin-bottom: 8px;
    line-height: 1.35;
  }

  .ach-desc {
    font-size: 0.875rem;
    color: var(--ink-2);
    line-height: 1.6;
  }

  @media (max-width: 800px) {
    .achievements-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
