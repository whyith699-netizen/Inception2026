---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Kontak & Lokasi Kampus 13 | SMA Negeri 1 Klaten"
  description="Sekretariat, alamat resmi Jl. Merbabu No. 13 Klaten Selatan 57423, telepon (0272) 321150, dan jam pelayanan publik SMAN 1 Klaten."
>
  <Header />

  <main class="contact-page">
    <section class="contact-hero">
      <div class="container text-center">
        <span class="page-tag">Sekretariat & Pelayanan Informasi</span>
        <h1 class="page-title">Hubungi SMA Negeri 1 Klaten</h1>
        <p class="page-lead">
          Pintu komunikasi terbuka untuk pertanyaan akademik, legalitas kesiswaan, kemitraan institusi, dan konsultasi pendaftaran peserta didik baru.
        </p>
      </div>
    </section>

    <section class="contact-body">
      <div class="container grid-contact">
        <!-- Informasi Kontak Langsung -->
        <div class="contact-info-card">
          <h2 class="card-heading">Saluran Resmi Sekolah</h2>
          
          <div class="info-group">
            <span class="group-title">Alamat Kampus Utama</span>
            <p>Jl. Merbabu No. 13, RT 1 / RW 1, Kec. Klaten Selatan, Kab. Klaten, Jawa Tengah 57423</p>
          </div>

          <div class="info-group">
            <span class="group-title">Telepon Kantor</span>
            <p>(0272) 321150</p>
          </div>

          <div class="info-group">
            <span class="group-title">Surat Elektronik (Surel)</span>
            <p>info@sma1klaten.sch.id</p>
          </div>

          <div class="info-group">
            <span class="group-title">Portal Layanan Daring</span>
            <p>e-Learning: <a href="http://elearning.sma1klaten.sch.id/" target="_blank" rel="noopener noreferrer">elearning.sma1klaten.sch.id &rarr;</a></p>
            <p>e-Perpus: <a href="https://eperpus.sma1klaten.sch.id/" target="_blank" rel="noopener noreferrer">eperpus.sma1klaten.sch.id &rarr;</a></p>
          </div>

          <div class="info-group">
            <span class="group-title">Jam Pelayanan Tata Usaha</span>
            <p>Senin – Kamis: 07:00 – 15:30 WIB</p>
            <p>Jumat: 07:00 – 14:00 WIB</p>
          </div>
        </div>

        <!-- Formulir Pesan & Aspirasi -->
        <div class="contact-form-card">
          <h2 class="card-heading">Kirim Pesan ke Tata Usaha</h2>
          <form class="contact-form" onsubmit="event.preventDefault(); alert('Terima kasih. Pesan Anda telah tercatat pada sekretariat SMA Negeri 1 Klaten.');">
            <div class="form-group">
              <label for="name">Nama Lengkap</label>
              <input type="text" id="name" required placeholder="Contoh: Budi Santoso" />
            </div>
            <div class="form-group">
              <label for="email">Alamat Email / Nomor Kontak</label>
              <input type="text" id="email" required placeholder="nama@email.com atau 0812xxx" />
            </div>
            <div class="form-group">
              <label for="category">Keperluan Layanan</label>
              <select id="category">
                <option value="ppdb">Informasi PPDB 2026</option>
                <option value="akademik">Kurikulum & Peminatan Siswa</option>
                <option value="legalisir">Legalisir Ijazah & Layanan Alumni</option>
                <option value="kemitraan">Kemitraan & Penelitian</option>
              </select>
            </div>
            <div class="form-group">
              <label for="msg">Isi Pesan / Pertanyaan</label>
              <textarea id="msg" rows="4" required placeholder="Tuliskan perihal atau pertanyaan Anda secara rinci..."></textarea>
            </div>
            <button type="submit" class="btn btn-primary btn-arrow">Kirim Pesan Resmi</button>
          </form>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .contact-page {
    background-color: var(--color-bg);
  }

  .contact-hero {
    background-color: var(--color-surface);
    padding: 70px 0 50px;
    border-bottom: 1px solid var(--color-border);
  }

  .text-center { text-align: center; }

  .page-tag {
    font-size: 0.74rem;
    font-family: var(--font-mono);
    font-weight: 700;
    text-transform: uppercase;
    color: var(--color-accent-coral);
    letter-spacing: 0.08em;
  }

  .page-title {
    font-family: var(--font-serif);
    font-size: clamp(2.2rem, 4vw, 3.2rem);
    color: var(--color-text-primary);
    margin: 12px 0 16px;
  }

  .page-lead {
    font-size: 1.05rem;
    color: var(--color-text-secondary);
    max-width: 680px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .contact-body {
    padding: 60px 0 90px;
  }

  .grid-contact {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 40px;
  }

  .contact-info-card, .contact-form-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 36px;
    box-shadow: var(--shadow-subtle);
  }

  .card-heading {
    font-family: var(--font-serif);
    font-size: 1.45rem;
    color: var(--color-text-primary);
    margin-bottom: 24px;
  }

  .info-group {
    margin-bottom: 18px;
  }

  .group-title {
    font-size: 0.72rem;
    font-family: var(--font-mono);
    font-weight: 700;
    text-transform: uppercase;
    color: var(--color-accent-coral);
    letter-spacing: 0.05em;
    display: block;
    margin-bottom: 4px;
  }

  .info-group p {
    font-size: 0.92rem;
    color: var(--color-text-secondary);
    line-height: 1.55;
    margin-bottom: 4px;
  }

  .info-group a {
    color: var(--color-accent-coral);
    text-decoration: none;
    font-weight: 600;
  }

  .info-group a:hover {
    text-decoration: underline;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .form-group label {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .form-group input, .form-group select, .form-group textarea {
    font-family: var(--font-sans);
    font-size: 0.92rem;
    padding: 10px 14px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background-color: var(--color-surface-muted);
    color: var(--color-text-primary);
    transition: border-color 0.2s ease;
  }

  .form-group input:focus, .form-group select:focus, .form-group textarea:focus {
    outline: none;
    border-color: var(--color-accent-coral);
    background-color: var(--color-surface);
  }

  @media (max-width: 860px) {
    .grid-contact {
      grid-template-columns: 1fr;
    }
  }
</style>
