---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/react/Header';
import Footer from '../components/react/Footer';
import KontakPage from '../components/react/pages/KontakPage';
---

<BaseLayout
  title="Kontak dan Lokasi | SMA Negeri 1 Klaten"
  description="Sekretariat SMA Negeri 1 Klaten di Jalan Merbabu Nomor 13 Klaten Selatan, telepon (0272) 321150, portal daring, dan formulir pengaduan layanan tata usaha."
>
  <Header client:load currentPath="/kontak" />

  <main id="main-content">
    <KontakPage client:load />
  </main>

  <Footer client:load />
</BaseLayout>
