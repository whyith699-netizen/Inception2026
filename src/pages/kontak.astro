---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Kontak dan Lokasi | SMA Negeri 1 Klaten"
  description="Sekretariat SMA Negeri 1 Klaten di Jalan Merbabu Nomor 13 Klaten Selatan, telepon (0272) 321150, portal daring, dan jam pelayanan tata usaha."
>
  <Header />

  <main id="main-content">
    <section class="contact-hero">
      <div class="container">
        <p class="lbl">Sekretariat dan layanan informasi</p>
        <h1 class="page-title">Hubungi SMA Negeri 1 Klaten</h1>
        <p class="page-lead">
          Saluran komunikasi sekolah untuk pertanyaan akademik, layanan kesiswaan,
          kemitraan institusi, dan konsultasi pendaftaran peserta didik baru.
        </p>
      </div>
    </section>

    <section class="contact-body">
      <div class="container grid-contact">
        <div class="contact-info-card">
          <h2 class="card-heading">Saluran resmi sekolah</h2>

          <div class="info-group">
            <span class="group-title">Alamat kampus utama</span>
            <p>Jalan Merbabu Nomor 13, Klaten Selatan, Kabupaten Klaten, Jawa Tengah 57423</p>
          </div>

          <div class="info-group">
            <span class="group-title">Telepon kantor</span>
            <p class="num">(0272) 321150</p>
          </div>

          <div class="info-group">
            <span class="group-title">Portal layanan daring</span>
            <p>
              <a class="inline-link" href="http://elearning.sma1klaten.sch.id/" target="_blank" rel="noopener noreferrer">elearning.sma1klaten.sch.id</a>
            </p>
            <p>
              <a class="inline-link" href="https://eperpus.sma1klaten.sch.id/" target="_blank" rel="noopener noreferrer">eperpus.sma1klaten.sch.id</a>
            </p>
          </div>

          <div class="info-group">
            <span class="group-title">Jam pelayanan tata usaha</span>
            <p>Senin sampai Kamis, 07.00 hingga 15.30 WIB</p>
            <p>Jumat, 07.00 hingga 14.00 WIB</p>
          </div>
        </div>

        <div class="contact-form-card">
          <h2 class="card-heading">Kirim pesan ke tata usaha</h2>
          <form class="contact-form" id="contact-form">
            <div class="form-group">
              <label for="name">Nama lengkap</label>
              <input type="text" id="name" name="name" required placeholder="Nama pengirim" />
            </div>
            <div class="form-group">
              <label for="email">Email atau nomor kontak</label>
              <input type="text" id="email" name="email" required placeholder="nama@email.com" />
            </div>
            <div class="form-group">
              <label for="category">Keperluan layanan</label>
              <select id="category" name="category">
                <option value="ppdb">Informasi PPDB 2026</option>
                <option value="akademik">Kurikulum dan peminatan siswa</option>
                <option value="legalisir">Legalisir ijazah dan layanan alumni</option>
                <option value="kemitraan">Kemitraan dan penelitian</option>
              </select>
            </div>
            <div class="form-group">
              <label for="msg">Isi pesan</label>
              <textarea id="msg" name="msg" rows="5" required placeholder="Tuliskan pertanyaan atau keperluan Anda"></textarea>
            </div>
            <p class="form-note" id="form-note" role="status" aria-live="polite"></p>
            <button type="submit" class="btn btn-primary">Kirim pesan</button>
          </form>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .contact-hero {
    padding: clamp(40px, 6vw, 72px) 0 clamp(24px, 3vw, 36px);
    border-top: 0;
  }

  .page-title {
    font-size: clamp(1.9rem, 3.6vw, 2.8rem);
    font-weight: 500;
    margin-bottom: 18px;
    max-width: 22ch;
  }

  .page-lead {
    font-size: 1.0625rem;
    color: var(--ink-2);
    line-height: 1.7;
    max-width: 60ch;
  }

  .contact-body {
    padding-top: clamp(40px, 6vw, 64px);
    padding-bottom: clamp(56px, 8vw, 88px);
  }

  .grid-contact {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: 1px;
    background: var(--hairline);
    border: 1px solid var(--hairline);
    border-radius: var(--r-md);
    overflow: hidden;
  }

  .contact-info-card,
  .contact-form-card {
    background: var(--surface);
    padding: clamp(22px, 3vw, 32px);
  }

  .card-heading {
    font-size: 1.25rem;
    font-weight: 500;
    margin-bottom: 24px;
  }

  .info-group {
    padding-top: 16px;
    border-top: 1px solid var(--hairline);
    margin-bottom: 16px;
  }

  .group-title {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-3);
    display: block;
    margin-bottom: 6px;
  }

  .info-group p {
    font-size: 0.9375rem;
    color: var(--ink-2);
    line-height: 1.6;
  }

  .info-group p + p {
    margin-top: 2px;
  }

  .inline-link {
    color: var(--accent);
    border-bottom: 1px solid var(--hairline-2);
  }

  .inline-link:hover {
    border-color: var(--accent);
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .form-group label {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--ink);
  }

  .form-group input,
  .form-group select,
  .form-group textarea {
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    padding: 10px 12px;
    border: 1px solid var(--hairline-2);
    border-radius: var(--r-sm);
    background: var(--paper);
    color: var(--ink);
  }

  .form-group input::placeholder,
  .form-group textarea::placeholder {
    color: var(--ink-3);
  }

  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--accent);
    background: var(--surface);
  }

  .form-note {
    font-size: 0.875rem;
    color: var(--ink-2);
    min-height: 1.25rem;
  }

  @media (max-width: 860px) {
    .grid-contact {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const note = document.getElementById('form-note');
  if (form && note) {
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      note.textContent = form.checkValidity()
        ? 'Pesan tercatat di peramban Anda. Untuk balasan langsung, hubungi sekretariat di (0272) 321150 pada jam kerja.'
        : 'Lengkapi nama, kontak, dan isi pesan sebelum mengirim.';
    });
  }
</script>
