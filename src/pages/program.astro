---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/react/Header';
import Footer from '../components/react/Footer';
import ProgramPage from '../components/react/pages/ProgramPage';
---

<BaseLayout
  title="Akademik dan Ekstrakurikuler | SMA Negeri 1 Klaten"
  description="Struktur Kurikulum Merdeka, tiga peminatan akademik, dan katalog 23 ekstrakurikuler resmi SMA Negeri 1 Klaten."
>
  <Header client:load currentPath="/program" />

  <main id="main-content">
    <ProgramPage client:load />
  </main>

  <Footer client:load />
</BaseLayout>
