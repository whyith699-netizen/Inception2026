---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/react/Header';
import Footer from '../components/react/Footer';
---

<BaseLayout
  title="Profil dan Sejarah | SMA Negeri 1 Klaten"
  description="Profil dan Sejarah SMA Negeri 1 Klaten kini telah disatukan ke halaman Beranda."
>
  <Header client:load currentPath="/#profil" />
  <main id="main-content" style="min-height: 65vh; display: flex; align-items: center; justify-content: center; padding: 60px 20px;">
    <div style="background: var(--neo-surface); border: var(--neo-border); box-shadow: var(--neo-shadow); padding: 36px 28px; max-width: 540px; text-align: center;">
      <span class="lbl lbl-lime">INFORMASI NAVIGASI</span>
      <h1 style="font-size: 1.6rem; margin: 18px 0 12px; font-weight: 700; color: var(--neo-ink);">Halaman Profil Telah Disatukan</h1>
      <p style="color: var(--neo-ink-2); margin-bottom: 24px; font-size: 0.95rem; line-height: 1.6;">
        Seluruh sejarah sejak 1957, filosofi Padmawijaya, maskot Chiku, sambutan kepala sekolah, dan data legalitas sekolah kini menjadi satu kesatuan di halaman <strong>Beranda</strong>.
      </p>
      <a href="/#profil" class="btn btn-primary" style="display: inline-block;">
        Buka Bagian Profil di Beranda &rarr;
      </a>
    </div>
  </main>
  <Footer client:load />

  <script>
    if (typeof window !== 'undefined') {
      window.location.replace('/#profil');
    }
  </script>
</BaseLayout>
