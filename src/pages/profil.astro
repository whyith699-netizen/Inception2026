---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const timelineMilestones = [
  { year: "1957", title: "Pendirian SMA Persiapan Klaten", desc: "Didirikan 5 November 1957 dengan 253 siswa dan ditetapkan sebagai SMA Negeri Klaten melalui SK Menteri PP dan K Nomor 5620/B/57." },
  { year: "1960", title: "Predikat SMA Negeri ABC", desc: "Status SMA Negeri ABC dengan peminatan budaya, sosial, dan ilmu alam." },
  { year: "1965", title: "Pemekaran sekolah", desc: "SMA Negeri ABC dimekarkan menjadi SMA Negeri 1 Klaten dan SMA Negeri 2 Klaten." },
  { year: "1994", title: "Sekolah unggulan Jawa Tengah", desc: "Ditetapkan sebagai sekolah unggulan percontohan tingkat karesidenan dan provinsi." },
  { year: "2003", title: "Perintis program akselerasi", desc: "Membuka kelas akselerasi perdana dan menerapkan Kurikulum Berbasis Kompetensi." },
  { year: "2021", title: "Akreditasi A dengan nilai 98", desc: "BAN-SM memberikan nilai 98 dan peringkat unggul, kemudian dilanjutkan penerapan Kurikulum Merdeka." }
];

const legalRows = [
  ["Nama resmi", "SMA Negeri 1 Klaten"],
  ["Sebutan akrab", "SMANSA, Padmawijaya, Kampus 13"],
  ["NPSN", "20309676"],
  ["NSS", "301046002001"],
  ["Tanggal berdiri", "5 November 1957, SK 5620/B/57"],
  ["Akreditasi", "A dengan nilai 98, BAN-SM 2021"],
  ["Rombongan belajar", "33 rombel kelas X sampai XII"],
  ["Organisasi alumni", "KAPASSKA"],
  ["Alamat", "Jl. Merbabu No. 13, Klaten Selatan 57423"],
  ["Telepon", "(0272) 321150"]
];
---

<BaseLayout
  title="Profil dan Sejarah | SMA Negeri 1 Klaten"
  description="Sejarah berdirinya SMA Negeri 1 Klaten pada 5 November 1957, filosofi Padmawijaya, maskot Chiku, ketua pimpinan sekolah, dan identitas legal kampus."
>
  <Header />

  <main id="main-content">
    <section class="page-header">
      <div class="container">
        <p class="lbl">Sejarah dan identitas institusi</p>
        <h1 class="page-title">Profil SMA Negeri 1 Klaten</h1>
        <p class="page-lead">
          Lebih dari enam dekade berdiri di Kampus 13 Klaten, sekolah ini dibina
          untuk mencetak lulusan yang berakar pada budaya Jawa, luwes dalam sains,
          dan siap bersaing di tingkat nasional.
        </p>
      </div>
    </section>

    <section class="sec">
      <div class="container">
        <div class="philosophy-grid">
          <article class="phil-card" data-reveal>
            <p class="card-label">Makna nama</p>
            <h2 class="phil-title">Nama kehormatan Padmawijaya</h2>
            <p class="phil-desc">
              Padmawijaya berasal dari bahasa Sanskerta: <em>padma</em> berarti bunga
              teratai merah, dan <em>wijaya</em> berarti kejayaan. Teratai dipilih
              karena dapat mekar indah di atas lumpur tanpa ternoda, lambang moral
              yang bersih dan akal budi yang luhur.
            </p>
          </article>

          <article class="phil-card" data-reveal>
            <p class="card-label">Maskot sekolah</p>
            <h2 class="phil-title">Chiku si burung hantu</h2>
            <p class="phil-desc">
              Burung hantu melambangkan ketenangan berpikir, ketajaman nalar, dan
              kedalaman ilmu. Sosok Chiku menjadi penanda identitas civitas
              akademika Padmawijaya dalam setiap kegiatan sekolah.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section class="sec">
      <div class="container">
        <h2 class="section-heading">Sambutan kepala sekolah</h2>
        <div class="principal-card">
          <figure class="principal-photo-col">
            <img
              src="/images/school/salamkepsek.jpg"
              alt="Tantri Ambarsari, S.Pd., M.Eng., Kepala Sekolah SMAN 1 Klaten"
              class="principal-photo"
              width="320"
              height="400"
              loading="lazy"
            />
            <figcaption class="photo-label">
              <strong>Tantri Ambarsari, S.Pd., M.Eng.</strong>
              <span>Kepala Sekolah bidang kesiswaan dan kurikulum</span>
            </figcaption>
          </figure>
          <div class="principal-text-col">
            <p class="principal-quote">
              Assalamualaikum warahmatullahi wabarakatuh, salam sejahtera untuk kita semua.
            </p>
            <p>
              SMA Negeri 1 Klaten telah menapaki lebih dari enam dekade pengabdian
              mencetak generasi pemimpin bangsa. Kami memegang prinsip bahwa
              kemajuan teknologi harus dipandu oleh keteguhan integritas budi
              pekerti dan tanggung jawab terhadap lingkungan.
            </p>
            <p>
              Melalui Kurikulum Merdeka, 23 ekstrakurikuler, dan fasilitas riset di
              Kampus 13, sekolah berkomitmen melahirkan lulusan yang cerdas
              bernalar, berwawasan luas, dan menjunjung tinggi kehormatan almamater
              Padmawijaya.
            </p>
            <p class="motto">Berkarakter, Hebat, Jaya</p>
          </div>
        </div>
      </div>
    </section>

    <section class="sec" id="sejarah">
      <div class="container">
        <h2 class="section-heading">Linimasa sejarah</h2>
        <div class="timeline-list">
          {timelineMilestones.map((item) => (
            <article class="timeline-row" data-reveal>
              <span class="year-text num">{item.year}</span>
              <div class="timeline-content-col">
                <h3 class="milestone-title">{item.title}</h3>
                <p class="milestone-desc">{item.desc}</p>
              </div>
            </article>
          ))}
        </div>

        <div class="history-photos-grid">
          <figure class="photo-card" data-reveal>
            <img
              src="/images/school/history-foto1.jpg"
              alt="Arsip pendirian SMA Persiapan Klaten tahun 1957"
              class="hist-img"
              width="600"
              height="400"
              loading="lazy"
            />
            <figcaption class="photo-caption">
              <strong>Arsip pendirian 1957</strong>
              <span>Gedung awal SMA Persiapan Klaten di Jalan Merbabu Nomor 13</span>
            </figcaption>
          </figure>

          <figure class="photo-card" data-reveal>
            <img
              src="/images/school/history-foto2a.jpg"
              alt="Generasi pengajar perintis SMAN 1 Klaten"
              class="hist-img"
              width="600"
              height="400"
              loading="lazy"
            />
            <figcaption class="photo-caption">
              <strong>Generasi pengajar perintis</strong>
              <span>Pondasi etos akademik dan kedisiplinan intelektual sekolah</span>
            </figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section class="sec">
      <div class="container">
        <h2 class="section-heading">Dewan pendidik dan tenaga kependidikan</h2>
        <figure class="faculty-banner">
          <img
            src="/images/school/smansafullteam.jpeg"
            alt="Dewan pengajar dan tenaga kependidikan SMAN 1 Klaten berfoto bersama"
            class="faculty-img"
            width="1280"
            height="720"
            loading="lazy"
          />
          <figcaption class="faculty-meta">
            Dewan pendidik sekolah meningkatan mutu pembelajaran melalui kelas riset,
            pendampingan ekstrakurikuler, dan literasi digital bagi seluruh siswa.
            Daftar lengkap pimpinan dan bidang studi tersedia di halaman
            <a class="inline-link" href="/direktori">Direktori</a>.
          </figcaption>
        </figure>
      </div>
    </section>

    <section class="sec">
      <div class="container">
        <h2 class="section-heading">Identitas legalitas institusi</h2>
        <div class="legal-card">
          <dl class="legal-grid">
            {legalRows.map(([label, value]) => (
              <div class="legal-item">
                <dt>{label}</dt>
                <dd>{value}</dd>
              </div>
            ))}
          </dl>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .page-header {
    padding: clamp(40px, 6vw, 72px) 0 clamp(28px, 4vw, 44px);
    border-top: 0;
  }

  .page-title {
    font-size: clamp(1.9rem, 3.6vw, 2.8rem);
    font-weight: 500;
    margin-bottom: 18px;
    max-width: 24ch;
  }

  .page-lead {
    font-size: 1.0625rem;
    color: var(--ink-2);
    line-height: 1.7;
    max-width: 62ch;
  }

  .section-heading {
    font-size: clamp(1.4rem, 2.4vw, 1.75rem);
    font-weight: 500;
    margin-bottom: clamp(24px, 3vw, 36px);
  }

  .card-label {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 12px;
  }

  .philosophy-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: var(--hairline);
    border: 1px solid var(--hairline);
    border-radius: var(--r-md);
    overflow: hidden;
  }

  .phil-card {
    background: var(--surface);
    padding: clamp(22px, 3vw, 32px);
  }

  .phil-title {
    font-size: 1.25rem;
    font-weight: 500;
    margin-bottom: 12px;
    line-height: 1.3;
  }

  .phil-desc {
    font-size: 0.9375rem;
    color: var(--ink-2);
    line-height: 1.7;
  }

  .principal-card {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: clamp(24px, 4vw, 48px);
    align-items: start;
  }

  .principal-photo-col {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .principal-photo {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border: 1px solid var(--hairline);
    border-radius: var(--r-md);
  }

  .photo-label {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .photo-label strong {
    font-size: 0.9375rem;
    color: var(--ink);
  }

  .photo-label span {
    font-size: 0.8125rem;
    color: var(--ink-3);
  }

  .principal-text-col {
    display: flex;
    flex-direction: column;
    gap: 16px;
    font-size: 1rem;
    line-height: 1.75;
    color: var(--ink-2);
  }

  .principal-quote {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    line-height: 1.4;
    color: var(--ink);
  }

  .motto {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .timeline-list {
    display: flex;
    flex-direction: column;
    border-left: 1px solid var(--hairline-2);
    margin-bottom: clamp(32px, 5vw, 48px);
  }

  .timeline-row {
    display: flex;
    gap: clamp(16px, 3vw, 32px);
    padding: 0 0 24px 24px;
    position: relative;
  }

  .timeline-row::before {
    content: '';
    position: absolute;
    left: -4px;
    top: 7px;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
  }

  .year-text {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--accent);
    flex-shrink: 0;
    width: 44px;
    padding-top: 2px;
  }

  .milestone-title {
    font-size: 1.0625rem;
    font-weight: 500;
    margin-bottom: 6px;
  }

  .milestone-desc {
    font-size: 0.9375rem;
    color: var(--ink-2);
    line-height: 1.65;
    max-width: 62ch;
  }

  .history-photos-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(16px, 3vw, 32px);
  }

  .photo-card {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .hist-img {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border: 1px solid var(--hairline);
    border-radius: var(--r-md);
  }

  .photo-caption {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .photo-caption strong {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--ink);
  }

  .photo-caption span {
    font-size: 0.8125rem;
    color: var(--ink-3);
  }

  .faculty-banner {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .faculty-img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border: 1px solid var(--hairline);
    border-radius: var(--r-md);
  }

  .faculty-meta {
    font-size: 0.9375rem;
    color: var(--ink-2);
    line-height: 1.7;
    max-width: 64ch;
  }

  .inline-link {
    color: var(--accent);
    border-bottom: 1px solid var(--hairline-2);
  }

  .inline-link:hover {
    border-color: var(--accent);
  }

  .legal-card {
    border: 1px solid var(--hairline);
    border-radius: var(--r-md);
    background: var(--surface);
    padding: clamp(22px, 3vw, 32px);
  }

  .legal-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 clamp(24px, 4vw, 48px);
  }

  .legal-item {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 12px 0;
    border-bottom: 1px solid var(--hairline);
    font-size: 0.875rem;
  }

  .legal-item dt {
    color: var(--ink-3);
  }

  .legal-item dd {
    color: var(--ink);
    text-align: right;
    font-weight: 500;
  }

  @media (max-width: 900px) {
    .philosophy-grid,
    .history-photos-grid,
    .legal-grid {
      grid-template-columns: 1fr;
    }
    .principal-card {
      grid-template-columns: 1fr;
    }
  }
</style>
