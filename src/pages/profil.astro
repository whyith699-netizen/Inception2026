---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Profil & Sambutan Kepala Sekolah | SMA Negeri 1 Klaten"
  description="Sejarah pendirian 5 November 1957, sambutan Kepala Sekolah Tantri Ambarsari, S.Pd., M.Eng., visi misi resmi, jajaran pengajar, dan legalitas NPSN 20309676 SMA Negeri 1 Klaten."
>
  <Header />

  <main class="page-container">
    <!-- Page Header -->
    <section class="page-header">
      <div class="container">
        <span class="page-tag">Identitas Institusi</span>
        <h1 class="page-title">Profil SMA Negeri 1 Klaten</h1>
        <p class="page-lead">
          Pusat rujukan pendidikan menengah atas di Jawa Tengah yang telah mendedikasikan 69 tahun (sejak 5 November 1957) untuk melahirkan pemimpin berkarakter luhur dan berdaya saing global.
        </p>
      </div>
    </section>

    <!-- Sambutan Kepala Sekolah -->
    <section class="principal-section">
      <div class="container">
        <div class="principal-card">
          <div class="principal-photo-col">
            <div class="photo-badge-wrap">
              <img 
                src="/images/school/salamkepsek.jpg" 
                alt="Tantri Ambarsari, S.Pd., M.Eng." 
                class="principal-photo" 
                width="340"
                height="420"
              />
              <div class="principal-caption">
                <strong>Tantri Ambarsari, S.Pd., M.Eng.</strong>
                <span>Kepala Sekolah SMA Negeri 1 Klaten</span>
              </div>
            </div>
          </div>

          <div class="principal-text-col">
            <span class="section-tag-sm">Kata Sambutan</span>
            <h2 class="principal-heading">Membangun Karakter Hebat & Unggul di Era Transformasi Digital</h2>
            <div class="principal-body">
              <p>
                <strong>Assalamu’alaikum Warahmatullahi Wabarakatuh, Salam Sejahtera, Om Swastiastu, Namo Buddhaya, Salam Kebajikan.</strong>
              </p>
              <p>
                Puji syukur kita panjatkan ke hadirat Tuhan Yang Maha Esa atas limpahan rahmat dan karunia-Nya. Di era kecerdasan artifisial dan percepatan teknologi saat ini, website resmi SMA Negeri 1 Klaten merupakan pintu gerbang informasi terdepan dan representasi kemajuan institusi kami.
              </p>
              <p>
                SMA Negeri 1 Klaten berkomitmen teguh mendidik putra-putri bangsa tidak hanya cerdas secara nalar sains dan teknologi, namun juga kokoh berakhlak mulia, beretika lingkungan, serta mencintai nilai-nilai luhur budaya nusantara. Semoga kehadiran platform terpadu ini menjadi sarana komunikasi, keterbukaan informasi, dan inspirasi bagi civitas akademika serta masyarakat luas.
              </p>
              <p class="motto-callout">
                <em>"SMA Negeri 1 Klaten: Berkarakter Hebat Jaya!"</em>
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Visi, Misi & Identitas Legal -->
    <section class="profile-content">
      <div class="container grid-two-col">
        <!-- Visi & Misi Resmi -->
        <div class="content-block">
          <h2 class="section-heading">Visi Resmi Sekolah</h2>
          <blockquote class="vision-quote">
            “Terwujudnya lulusan yang religius, cerdas, berkarakter, berbudi pekerti luhur, berdaya saing global dan beretika lingkungan.”
          </blockquote>

          <h2 class="section-heading" style="margin-top: 40px;">Misi SMAN 1 Klaten</h2>
          <ul class="mission-list">
            <li>
              <strong>Pendidikan Keimanan & Ketaqwaan:</strong> Mewujudkan insan yang beriman dan bertakwa menurut ajaran agamanya melalui proses pembelajaran yang efektif, inovatif, dan menyenangkan.
            </li>
            <li>
              <strong>Keunggulan Akademik & Riset:</strong> Menyelenggarakan proses pembelajaran berbasis nalar kritis, riset sains mendalam, dan penalaran komputasional menuju perguruan tinggi terbaik dunia.
            </li>
            <li>
              <strong>Karakter Berbudi Pekerti Luhur:</strong> Mengembangkan kultur sekolah beretika luhur, berdisiplin tinggi, santun, dan toleran berlandaskan Profil Pelajar Pancasila.
            </li>
            <li>
              <strong>Daya Saing Global & Kebahasaan:</strong> Memperkuat kompetensi komunikasi bahasa internasional, diplomasi pemuda, kepemimpinan, dan literasi digital.
            </li>
            <li>
              <strong>Etika & Kepedulian Lingkungan:</strong> Mewujudkan sekolah ramah anak dan adiwiyata dengan melestarikan keanekaragaman hayati, efisiensi energi, dan zero plastic waste.
            </li>
          </ul>
        </div>

        <!-- Identitas Legal Sekolah -->
        <div class="stat-card-box">
          <h3 class="box-title">Identitas Legal Sekolah</h3>
          <div class="id-table">
            <div class="id-row"><span class="id-label">Nama Sekolah</span><span class="id-val">SMA Negeri 1 Klaten</span></div>
            <div class="id-row"><span class="id-label">NPSN Resmi</span><span class="id-val">20309676</span></div>
            <div class="id-row"><span class="id-label">Tanggal Berdiri</span><span class="id-val">5 November 1957</span></div>
            <div class="id-row"><span class="id-label">Status Akreditasi</span><span class="id-val">A (Unggul) BAN-S/M</span></div>
            <div class="id-row"><span class="id-label">Kurikulum</span><span class="id-val">Kurikulum Merdeka</span></div>
            <div class="id-row"><span class="id-label">Kepala Sekolah</span><span class="id-val">Tantri Ambarsari, S.Pd., M.Eng.</span></div>
            <div class="id-row"><span class="id-label">Slogan Resmi</span><span class="id-val">Berkarakter Hebat Jaya</span></div>
            <div class="id-row"><span class="id-label">Alamat Kampus</span><span class="id-val">Jl. Merbabu No. 13 Klaten</span></div>
            <div class="id-row"><span class="id-label">Kecamatan/Kab.</span><span class="id-val">Klaten Selatan, Klaten, Jateng</span></div>
            <div class="id-row"><span class="id-label">Kode Pos</span><span class="id-val">57423</span></div>
            <div class="id-row"><span class="id-label">Telepon</span><span class="id-val">(0272) 321150</span></div>
            <div class="id-row"><span class="id-label">Surel Resmi</span><span class="id-val">info@sma1klaten.sch.id</span></div>
          </div>

          <div class="team-attribution">
            <span class="att-title">Tim Pengembang Desain (INCEPTION 2026):</span>
            <p class="att-desc">RANDOM KID: Muhammad Agha Prabswara, Radithya Asadel Narendra, Jalu Budi Dhamarsakti.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Arsip Sejarah & Tim Pendidik -->
    <section class="history-gallery-section">
      <div class="container">
        <div class="section-header-center">
          <span class="page-tag">Rekam Jejak Historis</span>
          <h2 class="section-title-lg">Perjalanan Sejak 5 November 1957</h2>
          <p class="section-lead-max">
            Menelusuri dedikasi panjang para perintis pendidikan hingga menjadi salah satu SMA rujukan terkemuka di tanah air.
          </p>
        </div>

        <div class="history-grid">
          <div class="history-card">
            <div class="history-img-wrap">
              <img src="/images/school/history-foto1.jpg" alt="Arsip Sejarah SMA Negeri 1 Klaten" class="history-img" loading="lazy" />
            </div>
            <div class="history-card-body">
              <span class="history-year">Arsip 1957</span>
              <h3>Awal Mula Pendirian Sekolah</h3>
              <p>Didirikan sebagai respons atas kebutuhan pendidikan menengah di karesidenan Surakarta, SMANSA Klaten mengawali kiprah mulianya dengan komitmen keilmuan luhur.</p>
            </div>
          </div>

          <div class="history-card">
            <div class="history-img-wrap">
              <img src="/images/school/history-foto2a.jpg" alt="Generasi Awal Pendidik SMANSA" class="history-img" loading="lazy" />
            </div>
            <div class="history-card-body">
              <span class="history-year">Dedikasi Pengajar</span>
              <h3>Fondasi Karakter dan Budi Pekerti</h3>
              <p>Para perintis guru menanamkan disiplin baja dan kecintaan membaca yang diwariskan dari generasi ke generasi hingga melahirkan puluhan ribu alumni sukses.</p>
            </div>
          </div>
        </div>

        <!-- Tim Guru & Staf -->
        <div class="faculty-showcase-box">
          <div class="faculty-img-wrap">
            <img src="/images/school/smansafullteam.jpeg" alt="Dewan Guru dan Karyawan SMA Negeri 1 Klaten" class="faculty-photo" loading="lazy" />
          </div>
          <div class="faculty-caption">
            <h3>Dewan Pendidik & Tenaga Kependidikan SMA Negeri 1 Klaten</h3>
            <p>Didukung oleh lebih dari 80 pengajar tersertifikasi berlatar belakang Magister (S2) dan Sarjana (S1) dari universitas terkemuka.</p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .page-container {
    padding-bottom: 80px;
  }
  .page-header {
    background-color: var(--color-surface-muted);
    border-bottom: 1px solid var(--color-border);
    padding: 60px 0;
    text-align: center;
  }
  .page-tag {
    font-size: 0.82rem;
    font-family: var(--font-mono);
    font-weight: 700;
    text-transform: uppercase;
    color: var(--color-accent-coral);
    letter-spacing: 0.08em;
  }
  .page-title {
    font-size: clamp(2.2rem, 4vw, 3.2rem);
    margin: 12px 0 16px;
  }
  .page-lead {
    font-size: 1.05rem;
    color: var(--color-text-secondary);
    max-width: 720px;
    margin: 0 auto;
    line-height: 1.6;
  }

  /* Principal Greeting Section */
  .principal-section {
    padding: 60px 0 40px;
  }
  .principal-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: 44px;
    display: grid;
    grid-template-columns: 320px 1fr;
    gap: 48px;
    align-items: center;
    box-shadow: 0 8px 30px rgba(34, 22, 16, 0.05);
  }
  .principal-photo-col {
    display: flex;
    justify-content: center;
  }
  .photo-badge-wrap {
    width: 100%;
    max-width: 300px;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background-color: #221610;
    border: 3px solid var(--color-border);
    box-shadow: 0 10px 24px rgba(34, 22, 16, 0.1);
  }
  .principal-photo {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }
  .principal-caption {
    background-color: var(--color-text-primary);
    color: #FFFFFF;
    padding: 14px;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .principal-caption strong {
    font-family: var(--font-serif);
    font-size: 0.95rem;
    color: var(--color-accent-yellow);
  }
  .principal-caption span {
    font-size: 0.76rem;
    color: rgba(255, 255, 255, 0.8);
  }

  .section-tag-sm {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--color-accent-coral);
    letter-spacing: 0.08em;
  }
  .principal-heading {
    font-family: var(--font-serif);
    font-size: 1.85rem;
    line-height: 1.25;
    margin: 8px 0 18px;
    color: var(--color-text-primary);
  }
  .principal-body {
    display: flex;
    flex-direction: column;
    gap: 14px;
    font-size: 0.96rem;
    line-height: 1.65;
    color: var(--color-text-secondary);
  }
  .motto-callout {
    background-color: #FAF4EB;
    border-left: 4px solid var(--color-accent-coral);
    padding: 12px 18px;
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    font-weight: 600;
    color: var(--color-accent-coral);
  }

  /* Profile Visi Misi Grid */
  .profile-content {
    padding: 40px 0 60px;
  }
  .grid-two-col {
    display: grid;
    grid-template-columns: 1.35fr 1fr;
    gap: 48px;
  }
  .section-heading {
    font-size: 1.75rem;
    margin-bottom: 16px;
  }
  .vision-quote {
    background-color: #FAF4EB;
    border-left: 4px solid var(--color-accent-coral);
    padding: 24px 28px;
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    font-family: var(--font-serif);
    font-size: 1.18rem;
    line-height: 1.6;
    color: var(--color-text-primary);
    font-weight: 600;
  }
  .mission-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding-left: 20px;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }
  .stat-card-box {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: 32px;
    box-shadow: 0 6px 20px rgba(34, 22, 16, 0.04);
  }
  .box-title {
    font-size: 1.3rem;
    margin-bottom: 20px;
    font-family: var(--font-serif);
  }
  .id-table {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 24px;
  }
  .id-row {
    display: flex;
    justify-content: space-between;
    padding-bottom: 6px;
    border-bottom: 1px solid var(--color-border);
    font-size: 0.88rem;
  }
  .id-label {
    color: var(--color-text-secondary);
  }
  .id-val {
    font-weight: 700;
    text-align: right;
  }
  .team-attribution {
    background-color: var(--color-surface-muted);
    padding: 16px;
    border-radius: var(--radius-md);
    border: 1px dashed var(--color-border);
  }
  .att-title {
    font-size: 0.78rem;
    font-family: var(--font-mono);
    font-weight: 700;
    display: block;
    margin-bottom: 4px;
    color: var(--color-accent-coral);
  }
  .att-desc {
    font-size: 0.82rem;
    color: var(--color-text-secondary);
  }

  /* History Gallery Section */
  .history-gallery-section {
    padding: 50px 0;
    background-color: var(--color-surface-muted);
    border-top: 1px solid var(--color-border);
  }
  .section-header-center {
    text-align: center;
    margin-bottom: 44px;
  }
  .section-title-lg {
    font-size: 2.2rem;
    margin: 10px 0 14px;
  }
  .section-lead-max {
    font-size: 1.05rem;
    color: var(--color-text-secondary);
    max-width: 680px;
    margin: 0 auto;
  }
  .history-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
    margin-bottom: 48px;
  }
  .history-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: 0 4px 16px rgba(34, 22, 16, 0.04);
  }
  .history-img-wrap {
    width: 100%;
    height: 220px;
    background-color: #1a1a1a;
  }
  .history-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .history-card-body {
    padding: 24px;
  }
  .history-year {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-accent-coral);
    text-transform: uppercase;
  }
  .history-card-body h3 {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    margin: 6px 0 10px;
  }
  .history-card-body p {
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--color-text-secondary);
  }

  .faculty-showcase-box {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: 0 8px 30px rgba(34, 22, 16, 0.06);
  }
  .faculty-img-wrap {
    width: 100%;
    max-height: 480px;
    overflow: hidden;
    background-color: #221610;
  }
  .faculty-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .faculty-caption {
    padding: 24px 32px;
    text-align: center;
  }
  .faculty-caption h3 {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    margin-bottom: 6px;
  }
  .faculty-caption p {
    font-size: 0.95rem;
    color: var(--color-text-secondary);
  }

  @media (max-width: 900px) {
    .principal-card {
      grid-template-columns: 1fr;
      padding: 28px;
      gap: 28px;
    }
    .grid-two-col {
      grid-template-columns: 1fr;
    }
    .history-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
