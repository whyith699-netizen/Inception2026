---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/react/Header';
import Footer from '../components/react/Footer';
import staffData from '../content/direktori/staff.json';
import DirektoriPage from '../components/react/pages/DirektoriPage';
---

<BaseLayout
  title="Direktori Guru dan Pimpinan SMAN 1 Klaten"
  description="Daftar pimpinan, wakil kepala sekolah, dewan guru, dan tenaga kependidikan SMA Negeri 1 Klaten."
>
  <Header client:load currentPath="/direktori" />
  <main id="main-content">
    <DirektoriPage client:load staffGroups={staffData} />
  </main>
  <Footer client:load />
</BaseLayout>
