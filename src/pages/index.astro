---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Metrics from '../components/Metrics.astro';
import Programs from '../components/Programs.astro';
import Curriculum from '../components/Curriculum.astro';
import ValueProp from '../components/ValueProp.astro';
import EventBanner from '../components/EventBanner.astro';
import ChatbotWidget from '../components/ChatbotWidget.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="SMA Negeri 1 Klaten (Padmawijaya) | Sekolah Rujukan Klaten"
  description="Website resmi SMA Negeri 1 Klaten (Padmawijaya / Kampus 13). Berdiri sejak 5 November 1957, terakreditasi A dengan nilai 98 BAN-SM, membina 23 ekstrakurikuler, direktori guru, berita sekolah, dan asisten digital SmansaBot AI."
>
  <Header />
  <main id="main-content">
    <Hero />
    <Metrics />
    <Programs />
    <Curriculum />
    <ValueProp />
    <EventBanner />
    <ChatbotWidget />
  </main>
  <Footer />
</BaseLayout>

<script>
  // Scroll reveal: IntersectionObserver, hanya transform & opacity
  document.addEventListener('astro:page-load', () => {
    const targets = document.querySelectorAll('[data-reveal]');
    if (!('IntersectionObserver' in window)) {
      targets.forEach((el) => el.classList.add('is-in'));
    } else {
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-in');
              io.unobserve(entry.target);
            }
          }
        },
        { rootMargin: '0px 0px -8% 0px', threshold: 0.05 }
      );
      targets.forEach((el, i) => {
        (el as HTMLElement).style.transitionDelay = `${Math.min(i, 6) * 60}ms`;
        io.observe(el);
      });
    }
  });
</script>
