---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Metrics from '../components/Metrics.astro';
import Programs from '../components/Programs.astro';
import Curriculum from '../components/Curriculum.astro';
import ValueProp from '../components/ValueProp.astro';
import EventBanner from '../components/EventBanner.astro';
import ChatbotWidget from '../components/ChatbotWidget.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="SMA Negeri 1 Klaten (Padmawijaya) | Sekolah Rujukan Klaten"
  description="Website resmi SMA Negeri 1 Klaten (Padmawijaya / Kampus 13). Berdiri sejak 5 November 1957, terakreditasi A dengan nilai 98 BAN-SM, membina 23 ekstrakurikuler, direktori guru, berita sekolah, dan asisten digital SmansaBot AI."
>
  <Header />
  <main id="main-content">
    <Hero />
    <Metrics />
    <Programs />
    <Curriculum />
    <ValueProp />
    <EventBanner />
    <ChatbotWidget />
  </main>
  <Footer />
</BaseLayout>
