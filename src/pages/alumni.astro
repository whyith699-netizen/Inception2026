---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getEntry } from 'astro:content';

const alumniData = await getEntry('alumni', 'tokoh');
const list = alumniData?.data?.items || [];

const regionalChapters = [
  { name: 'Pengda Jabodetabek', desc: 'Mencakup DKI Jakarta, Bogor, Depok, Tangerang, dan Bekasi.', badge: 'Jabodetabek' },
  { name: 'Pengda Solo Raya & DIY', desc: 'Pusat temu alumni wilayah Klaten, Surakarta, Sleman, dan Yogyakarta.', badge: 'Jateng-DIY' },
  { name: 'Pengda Jawa Timur', desc: 'Komunitas alumni di Surabaya, Malang, dan sekitarnya.', badge: 'Jatim' },
  { name: 'Pengda Jawa Barat', desc: 'Jejaring civitas perguruan tinggi dan korporasi Bandung & sekitarnya.', badge: 'Jabar' },
  { name: 'Komisariat Luar Jawa & Diaspora', desc: 'Alumni yang bertugas di luar pulau Jawa dan mancanegara.', badge: 'Diaspora' },
];

const programHighlights = [
  {
    title: 'Beasiswa Pendidikan Angkatan 1976',
    date: '18 September 2026',
    amount: 'Rp 18.000.000,-',
    desc: 'Bantuan dana pendidikan disalurkan langsung kepada 12 siswa aktif SMAN 1 Klaten yang berprestasi dan membutuhkan dukungan biaya sekolah.',
    tag: 'Beasiswa Aktif',
  },
  {
    title: 'Mentoring Karier & Masuk PTN',
    date: 'Setiap Semester Genap',
    amount: 'Sharing Rutin',
    desc: 'Sesi kuliah tamu dan bedah jurusan langsung bersama alumni yang berkuliah di UGM, ITB, UI, UNS, serta profesional industri.',
    tag: 'Edukasi',
  },
  {
    title: 'Bakti Almamater & Sarana Prasarana',
    date: 'Tahunan',
    amount: 'Penguatan Sarpras',
    desc: 'Dukungan fasilitas laboratorium komputer, digitalisasi arsip sekolah, serta penunjang riset astronomi dan olimpiade sains.',
    tag: 'Pengabdian',
  },
];
---

<BaseLayout
  title="Alumni (KAPASSKA) — SMAN 1 Klaten"
  description="Keluarga Alumni Padmawijaya SMAN 1 Klaten (KAPASSKA). Direktori tokoh alumni nasional, beasiswa pendidikan, dan jejaring lintas 69 angkatan."
>
  <Header />
  <main id="main-content">
  <!-- Hero Section -->
  <section class="alumni-hero">
    <div class="container">
      <div class="hero-card brutal-card">
        <div class="hero-top">
          <span class="lbl lbl-lime">KAPASSKA · SEJAK 1957</span>
          <span class="lbl lbl-cyan">69 ANGKATAN ALUMNI</span>
        </div>
        <h1 class="hero-title">
          Keluarga Alumni <em>Padmawijaya</em> SMA Negeri 1 Klaten
        </h1>
        <p class="hero-lede">
          Wadah persaudaraan dan sinergi puluhan ribu lulusan Kampus 13 Klaten yang berkarya di kancah nasional, memimpin perguruan tinggi, korps diplomatik, lembaga negara, perbankan, riset sains, hingga kewirausahaan global.
        </p>

        <div class="stats-row">
          <div class="stat-pill">
            <span class="stat-num">10.000+</span>
            <span class="stat-lbl">Alumni Tersebar</span>
          </div>
          <div class="stat-pill">
            <span class="stat-num">1957</span>
            <span class="stat-lbl">Tahun Angkatan Perdana</span>
          </div>
          <div class="stat-pill">
            <span class="stat-num">5 Wilayah</span>
            <span class="stat-lbl">Pengurus Daerah</span>
          </div>
          <div class="stat-pill stat-accent">
            <span class="stat-num">Rp 18 Juta</span>
            <span class="stat-lbl">Beasiswa Angkatan 1976 (2026)</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Tokoh Alumni Berprestasi -->
  <section class="sec" id="tokoh-alumni">
    <div class="container">
      <div class="section-heading">
        <span class="lbl lbl-magenta">REKAM JEJAK KARYA</span>
        <h2 class="title-heading">Tokoh Alumni di Tingkat Nasional</h2>
        <p class="desc-heading">
          Profil figur publik lulusan SMAN 1 Klaten yang mendedikasikan keilmuan dan kepemimpinan bagi kemajuan bangsa.
        </p>
      </div>

      <div class="alumni-grid">
        {list.map((alumnus) => (
          <article class="alumni-box card" data-reveal>
            <div class="alumni-photo-frame">
              <img
                src={alumnus.image}
                alt={`Potret ${alumnus.name}`}
                class="alumni-photo"
                loading="lazy"
                width="320"
                height="400"
              />
              <span class="photo-tag">ALUMNI #{alumnus.id}</span>
            </div>
            <div class="alumni-content">
              <h3 class="alumni-name">{alumnus.name}</h3>
              <p class="alumni-role">{alumnus.designation}</p>
              <div class="alumni-foot">
                <span class="alumni-badge">Padmawijaya Honor</span>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Inisiatif Beasiswa & Kontribusi Nyata -->
  <section class="sec bg-surface-2" id="program-alumni">
    <div class="container">
      <div class="section-heading">
        <span class="lbl lbl-yellow">AKSI NYATA ALMAMATER</span>
        <h2 class="title-heading">Program & Kepedulian Alumni</h2>
        <p class="desc-heading">
          Kontribusi berkelanjutan KAPASSKA untuk memastikan adik-adik kelas di Kampus 13 Klaten mendapatkan akses pendidikan berkualitas.
        </p>
      </div>

      <div class="program-grid">
        {programHighlights.map((prog) => (
          <div class="program-card card" data-reveal>
            <div class="program-header">
              <span class="lbl lbl-cyan">{prog.tag}</span>
              <span class="program-date num">{prog.date}</span>
            </div>
            <h3 class="program-title">{prog.title}</h3>
            <div class="program-amount num">{prog.amount}</div>
            <p class="program-desc">{prog.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Jejaring Pengurus Daerah & Pendaftaran Alumni -->
  <section class="sec" id="jejaring-kapasska">
    <div class="container">
      <div class="network-layout">
        <!-- Kolom Kiri: Pengurus Daerah -->
        <div class="network-left" data-reveal>
          <span class="lbl lbl-lime">KOMISARIAT WILAYAH</span>
          <h2 class="title-heading">Jejaring Pengurus Daerah KAPASSKA</h2>
          <p class="desc-heading" style="margin-bottom: 24px;">
            Terhubung dengan sesama alumni di kota domisili Anda untuk kolaborasi karier, wirausaha, dan silaturahmi.
          </p>

          <div class="chapters-list">
            {regionalChapters.map((ch) => (
              <div class="chapter-item card">
                <div class="chapter-badge num">{ch.badge}</div>
                <div class="chapter-info">
                  <h4 class="chapter-name">{ch.name}</h4>
                  <p class="chapter-desc">{ch.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Kolom Kanan: Form Pendaftaran Direktori Alumni -->
        <div class="network-right" data-reveal>
          <div class="form-card card">
            <div class="form-top">
              <span class="lbl lbl-yellow">DATABASE RESMI</span>
              <h3 class="form-title">Pembaruan Data Alumni</h3>
              <p class="form-desc">
                Bantu sekretariat KAPASSKA memetakan potensi alumni dengan memperbarui data kontak dan profesi Anda.
              </p>
            </div>

            <form class="alumni-form" onsubmit="event.preventDefault(); alert('Terima kasih! Data alumni Anda telah dicatat oleh sistem KAPASSKA.');">
              <div class="field-group">
                <label for="f-name" class="field-label">Nama Lengkap & Gelar</label>
                <input id="f-name" type="text" class="field-input" placeholder="contoh: Budi Santoso, S.T., M.T." required />
              </div>

              <div class="form-row">
                <div class="field-group">
                  <label for="f-year" class="field-label">Tahun Kelulusan</label>
                  <input id="f-year" type="number" min="1957" max="2026" class="field-input num" placeholder="contoh: 2015" required />
                </div>
                <div class="field-group">
                  <label for="f-phone" class="field-label">Nomor WhatsApp</label>
                  <input id="f-phone" type="tel" class="field-input num" placeholder="08xxxxxxxxxx" required />
                </div>
              </div>

              <div class="field-group">
                <label for="f-job" class="field-label">Profesi / Instansi / Tempat Kerja</label>
                <input id="f-job" type="text" class="field-input" placeholder="contoh: Dosen Teknik UGM / CEO PT ..." required />
              </div>

              <div class="field-group">
                <label for="f-city" class="field-label">Kota Domisili Saat Ini</label>
                <input id="f-city" type="text" class="field-input" placeholder="contoh: Jakarta Selatan" required />
              </div>

              <button type="submit" class="btn btn-primary submit-btn">
                Simpan Data Alumni &rarr;
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .alumni-hero {
    padding-top: 48px;
    padding-bottom: 32px;
  }

  .hero-card {
    background: var(--neo-surface);
    border: var(--neo-border-thick);
    box-shadow: var(--neo-shadow-lg);
    border-radius: var(--r-md);
    padding: clamp(32px, 5vw, 56px);
  }

  .hero-top {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 20px;
  }

  .lbl-lime {
    background: var(--neon-lime);
    color: var(--neo-ink);
  }

  .hero-title {
    font-size: clamp(2.2rem, 5vw, 3.8rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.035em;
    margin-bottom: 20px;
    max-width: 24ch;
  }

  .hero-title em {
    background: var(--neon-lime);
    color: var(--neo-ink);
    padding: 0 8px;
    border: 2px solid var(--neo-ink);
    box-shadow: 3px 3px 0px var(--neo-ink);
    font-style: normal;
    display: inline-block;
  }

  .hero-lede {
    font-size: 1.15rem;
    line-height: 1.7;
    color: var(--neo-ink-2);
    max-width: 68ch;
    margin-bottom: 36px;
  }

  .stats-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 16px;
    padding-top: 24px;
    border-top: var(--neo-border);
  }

  .stat-pill {
    background: var(--neo-bg);
    border: var(--neo-border);
    box-shadow: var(--neo-shadow-sm);
    padding: 16px 20px;
    border-radius: var(--r-sm);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .stat-pill.stat-accent {
    background: var(--neon-lime);
  }

  .stat-num {
    font-family: var(--font-mono);
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--neo-ink);
  }

  .stat-lbl {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--neo-ink-2);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .section-heading {
    max-width: 680px;
    margin-bottom: clamp(36px, 5vw, 56px);
  }

  .title-heading {
    font-size: clamp(1.8rem, 3.8vw, 2.75rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.03em;
    margin-bottom: 12px;
  }

  .desc-heading {
    font-size: 1.0625rem;
    color: var(--neo-ink-2);
    line-height: 1.65;
  }

  /* Grid Tokoh Alumni */
  .alumni-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 24px;
  }

  .alumni-box {
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .alumni-photo-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 3 / 4;
    background: var(--neo-surface-2);
    border-bottom: var(--neo-border);
    overflow: hidden;
  }

  .alumni-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    transition: transform 0.3s ease;
  }

  .alumni-box:hover .alumni-photo {
    transform: scale(1.03);
  }

  .photo-tag {
    position: absolute;
    top: 12px;
    right: 12px;
    background: var(--neon-yellow);
    color: var(--neo-ink);
    border: var(--neo-border-thin);
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 800;
    padding: 3px 8px;
    box-shadow: 2px 2px 0px var(--neo-ink);
  }

  .alumni-content {
    padding: 24px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    gap: 8px;
  }

  .alumni-name {
    font-size: 1.25rem;
    font-weight: 800;
    line-height: 1.3;
    color: var(--neo-ink);
  }

  .alumni-role {
    font-size: 0.95rem;
    color: var(--neo-ink-2);
    line-height: 1.5;
    flex-grow: 1;
  }

  .alumni-foot {
    margin-top: 12px;
    padding-top: 12px;
    border-top: 1.5px solid var(--neo-border-color);
  }

  .alumni-badge {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    background: var(--neon-cyan);
    color: var(--neo-ink);
    border: 1px solid var(--neo-ink);
    padding: 3px 8px;
    box-shadow: 2px 2px 0px var(--neo-ink);
    display: inline-block;
  }

  /* Program Highlights */
  .bg-surface-2 {
    background: var(--neo-surface-2);
  }

  .program-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 24px;
  }

  .program-card {
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .program-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .program-date {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--neo-ink-3);
  }

  .program-title {
    font-size: 1.35rem;
    font-weight: 800;
    line-height: 1.25;
  }

  .program-amount {
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--neo-ink);
    background: var(--neon-lime);
    border: var(--neo-border-thin);
    box-shadow: 3px 3px 0px var(--neo-ink);
    padding: 6px 14px;
    display: inline-block;
    align-self: flex-start;
  }

  .program-desc {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--neo-ink-2);
  }

  /* Network & Form Layout */
  .network-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: flex-start;
  }

  @media (max-width: 900px) {
    .network-layout {
      grid-template-columns: 1fr;
    }
  }

  .chapters-list {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .chapter-item {
    padding: 16px 20px;
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .chapter-badge {
    background: var(--neon-magenta);
    color: #FFFFFF;
    font-weight: 800;
    font-size: 0.75rem;
    text-transform: uppercase;
    border: var(--neo-border-thin);
    box-shadow: 2px 2px 0px var(--neo-ink);
    padding: 6px 10px;
    flex-shrink: 0;
  }

  .chapter-name {
    font-size: 1.05rem;
    font-weight: 800;
    margin-bottom: 2px;
  }

  .chapter-desc {
    font-size: 0.875rem;
    color: var(--neo-ink-2);
    line-height: 1.4;
  }

  .form-card {
    padding: clamp(24px, 4vw, 36px);
  }

  .form-top {
    margin-bottom: 24px;
  }

  .form-title {
    font-size: 1.65rem;
    font-weight: 800;
    margin-top: 8px;
    margin-bottom: 8px;
  }

  .form-desc {
    font-size: 0.925rem;
    color: var(--neo-ink-2);
    line-height: 1.5;
  }

  .alumni-form {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }

  @media (max-width: 500px) {
    .form-row {
      grid-template-columns: 1fr;
    }
  }

  .field-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .field-label {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--neo-ink);
  }

  .field-input {
    font-family: inherit;
    font-size: 0.95rem;
    padding: 12px 14px;
    background: var(--neo-bg);
    border: var(--neo-border);
    border-radius: var(--r-sm);
    color: var(--neo-ink);
    box-shadow: 2px 2px 0px var(--neo-ink);
    transition: background-color 0.15s ease, box-shadow 0.15s ease;
  }

  .field-input:focus {
    outline: none;
    background: #FFFFFF;
    box-shadow: 4px 4px 0px var(--neon-cyan);
  }

  .submit-btn {
    width: 100%;
    margin-top: 8px;
    padding: 14px;
  }
</style>
