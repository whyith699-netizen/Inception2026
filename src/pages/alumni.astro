---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/react/Header';
import Footer from '../components/react/Footer';
import { getEntry } from 'astro:content';
import AlumniPage from '../components/react/pages/AlumniPage';

const alumniData = await getEntry('alumni', 'tokoh');
const alumniList = alumniData?.data?.items || [];
---

<BaseLayout
  title="Alumni (KAPASSKA) — SMAN 1 Klaten"
  description="Keluarga Alumni Padmawijaya SMAN 1 Klaten (KAPASSKA). Direktori tokoh alumni nasional, beasiswa pendidikan, dan jejaring lintas 69 angkatan."
>
  <Header client:load currentPath="/alumni" />
  <main id="main-content">
    <AlumniPage client:load items={alumniList} />
  </main>
  <Footer client:load />
</BaseLayout>
