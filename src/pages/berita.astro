---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('berita')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const categories = ['Berita', 'Pengumuman', 'Prestasi', 'Kegiatan', 'Informasi'];

const fmt = (d: Date) =>
  new Intl.DateTimeFormat('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }).format(d);
---

<BaseLayout
  title="Berita dan Pengumuman SMAN 1 Klaten"
  description="Kabar terbaru SMA Negeri 1 Klaten: agenda sekolah, pengumuman resmi, prestasi siswa, dan kegiatan kesiswaan di Kampus 13."
>
  <Header />

  <main id="main-content">
    <section class="page-head">
      <div class="container">
        <p class="lbl">Berita dan informasi</p>
        <h1 class="page-title">Kabar dari Kampus 13</h1>
        <p class="lede">
          Agenda sekolah, pengumuman resmi, prestasi siswa, dan kegiatan kesiswaan
          SMA Negeri 1 Klaten.
        </p>
      </div>
    </section>

    <div class="container">
      <nav class="filter-bar" aria-label="Filter kategori">
        <a class="filter-link is-active" href="/berita">Semua</a>
        {categories.map((c) => (
          <a class="filter-link" href={`/berita?kategori=${encodeURIComponent(c)}`}>{c}</a>
        ))}
      </nav>
    </div>

    {posts.length > 0 && (
      <section class="featured-sec">
        <div class="container">
          <article class="featured-post" data-reveal>
            <a class="featured-thumb" href={`/berita/${posts[0].id}`} tabindex="-1" aria-hidden="true">
              <img
                src={posts[0].data.image}
                alt=""
                width="960"
                height="540"
                loading="eager"
              />
            </a>
            <div class="featured-body">
              <p class="post-meta">
                <span class="post-cat">{posts[0].data.category}</span>
                <time datetime={posts[0].data.date.toISOString()}>{fmt(posts[0].data.date)}</time>
              </p>
              <h2 class="post-title">
                <a href={`/berita/${posts[0].id}`}>{posts[0].data.title}</a>
              </h2>
              <p class="post-excerpt">{posts[0].data.excerpt}</p>
              <a class="btn-text" href={`/berita/${posts[0].id}`}>Baca lengkapnya</a>
            </div>
          </article>
        </div>
      </section>
    )}

    <section class="list-sec">
      <div class="container">
        {posts.length > 1 ? (
          <div class="post-grid">
            {posts.slice(1).map((p) => (
              <article class="post-card" data-reveal>
                <a class="post-card-link" href={`/berita/${p.id}`}>
                  <p class="post-meta">
                    <span class="post-cat">{p.data.category}</span>
                    <time datetime={p.data.date.toISOString()}>{fmt(p.data.date)}</time>
                  </p>
                  <h3 class="post-card-title">{p.data.title}</h3>
                  <p class="post-card-excerpt">{p.data.excerpt}</p>
                </a>
              </article>
            ))}
          </div>
        ) : (
          <p class="empty-note">Belum ada berita lain yang dipublikasikan.</p>
        )}
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .page-head {
    padding: clamp(40px, 6vw, 72px) 0 clamp(24px, 3vw, 36px);
    border-top: 0;
  }

  .page-title {
    margin-bottom: 18px;
  }

  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding: 18px 0;
    border-top: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
  }

  .filter-link {
    font-size: 0.875rem;
    color: var(--ink-2);
    padding: 5px 12px;
    border: 1px solid var(--hairline-2);
    border-radius: var(--r-sm);
    transition: color 0.18s ease, border-color 0.18s ease, background 0.18s ease;
  }

  .filter-link:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .filter-link.is-active {
    color: var(--on-accent);
    background: var(--accent);
    border-color: var(--accent);
  }

  .featured-sec {
    padding-top: clamp(32px, 5vw, 56px);
  }

  .featured-post {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: clamp(20px, 3vw, 40px);
    align-items: center;
    border: 1px solid var(--hairline);
    border-radius: var(--r-md);
    overflow: hidden;
    background: var(--surface);
  }

  .featured-thumb {
    display: block;
    height: 100%;
    overflow: hidden;
    background: var(--paper-2);
  }

  .featured-thumb img {
    width: 100%;
    height: 100%;
    min-height: 240px;
    object-fit: cover;
  }

  .featured-body {
    padding: clamp(20px, 3vw, 36px) clamp(20px, 3vw, 36px) clamp(20px, 3vw, 36px) 0;
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ink-3);
    margin-bottom: 12px;
  }

  .post-cat {
    color: var(--accent);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .post-title {
    font-size: clamp(1.4rem, 2.6vw, 2rem);
    font-weight: 500;
    margin-bottom: 12px;
    max-width: 26ch;
  }

  .post-title a:hover {
    color: var(--accent);
  }

  .post-excerpt {
    font-size: 1rem;
    color: var(--ink-2);
    line-height: 1.65;
    margin-bottom: 20px;
    max-width: 56ch;
  }

  .list-sec {
    padding: clamp(40px, 6vw, 72px) 0 clamp(56px, 8vw, 88px);
  }

  .post-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--hairline);
    border: 1px solid var(--hairline);
    border-radius: var(--r-md);
    overflow: hidden;
  }

  .post-card {
    background: var(--surface);
    transition: background 0.2s ease;
  }

  .post-card:hover {
    background: var(--paper-2);
  }

  .post-card-link {
    display: block;
    padding: 22px;
    height: 100%;
  }

  .post-card-title {
    font-size: 1.0625rem;
    font-weight: 500;
    line-height: 1.35;
    margin-bottom: 8px;
  }

  .post-card-link:hover .post-card-title {
    color: var(--accent);
  }

  .post-card-excerpt {
    font-size: 0.875rem;
    color: var(--ink-2);
    line-height: 1.6;
  }

  .empty-note {
    color: var(--ink-3);
    font-size: 0.9375rem;
  }

  @media (max-width: 900px) {
    .featured-post,
    .post-grid {
      grid-template-columns: 1fr;
    }
    .featured-body {
      padding: clamp(20px, 3vw, 28px);
    }
  }
</style>
