---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/react/Header';
import Footer from '../components/react/Footer';
import BeritaPage from '../components/react/pages/BeritaPage';
import { getCollection } from 'astro:content';

const posts = await getCollection('berita');
const articles = posts
  .map((p) => ({
    ...p.data,
    id: p.id || p.data.id,
    date: p.data.date instanceof Date ? p.data.date.toISOString() : p.data.date,
  }))
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());
---

<BaseLayout
  title="Kabar dan Pengumuman | SMA Negeri 1 Klaten"
  description="Kabar terbaru SMA Negeri 1 Klaten: agenda sekolah, pengumuman resmi dinas, catatan prestasi siswa, dan dinamika kegiatan kesiswaan di sekolah."
>
  <Header client:load currentPath="/berita" />
  <main id="main-content">
    <BeritaPage client:load newsList={articles} />
  </main>
  <Footer client:load />
</BaseLayout>
