{
  "name": "web-sekolah-smansa-inception2026",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "astro dev --port 4321",
    "build": "astro build && node -e \"const fs=require('fs'),p=require('path');if(fs.existsSync('dist/client')){for(const f of fs.readdirSync('dist/client')){const src=p.resolve('dist/client',f),dst=p.resolve('dist',f);if(!fs.existsSync(dst))try{fs.symlinkSync(src,dst)}catch(e){}}}\"",
    "preview": "astro preview",
    "check": "astro check",
    "lint:slop": "python3 scripts/anti-slop-linter.py"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.6",
    "@astrojs/react": "^7.0.0",
    "astro": "^7.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/vercel": "^11.0.11",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.3"
  }
}
